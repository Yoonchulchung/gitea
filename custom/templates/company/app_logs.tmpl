{{template "base/head" .}}
<div role="main" class="page-content repository company-app-page">
	{{template "repo/header" .}}
	<div class="ui container">
		<h2 class="tw-flex tw-items-center tw-gap-3">
			<a href="{{.AppLink}}">{{ctx.Locale.Tr "company.app.title"}}</a>
			<span class="text-grey">/</span> {{ctx.Locale.Tr "company.logs.title"}}
		</h2>

		<div class="ui segment">
			{{/* `ui form` so the input gets the instance's own field styling — a
			     bare <input> outside one is the browser's, which is a different
			     height from the button beside it. Full-size button for the same
			     reason: a small one does not line up with a standard field. */}}
			<form method="get" class="ui form tw-flex tw-gap-2 tw-items-end tw-flex-wrap">
				<div class="field tw-flex-1 tw-mb-0"><input type="search" name="q" value="{{.Query}}" placeholder="{{ctx.Locale.Tr "company.logs.search_placeholder"}}"></div>
				{{/* Regexp is opt-in: a pattern can backtrack catastrophically, and
				     the search timeout bounds that but does not remove it. */}}
				<label class="tw-flex tw-items-center tw-gap-1 tw-text-13 tw-pb-2">
					<input type="checkbox" name="regexp" value="1" {{if .UseRegexp}}checked{{end}}> {{ctx.Locale.Tr "company.logs.regexp"}}
				</label>
				{{/* Named views rather than a pattern box: the routine traffic
				     is the same shape in every Python web server, so the
				     platform can recognise it and nobody has to write the
				     regexp for it. See company/logclass.go. */}}
				<div class="field tw-mb-0">
					<select name="view" class="ui selection dropdown">
						<option value="">{{ctx.Locale.Tr "company.logs.view_all"}}</option>
						<option value="errors" {{if eq .LogView "errors"}}selected{{end}}>{{ctx.Locale.Tr "company.logs.view_errors"}}{{if .ErrorCount}} ({{.ErrorCount}}){{end}}</option>
						<option value="app" {{if eq .LogView "app"}}selected{{end}}>{{ctx.Locale.Tr "company.logs.view_app"}}</option>
						<option value="requests" {{if eq .LogView "requests"}}selected{{end}}>{{ctx.Locale.Tr "company.logs.view_requests"}}</option>
					</select>
				</div>
				<button class="ui primary button">{{ctx.Locale.Tr "company.logs.search"}}</button>
			</form>
			{{if .SearchError}}
				<div class="ui negative message tw-mt-2">{{ctx.Locale.Tr "company.logs.bad_regexp"}} {{.SearchError}}</div>
			{{end}}
			{{if .Truncated}}
				<div class="ui warning message tw-mt-2">{{ctx.Locale.Tr "company.logs.truncated"}}</div>
			{{end}}
		</div>

		<div class="ui segment">
			{{/* Text nodes, never innerHTML: an app prints whatever it wants, and
			     "<script>" in a log line must not run in the reader's session.
			     Go templates escape this by default — do not add safeHTML. */}}
			<pre class="company-log">{{range .Lines}}{{if .At}}<span class="company-log-time" title="{{DateUtils.AbsoluteShort .At}}">{{DateUtils.AbsoluteShort .At}}</span> {{end}}{{if gt .Repeats 1}}<span class="text-grey" title="{{ctx.Locale.Tr "company.logs.repeated" .Repeats}}">×{{.Repeats}}</span> {{end}}{{if .Build}}<span class="company-log-build">{{.Text}}</span>{{else}}{{.Text}}{{end}}
{{else}}{{ctx.Locale.Tr "company.logs.empty"}}{{end}}</pre>
			<p class="text-grey tw-text-12 tw-mt-2 tw-mb-0">
				{{ctx.Locale.Tr "company.logs.legend" (HTMLFormat `<span class="%s">%s</span>` "company-log-build" (ctx.Locale.Tr "company.logs.legend_colour"))}}
			</p>
		</div>
	</div>
</div>
{{template "base/footer" .}}

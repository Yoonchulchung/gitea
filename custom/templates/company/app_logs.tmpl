{{template "base/head" .}}
<div role="main" class="page-content repository company-app-page">
	{{template "repo/header" .}}
	<div class="ui container">
		<h2 class="tw-flex tw-items-center tw-gap-3">
			<a href="{{.AppLink}}">앱 관리</a>
			<span class="text-grey">/</span> 로그
		</h2>

		<div class="ui segment">
			<form method="get" class="tw-flex tw-gap-2 tw-items-center">
				<input class="tw-flex-1" type="search" name="q" value="{{.Query}}" placeholder="검색어 (예: 패키지 이름, 오류 메시지)">
				{{/* Regexp is opt-in: a pattern can backtrack catastrophically, and
				     the search timeout bounds that but does not remove it. */}}
				<label class="tw-flex tw-items-center tw-gap-1 tw-text-13">
					<input type="checkbox" name="regexp" value="1" {{if .UseRegexp}}checked{{end}}> 정규식
				</label>
				<button class="ui small primary button">검색</button>
			</form>
			{{if .SearchError}}
				<div class="ui negative message tw-mt-2">검색식이 올바르지 않습니다: {{.SearchError}}</div>
			{{end}}
			{{if .Truncated}}
				<div class="ui warning message tw-mt-2">결과가 너무 많아 일부만 표시했습니다. 검색어를 좁혀 주세요.</div>
			{{end}}
		</div>

		<div class="ui segment">
			{{/* Text nodes, never innerHTML: an app prints whatever it wants, and
			     "<script>" in a log line must not run in the reader's session.
			     Go templates escape this by default — do not add safeHTML. */}}
			<pre class="company-log">{{range .Lines}}{{if .At}}<span class="company-log-time" title="{{DateUtils.AbsoluteShort .At}}">{{DateUtils.AbsoluteShort .At}}</span> {{end}}{{if .Build}}<span class="company-log-build">{{.Text}}</span>{{else}}{{.Text}}{{end}}
{{else}}로그가 아직 없습니다. 앱이 한 번이라도 배포되면 여기에 쌓입니다.{{end}}</pre>
			<p class="text-grey tw-text-12 tw-mt-2 tw-mb-0">
				<span class="company-log-build">이 색</span> 은 배포할 때 나온 것이고, 나머지는 실행 중인 앱이 남긴 것입니다.
				실패한 배포의 기록도 그대로 남습니다.
			</p>
		</div>
	</div>
</div>
{{template "base/footer" .}}

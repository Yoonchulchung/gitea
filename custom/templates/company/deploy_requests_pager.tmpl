{{/* Like base/paginate, but the page query param is configurable (.ParamName) so two
	independent pagers — Requested and Deployed — can live on the same page without
	colliding on "?page=". .Page is a *context.Pagination, same as base/paginate expects. */}}
{{$page := .Page}}
{{$paramName := .ParamName}}
{{$paginationParams := $page.GetParams}}
{{with $page.Paginater}}
	{{if or (eq .TotalPages -1) (gt .TotalPages 1)}}
		{{$showFirstLast := gt .TotalPages 1}}
		<div class="center page buttons">
			<div class="ui borderless pagination menu">
				{{if $showFirstLast}}
				<a class="{{if .IsFirst}}disabled{{end}} item navigation" {{if not .IsFirst}}href="?{{$paramName}}=1{{if $paginationParams}}&{{$paginationParams}}{{end}}"{{end}}>
					{{svg "gitea-double-chevron-left" 16 "tw-mr-1"}}
					<span class="navigation_label">{{ctx.Locale.Tr "admin.first_page"}}</span>
				</a>
				{{end}}

				<a class="{{if not .HasPrevious}}disabled{{end}} item navigation" {{if .HasPrevious}}href="?{{$paramName}}={{.Previous}}{{if $paginationParams}}&{{$paginationParams}}{{end}}"{{end}}>
					{{svg "octicon-chevron-left" 16 "tw-mr-1"}}
					<span class="navigation_label">{{ctx.Locale.Tr "repo.issues.previous"}}</span>
				</a>
				{{$pages := .Pages}}
				{{$pagesLen := len $pages}}
				{{range $pages}}
					{{if eq .Num -1}}
						<a class="disabled item">...</a>
					{{else}}
						<a class="{{if and .IsCurrent (gt $pagesLen 1)}}active {{end}}item" {{if not .IsCurrent}}href="?{{$paramName}}={{.Num}}{{if $paginationParams}}&{{$paginationParams}}{{end}}"{{end}}>{{.Num}}</a>
					{{end}}
				{{end}}
				<a class="{{if not .HasNext}}disabled{{end}} item navigation" {{if .HasNext}}href="?{{$paramName}}={{.Next}}{{if $paginationParams}}&{{$paginationParams}}{{end}}"{{end}}>
					<span class="navigation_label">{{ctx.Locale.Tr "repo.issues.next"}}</span>
					{{svg "octicon-chevron-right" 16 "tw-ml-1"}}
				</a>

				{{if $showFirstLast}}
				<a class="{{if .IsLast}}disabled{{end}} item navigation" {{if not .IsLast}}href="?{{$paramName}}={{.TotalPages}}{{if $paginationParams}}&{{$paginationParams}}{{end}}"{{end}}>
					<span class="navigation_label">{{ctx.Locale.Tr "admin.last_page"}}</span>
					{{svg "gitea-double-chevron-right" 16 "tw-ml-1"}}
				</a>
				{{end}}
			</div>
		</div>
	{{end}}
{{end}}

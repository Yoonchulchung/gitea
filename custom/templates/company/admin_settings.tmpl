{{template "admin/layout_head" (dict "pageClass" "admin company-settings")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">{{ctx.Locale.Tr "company.adminsettings.title"}}</h4>
		<div class="ui attached segment">
			<form method="post" action="{{AppSubUrl}}/-/admin/company-settings" class="ui form">
				{{.CsrfTokenHtml}}

				<h5>{{ctx.Locale.Tr "company.adminsettings.contact_header"}}</h5>
				<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminsettings.contact_explain"}}</p>
				<div class="field">
					<label for="support_email">{{ctx.Locale.Tr "company.adminsettings.contact_label"}}</label>
					<input id="support_email" type="email" name="support_email" value="{{.SupportEmail}}"
					       placeholder="it-help@example.com">
				</div>

				<div class="field">
					<label for="help_url">{{ctx.Locale.Tr "company.adminsettings.help_label"}}</label>
					<input id="help_url" type="url" name="help_url" value="{{.HelpURL}}"
					       placeholder="https://wiki.example.com/deploy-guide">
					<p class="help">{{ctx.Locale.Tr "company.adminsettings.help_explain"}}</p>
				</div>

				<div class="ui divider"></div>

				<h5>{{ctx.Locale.Tr "company.adminsettings.ai_header"}}</h5>
				<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminsettings.ai_explain"}}</p>
				<div class="field">
					<div class="ui checkbox">
						<input id="anthropic_visible" type="checkbox" name="anthropic_visible" value="true" {{if .AnthropicVisible}}checked{{end}}>
						<label for="anthropic_visible">{{ctx.Locale.Tr "company.adminsettings.ai_anthropic"}}</label>
					</div>
				</div>
				{{/* Said plainly, because an administrator who cannot see the option
				     on their own settings page would otherwise read the toggle as
				     broken. */}}
				<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminsettings.ai_admin_note"}}</p>

				<button class="ui primary button tw-mt-3">{{ctx.Locale.Tr "company.adminsettings.save"}}</button>
			</form>
		</div>

		{{/* Read-only: these live in app.ini and take a restart, so a form here
		     would appear to do nothing. They are shown because a switch that is
		     off and invisible looks exactly like a feature that is broken. */}}
		<h4 class="ui top attached header tw-mt-4">{{ctx.Locale.Tr "company.adminsettings.switches_header"}}</h4>
		<div class="ui attached segment">
			<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminsettings.switches_explain"}}</p>
			<table class="ui very basic compact table tw-mb-0">
				<tbody>
					{{range .Switches}}
						<tr>
							<td class="tw-w-1/3"><code>{{.Key}}</code></td>
							<td class="tw-w-1/6">
								{{if .On}}<span class="text-green">{{ctx.Locale.Tr "company.adminsettings.switch_on"}}</span>
								{{else}}<span class="text-red">{{ctx.Locale.Tr "company.adminsettings.switch_off"}}</span>{{end}}
							</td>
							<td class="text-grey tw-text-12">{{.Detail}}</td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>
	</div>
{{template "admin/layout_footer" .}}

{{template "admin/layout_head" (dict "pageClass" "admin company-settings")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">{{ctx.Locale.Tr "company.adminsettings.title"}}</h4>
		<div class="ui attached segment">
			<form method="post" action="{{AppSubUrl}}/-/admin/company-settings" class="ui form">
				{{.CsrfTokenHtml}}

				<h5>{{ctx.Locale.Tr "company.adminsettings.contact_header"}}</h5>
				<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminsettings.contact_explain"}}</p>
				<div class="field">
					<label for="support_email">{{ctx.Locale.Tr "company.adminsettings.contact_label"}}</label>
					<input id="support_email" type="email" name="support_email" value="{{.SupportEmail}}"
					       placeholder="it-help@example.com">
				</div>

				<div class="field">
					<label for="help_url">{{ctx.Locale.Tr "company.adminsettings.help_label"}}</label>
					<input id="help_url" type="url" name="help_url" value="{{.HelpURL}}"
					       placeholder="https://wiki.example.com/deploy-guide">
					<p class="help">{{ctx.Locale.Tr "company.adminsettings.help_explain"}}</p>
				</div>

				<div class="ui divider"></div>

				{{/* Each switch carries its own explanation under its label; a switch
				     that depends on another sits under that one's label and fades with
				     it. Kept out of `.field`, whose disabled rules fight the toggle's
				     hidden input. */}}
				<h5>{{ctx.Locale.Tr "company.adminsettings.ai_header"}}</h5>
				<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminsettings.ai_explain"}}</p>
				<div class="company-setting">
					<div class="ui toggle checkbox">
						<input id="ai_users_enabled" type="checkbox" name="ai_users_enabled" value="true" {{if .AIUsersEnabled}}checked{{end}}
						       data-company-enables="#anthropic_visible">
						<label for="ai_users_enabled">{{ctx.Locale.Tr "company.adminsettings.ai_users"}}</label>
					</div>
					<div class="company-setting-help">{{ctx.Locale.Tr "company.adminsettings.ai_users_explain"}}</div>
				</div>
				{{/* The saved answer is kept while it is switched off — turning AI
				     back on restores what was chosen (company/adminsettings.go). */}}
				<div class="company-setting company-setting-sub">
					<div class="ui toggle checkbox">
						<input id="anthropic_visible" type="checkbox" name="anthropic_visible" value="true" {{if .AnthropicVisible}}checked{{end}} {{if not .AIUsersEnabled}}disabled{{end}}>
						<label for="anthropic_visible">{{ctx.Locale.Tr "company.adminsettings.ai_anthropic"}}</label>
					</div>
					<div class="company-setting-help">{{ctx.Locale.Tr "company.adminsettings.ai_admin_note"}}</div>
				</div>

				<div class="ui divider"></div>

				<h5 id="deploy-approval">{{ctx.Locale.Tr "company.adminsettings.approval_header"}}</h5>
				<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminsettings.approval_explain"}}</p>
				<div class="company-setting">
					<div class="ui toggle checkbox">
						<input id="approval_every_deploy" type="checkbox" name="approval_every_deploy" value="true" {{if .ApprovalEveryDeploy}}checked{{end}}
						       data-company-disables="#package_approval, #network_approval">
						<label for="approval_every_deploy">{{ctx.Locale.Tr "company.adminsettings.approval_every_deploy"}}</label>
					</div>
					<div class="company-setting-help">
						{{if .ApprovalWaivedBy}}{{ctx.Locale.Tr "company.adminsettings.approval_waived_by" .ApprovalWaivedBy.Name}}
						{{else}}{{ctx.Locale.Tr "company.adminsettings.approval_every_deploy_explain"}}{{end}}
					</div>
				</div>
				<div class="company-setting company-setting-sub">
					<div class="ui toggle checkbox">
						<input id="package_approval" type="checkbox" name="package_approval" value="true" {{if .PackageApproval}}checked{{end}} {{if .ApprovalEveryDeploy}}disabled{{end}}>
						<label for="package_approval">{{ctx.Locale.Tr "company.adminsettings.approval_packages"}}</label>
					</div>
				</div>
				<div class="company-setting company-setting-sub">
					<div class="ui toggle checkbox">
						<input id="network_approval" type="checkbox" name="network_approval" value="true" {{if .NetworkApproval}}checked{{end}} {{if .ApprovalEveryDeploy}}disabled{{end}}>
						<label for="network_approval">{{ctx.Locale.Tr "company.adminsettings.approval_network"}}</label>
					</div>
				</div>
				<p class="text-grey tw-text-12 tw-mt-2">{{ctx.Locale.Tr "company.adminsettings.approval_other_note"}}</p>

				<div class="ui divider"></div>

				<h5>{{ctx.Locale.Tr "company.adminsettings.project_header"}}</h5>
				<div class="company-setting">
					<div class="ui toggle checkbox">
						<input id="project_approval" type="checkbox" name="project_approval" value="true" {{if .ProjectApproval}}checked{{end}}>
						<label for="project_approval">{{ctx.Locale.Tr "company.adminsettings.project_approval"}}</label>
					</div>
					<div class="company-setting-help">{{ctx.Locale.Tr "company.adminsettings.project_approval_explain"}}</div>
				</div>

				<button class="ui primary button tw-mt-3">{{ctx.Locale.Tr "company.adminsettings.save"}}</button>
			</form>
		</div>

		{{/* Read-only: these live in app.ini and take a restart, so a form here
		     would appear to do nothing. They are shown because a switch that is
		     off and invisible looks exactly like a feature that is broken. */}}
		<h4 class="ui top attached header tw-mt-4">{{ctx.Locale.Tr "company.adminsettings.switches_header"}}</h4>
		<div class="ui attached segment">
			<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminsettings.switches_explain"}}</p>
			<table class="ui very basic compact table tw-mb-0">
				<tbody>
					{{range .Switches}}
						<tr>
							<td class="tw-w-1/3"><code>{{.Key}}</code></td>
							<td class="tw-w-1/6">
								{{if .On}}<span class="text-green">{{ctx.Locale.Tr "company.adminsettings.switch_on"}}</span>
								{{else}}<span class="text-red">{{ctx.Locale.Tr "company.adminsettings.switch_off"}}</span>{{end}}
							</td>
							<td class="text-grey tw-text-12">{{.Detail}}</td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>
	</div>
{{template "admin/layout_footer" .}}

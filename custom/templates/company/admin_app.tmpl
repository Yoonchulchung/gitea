{{template "admin/layout_head" (dict "pageClass" "admin company-app")}}
	<div class="admin-setting-content">

		<h4 class="ui top attached header">
			<a href="{{AppSubUrl}}/-/admin/company-deploys">{{ctx.Locale.Tr "company.admin.deploys_nav"}}</a>
			<span class="text-grey tw-mx-2">/</span>{{.App.Owner}}/{{.App.Repo}}
			<div class="ui right">
				{{template "company/admin_deploys_status" .App}}
			</div>
		</h4>

		<div class="ui attached segment">
			{{/* Controls first: an admin opening this page during an incident is
			     here to do something, not to read. */}}
			<div class="tw-flex tw-items-center tw-gap-2 tw-flex-wrap">
				<a class="ui tiny basic button" href="{{.AppURL}}" target="_blank" rel="noopener">{{svg "octicon-link-external" 14}} {{ctx.Locale.Tr "company.adminapp.open"}}</a>
				<a class="ui tiny basic button" href="{{.AdminAppLink}}/logs">{{svg "octicon-log" 14}} {{ctx.Locale.Tr "company.logs.title"}}</a>
				{{if .AppRepo}}<a class="ui tiny basic button" href="{{.AppRepo.Link}}">{{svg "octicon-repo" 14}} {{ctx.Locale.Tr "company.adminapp.repo"}}</a>{{end}}
				<a class="ui tiny basic button" href="{{.AdminAppLink}}/history">{{svg "octicon-history" 14}} {{ctx.Locale.Tr "company.history.title"}}</a>
				<div class="tw-flex-1"></div>
				{{if eq .App.Actual "running"}}
					<form method="post" action="{{.AdminAppLink}}/restart">{{.CsrfTokenHtml}}<button class="ui tiny button">{{ctx.Locale.Tr "company.app.restart"}}</button></form>
					<form method="post" action="{{.AdminAppLink}}/stop">{{.CsrfTokenHtml}}<button class="ui tiny button">{{ctx.Locale.Tr "company.app.stop"}}</button></form>
				{{else if eq .App.Actual "suspended"}}
					<form method="post" action="{{.AdminAppLink}}/resume">{{.CsrfTokenHtml}}<button class="ui tiny primary button">{{ctx.Locale.Tr "company.adminapp.resume"}}</button></form>
				{{else}}
					<form method="post" action="{{.AdminAppLink}}/start">{{.CsrfTokenHtml}}<button class="ui tiny primary button">{{ctx.Locale.Tr "company.app.start"}}</button></form>
				{{end}}
				{{if .App.SHA}}
					{{/* Retry the recorded commit. A build breaks for reasons that
					     have nothing to do with the code — a full queue, PyPI
					     unreachable — and without this the only way back was asking
					     the department to submit the whole request again. */}}
					<form method="post" action="{{.AdminAppLink}}/redeploy">
						{{.CsrfTokenHtml}}<button class="ui tiny basic button">{{ctx.Locale.Tr "company.app.redeploy"}}</button>
					</form>
				{{end}}
				{{if ne .App.Actual "suspended"}}
					{{/* Suspend is the platform-protection verb: unlike a department's
					     stop, the department cannot undo it. The reason is required
					     because "an administrator stopped this" with no explanation
					     leaves them nothing to act on. */}}
					<form method="post" action="{{.AdminAppLink}}/suspend" class="tw-flex tw-gap-1">
						{{.CsrfTokenHtml}}
						<input class="tw-w-48" type="text" name="reason" placeholder="{{ctx.Locale.Tr "company.adminapp.suspend_reason"}}" required>
						<button class="ui tiny red basic button">{{ctx.Locale.Tr "company.adminapp.suspend"}}</button>
					</form>
				{{end}}
				<form method="post" action="{{.AdminAppLink}}/remove" data-company-confirm="{{ctx.Locale.Tr "company.adminapp.remove_confirm"}}">
					{{.CsrfTokenHtml}}<button class="ui tiny red button">{{ctx.Locale.Tr "company.adminapp.remove"}}</button>
				</form>
			</div>
		</div>

		{{if or (not .Sandboxed) (not .LimitsEnforced)}}
			<div class="ui attached warning message">
				{{if not .Sandboxed}}
					<div><strong>{{ctx.Locale.Tr "company.adminapp.unsandboxed"}}</strong> {{.SandboxDetail}}</div>
				{{end}}
				{{if not .LimitsEnforced}}
					<div>{{.LimitsDetail}}</div>
				{{end}}
			</div>
		{{end}}

		{{/* Why it is broken, in the order an admin needs it: the classified
		     cause, then the raw detail, then where to read more. The
		     department sees only the first part, so it is shown here too —
		     their question will be about that sentence, not about the log. */}}
		{{if .App.Reason}}
			<div class="ui attached negative message">
				<div class="tw-flex tw-items-baseline tw-gap-2 tw-flex-wrap">
					<strong>{{with .Cause}}{{ctx.Locale.Tr .Summary}}{{end}}</strong>
					<code class="tw-text-12">{{.App.Reason}}</code>
					{{/* An admin correlates this against the log, so the absolute
					     time matters as much as the relative one. */}}
					{{with .Cause}}{{if .At}}
						<span class="text-grey tw-text-12">{{DateUtils.TimeSince .At}} · {{DateUtils.AbsoluteShort .At}}</span>
					{{end}}{{end}}
				</div>
				{{with .Cause}}
					{{/* What the operator should do comes first — it is their page.
					     What the department is being told comes second and is
					     labelled, because their question will be about that
					     sentence rather than about the log. */}}
					{{if .AdminHint}}<div class="tw-mt-1">{{ctx.Locale.Tr .AdminHint}}</div>{{end}}
					{{if or .Detail .DetailText}}
						<div class="tw-text-13 tw-mt-2 text-grey">{{ctx.Locale.Tr "company.adminapp.dept_sees"}}
							{{if .Detail}}<div class="company-app-cause-line">{{ctx.Locale.Tr .Detail .DetailArg}}</div>{{end}}
							{{range StringUtils.Split .DetailText "\n"}}<div class="company-app-cause-line">{{.}}</div>{{end}}
						</div>
					{{end}}
				{{end}}
				{{if .App.Message}}
					{{/* Admin-only by definition — this is the half that can carry
					     absolute paths and build output (company/usererror.go). */}}
					<details class="tw-mt-2">
						<summary class="tw-cursor-pointer tw-text-13">{{ctx.Locale.Tr "company.adminapp.raw_detail"}}</summary>
						<pre class="company-log tw-mt-1">{{.App.Message}}</pre>
					</details>
				{{end}}
				<a class="ui tiny basic button tw-mt-2" href="{{.AdminAppLink}}/logs">{{svg "octicon-log" 14}} {{ctx.Locale.Tr "company.adminapp.full_logs"}}</a>
			</div>
		{{end}}

		<div class="ui attached segment">
			<div class="company-kpis">
				<div class="company-kpi"><b>{{.Summary.Requests}}</b><span>{{ctx.Locale.Tr "company.adminapp.kpi_requests"}}</span></div>
				<div class="company-kpi"><b>{{.Summary.Users}}</b><span>{{if eq .Settings.Access "public"}}{{ctx.Locale.Tr "company.adminapp.kpi_users_ip"}}{{else}}{{ctx.Locale.Tr "company.adminapp.kpi_users"}}{{end}}</span></div>
				<div class="company-kpi"><b>{{printf "%.1f" .Summary.ErrorRate}}%</b><span>{{ctx.Locale.Tr "company.adminapp.kpi_error_rate"}}</span></div>
				<div class="company-kpi"><b>{{.Summary.P95}}ms</b><span>{{ctx.Locale.Tr "company.adminapp.kpi_p95"}}</span></div>
				{{/* A blank is not a zero. This host may be unable to read an
				     app's usage at all, and "0MB" would be read as evidence when
				     sizing a limit. */}}
				<div class="company-kpi">
					{{if .Summary.ResourcesMeasured}}
						<b>{{.Summary.MemMaxMB}}<small>/{{.MemoryLimitMB}}MB</small></b>
					{{else}}
						<b class="text-grey">—<small>/{{.MemoryLimitMB}}MB</small></b>
					{{end}}
					<span>{{ctx.Locale.Tr "company.adminapp.kpi_memory"}}</span>
				</div>
				{{if .Summary.Blocked}}<div class="company-kpi bad"><b>{{.Summary.Blocked}}</b><span>{{ctx.Locale.Tr "company.adminapp.kpi_blocked"}}</span></div>{{end}}
			</div>
			<div class="tw-mt-2">
				{{range $r := (StringUtils.Split "1h,24h,7d,30d" ",")}}
					<a class="ui tiny {{if eq $.Window $r}}primary{{else}}basic{{end}} button" href="?range={{$r}}">{{$r}}</a>
				{{end}}
			</div>
			{{/* Distinct visitors cannot be summed across five-minute windows
			     without counting someone twice, so this is the busiest single
			     window, not a total. Saying so here is cheaper than an admin
			     drawing the wrong conclusion from it. */}}
			<div class="text-grey tw-text-12 tw-mt-2">{{ctx.Locale.Tr "company.adminapp.metrics_note"}}</div>
			{{if not .ResourceSamplingAvailable}}
				{{/* Said once, next to the numbers it explains: the memory chart
				     below is flat at zero for the same reason, and a flat line is
				     otherwise indistinguishable from an idle app. */}}
				<div class="ui warning message tw-mt-2">
					<div class="header">{{ctx.Locale.Tr "company.adminapp.unmeasured_header"}}</div>
					<div class="tw-text-13 tw-mt-1">
						{{.ResourceSamplingWhy}} {{ctx.Locale.Tr "company.adminapp.unmeasured_note"}}
					</div>
				</div>
			{{end}}
		</div>

		<div class="ui attached segment company-charts"
			data-points="{{.ChartPoints}}"
			data-annotations="{{.ChartAnnotations}}"
			data-memory-limit="{{.MemoryLimitMB}}"
			data-i18n-empty="{{ctx.Locale.Tr "company.chart.empty"}}"
			data-i18n-requests="{{ctx.Locale.Tr "company.chart.requests"}}"
			data-i18n-errors="{{ctx.Locale.Tr "company.chart.errors"}}"
			data-i18n-memory="{{ctx.Locale.Tr "company.chart.memory"}}"
			data-i18n-cpu="{{ctx.Locale.Tr "company.chart.cpu"}}"
			data-i18n-p95="{{ctx.Locale.Tr "company.chart.p95"}}">
			<div class="company-chart"><h5>{{ctx.Locale.Tr "company.adminapp.chart_requests"}}</h5><div class="company-chart-canvas"><canvas data-chart="requests"></canvas></div></div>
			<div class="company-chart"><h5>{{ctx.Locale.Tr "company.adminapp.chart_resources"}}</h5><div class="company-chart-canvas"><canvas data-chart="resources"></canvas></div></div>
			<div class="company-chart"><h5>{{ctx.Locale.Tr "company.adminapp.chart_latency"}}</h5><div class="company-chart-canvas"><canvas data-chart="latency"></canvas></div></div>
		</div>

		<h4 class="ui top attached header tw-mt-4">{{ctx.Locale.Tr "company.adminapp.env_header"}}</h4>
		<div class="ui attached segment">
			{{if .EnvError}}
				<div class="ui negative message tw-m-0">{{.EnvError}}</div>
			{{else if .EnvNames}}
				{{if .EnvRestartRequired}}
					<div class="ui warning message tw-mt-0">{{ctx.Locale.Tr "company.adminapp.env_stale"}}</div>
				{{end}}
				{{/* Names only, never values — see company/envstore.go. */}}
				<div>{{range .EnvNames}}<span class="ui label tw-mr-1">{{.}}</span>{{end}}</div>
				<div class="text-grey tw-text-12 tw-mt-2">{{ctx.Locale.Tr "company.adminapp.env_note"}}</div>
			{{else}}
				<span class="text-grey">{{ctx.Locale.Tr "company.adminapp.env_empty"}}</span>
			{{end}}
		</div>

		{{/* Split by where the permission came from. The platform's stack is the
		     same for every app and is not this app's decision; the approved list
		     is what an admin granted to this one, and is the only part worth
		     reviewing here. */}}
		{{/* The other side of the approval flow. A department asks to widen
		     inbound and can only ask for outbound; this is an admin closing
		     something that should not have been open, or opening it without
		     waiting for a request to be written. Removal matters more than
		     addition — an approval flow that can only add is a ratchet, and "we
		     approved that by mistake" has to have an answer. */}}
		<h4 class="ui top attached header tw-mt-4">{{ctx.Locale.Tr "company.adminapp.policy_header"}}</h4>
		<div class="ui attached segment">
			<form method="post" action="{{.AdminAppLink}}/network" class="ui form">
				{{.CsrfTokenHtml}}
				<input type="hidden" name="what" value="access">
				<div class="tw-mb-1"><strong>{{ctx.Locale.Tr "company.adminapp.inbound"}}</strong></div>
				{{/* The same Fomantic dropdown the AI settings page uses, rather
				     than a bare <select>: .ui.dropdown:not(.custom) is initialized
				     globally, so this needs no script of its own and matches every
				     other control in the instance. */}}
				<div class="tw-flex tw-items-center tw-gap-2 tw-flex-wrap">
					<div class="ui selection dropdown tw-flex-1">
						<input type="hidden" name="access" value="{{.Settings.Access}}">
						<div class="text"></div> {{svg "octicon-triangle-down" 14 "dropdown icon"}}
						<div class="menu">
							{{range .AccessOptions}}
								<div class="item" data-value="{{.Value}}">{{ctx.Locale.Tr .Label}} — {{ctx.Locale.Tr .Explain}}</div>
							{{end}}
						</div>
					</div>
					<button class="ui button">{{ctx.Locale.Tr "company.adminapp.apply"}}</button>
				</div>
				<div class="text-grey tw-text-12 tw-mt-1">
					{{ctx.Locale.Tr "company.adminapp.inbound_note"}}
				</div>
			</form>

			<div class="tw-mt-4"><strong>{{ctx.Locale.Tr "company.adminapp.outbound"}}</strong></div>
			{{if not .NetworkEnforced}}
				{{/* The control is written down and not applied. Said here rather
				     than only in the sandbox banner, because this is the panel an
				     operator reads when deciding whether an app may handle real
				     data — and "차단됨" beside a host list is read as a guarantee. */}}
				<div class="ui negative message tw-mt-1">
					<div class="header">{{ctx.Locale.Tr "company.adminapp.unenforced_header"}}</div>
					<div class="tw-text-13 tw-mt-1">
						{{ctx.Locale.Tr "company.adminapp.unenforced_note"}}
					</div>
					<div class="text-grey tw-text-12 tw-mt-1">{{.NetworkUnenforcedWhy}}</div>
				</div>
			{{end}}
			<div class="text-grey tw-text-12 tw-mt-1">
				{{if eq .NetworkMode "open"}}
					<span class="company-app-state failed">{{ctx.Locale.Tr "company.adminapp.outbound_open"}}</span>
					{{ctx.Locale.Tr "company.adminapp.outbound_open_note"}}
				{{else if eq .NetworkMode "broker"}}
					{{ctx.Locale.Tr "company.adminapp.outbound_broker_note"}}
				{{else}}
					{{ctx.Locale.Tr "company.adminapp.outbound_none_note"}}
				{{end}}
			</div>
			{{if .OutboundRules}}
				<table class="ui very basic table tw-text-13">
					<tbody>
						{{range .OutboundRules}}
							<tr>
								<td class="tw-font-mono">{{.Host}}</td>
								<td class="tw-w-32">{{if .Methods}}{{StringUtils.Join .Methods ", "}}{{else}}GET{{end}}</td>
								<td class="tw-w-24">
									<form method="post" action="{{$.AdminAppLink}}/network"
										data-company-confirm="{{ctx.Locale.Tr "company.adminapp.block_confirm" .Host}}">
										{{$.CsrfTokenHtml}}
										<input type="hidden" name="what" value="outbound-remove">
										<input type="hidden" name="host" value="{{.Host}}">
										<button class="ui tiny basic red button">{{ctx.Locale.Tr "company.adminapp.block"}}</button>
									</form>
								</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			{{end}}
			<form method="post" action="{{.AdminAppLink}}/network" class="ui form tw-mt-2">
				{{.CsrfTokenHtml}}
				<input type="hidden" name="what" value="outbound-add">
				<div class="tw-flex tw-items-center tw-gap-2 tw-flex-wrap">
					<input type="text" name="host" class="tw-flex-1" autocomplete="off"
						placeholder="{{ctx.Locale.Tr "company.adminapp.host_placeholder"}}">
					<div class="ui selection dropdown">
						<input type="hidden" name="methods" value="GET">
						<div class="text"></div> {{svg "octicon-triangle-down" 14 "dropdown icon"}}
						<div class="menu">
							<div class="item" data-value="GET">{{ctx.Locale.Tr "company.adminapp.method_get"}}</div>
							<div class="item" data-value="GET,POST">{{ctx.Locale.Tr "company.adminapp.method_getpost"}}</div>
						</div>
					</div>
					<button class="ui button">{{ctx.Locale.Tr "company.adminapp.allow"}}</button>
				</div>
			</form>

			<div class="tw-mt-4"><strong>{{ctx.Locale.Tr "company.adminapp.download"}}</strong></div>
			<form method="post" action="{{.AdminAppLink}}/network" class="tw-flex tw-items-center tw-gap-2 tw-mt-1 tw-flex-wrap">
				{{.CsrfTokenHtml}}
				<input type="hidden" name="what" value="download">
				{{if .DownloadAllowed}}
					<span class="company-app-state running">{{ctx.Locale.Tr "company.perm.allowed"}}</span>
					<button class="ui tiny basic red button">{{ctx.Locale.Tr "company.adminapp.download_block"}}</button>
				{{else}}
					<span class="company-app-state failed">{{ctx.Locale.Tr "company.perm.blocked"}}</span>
					<input type="hidden" name="allow" value="1">
					<button class="ui tiny basic button">{{ctx.Locale.Tr "company.adminapp.download_allow"}}</button>
				{{end}}
				<span class="text-grey tw-text-12">
					{{ctx.Locale.Tr "company.adminapp.download_note"}}
				</span>
			</form>
		</div>

		<h4 class="ui top attached header tw-mt-4">{{ctx.Locale.Tr "company.adminapp.packages_header"}}</h4>
		<div class="ui attached segment">
			<div class="tw-mb-2">
				<span class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminapp.pkg_base"}}</span>
				<div class="tw-mt-1">
					{{range .BasePackages}}<span class="ui basic label tw-mr-1">{{.}}</span>{{else}}<span class="text-grey">{{ctx.Locale.Tr "company.adminapp.pkg_none"}}</span>{{end}}
				</div>
			</div>
			{{if .SharedAllow}}
				<div class="tw-mb-2">
					<span class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminapp.pkg_shared"}}</span>
					<div class="tw-mt-1">{{range .SharedAllow}}<span class="ui basic label tw-mr-1">{{.}}</span>{{end}}</div>
				</div>
			{{end}}
			<div>
				<span class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminapp.pkg_approved"}}</span>
				<div class="tw-mt-1">
					{{range .ApprovedExtra}}<span class="ui green basic label tw-mr-1">{{.}}</span>{{else}}<span class="text-grey">{{ctx.Locale.Tr "company.adminapp.pkg_approved_empty"}}</span>{{end}}
				</div>
			</div>
			{{/* Policy is what the app may install; this is what the release that
			     is running actually has. They are the same only until someone
			     approves a package and nobody redeploys, and the panel above was
			     being read as though it were this. */}}
			<div class="tw-mt-3">
				<span class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminapp.pkg_installed"}}</span>
				<div class="tw-mt-1">
					{{range .InstalledPackages}}<span class="ui basic label tw-mr-1 tw-mb-1">{{.}}</span>{{else}}
						<span class="text-grey">{{ctx.Locale.Tr "company.adminapp.pkg_installed_unknown"}}</span>
					{{end}}
				</div>
			</div>
			{{/* The case this exists for: a dependency the build resolved that
			     appears in no file anyone wrote, so the department has nothing
			     to tick and cannot raise a request for it at all. The button
			     sits with the names because by the time this panel is on screen
			     the decision is already made — what is missing is one click. */}}
			<form method="post" action="{{.AdminAppLink}}/approve-packages" class="ui form tw-mt-4">
				{{.CsrfTokenHtml}}
				{{if .MissingPackages}}
					<div class="ui warning message tw-mt-0">
						<div class="header">{{ctx.Locale.Tr "company.adminapp.blocked_header"}}</div>
						<div class="tw-text-13 tw-mt-1">
							{{ctx.Locale.Tr "company.adminapp.blocked_note"}}
						</div>
						<div class="tw-flex tw-items-center tw-gap-3 tw-flex-wrap tw-mt-3">
							{{range .MissingPackages}}
								<label class="tw-inline-flex tw-items-center tw-gap-1">
									<input type="checkbox" name="package" value="{{.}}" checked>
									<span class="tw-font-mono">{{.}}</span>
								</label>
							{{end}}
							<button class="ui primary button tw-ml-2">{{ctx.Locale.Tr "company.adminapp.approve"}}</button>
						</div>
					</div>
				{{end}}
				{{/* Secondary: for an admin who already knows what is needed and
				     does not want to wait for a build to discover it. */}}
				<details class="tw-mt-2">
					<summary class="text-grey tw-text-13 tw-cursor-pointer">{{ctx.Locale.Tr "company.adminapp.approve_manual"}}</summary>
					<div class="tw-flex tw-items-center tw-gap-2 tw-flex-wrap tw-mt-2">
						<input type="text" name="extra" placeholder="{{ctx.Locale.Tr "company.adminapp.approve_placeholder"}}" class="tw-flex-1">
						<button class="ui button">{{ctx.Locale.Tr "company.adminapp.approve"}}</button>
					</div>
				</details>
				<div class="text-grey tw-text-12 tw-mt-3">
					{{ctx.Locale.Tr "company.adminapp.approve_note"}}
					<a href="{{AppSubUrl}}/-/admin/company-packages">{{ctx.Locale.Tr "company.adminapp.packages_link"}}</a>
				</div>
			</form>
		</div>

		<h4 class="ui top attached header">{{ctx.Locale.Tr "company.adminapp.recent_history"}}</h4>
		<div class="ui attached table segment">
			{{/* Headers and plain words, as on the department screen — a column of
			     bare "activating / rolled_back" says nothing on its own. The raw
			     code stays beside it: this is the admin view, and the code is
			     what matches the logs and the source. */}}
			{{template "company/history_table" dict "Rows" .HistoryRows "Raw" true}}
		</div>
	</div>
{{template "admin/layout_footer" .}}

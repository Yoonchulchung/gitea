{{template "admin/layout_head" (dict "pageClass" "admin company-app")}}
	<div class="admin-setting-content">

		<h4 class="ui top attached header">
			<a href="{{AppSubUrl}}/-/admin/company-deploys">앱 배포 관리</a>
			<span class="text-grey tw-mx-2">/</span>{{.App.Owner}}/{{.App.Repo}}
			<div class="ui right">
				{{template "company/admin_deploys_status" .App}}
			</div>
		</h4>

		<div class="ui attached segment">
			{{/* Controls first: an admin opening this page during an incident is
			     here to do something, not to read. */}}
			<div class="tw-flex tw-items-center tw-gap-2 tw-flex-wrap">
				<a class="ui tiny basic button" href="{{.AppURL}}" target="_blank" rel="noopener">{{svg "octicon-link-external" 14}} 앱 열기</a>
				<a class="ui tiny basic button" href="{{.AdminAppLink}}/logs">{{svg "octicon-log" 14}} 로그</a>
				{{if .AppRepo}}<a class="ui tiny basic button" href="{{.AppRepo.Link}}">{{svg "octicon-repo" 14}} 저장소</a>{{end}}
				<a class="ui tiny basic button" href="{{.AdminAppLink}}/history">{{svg "octicon-history" 14}} 배포 이력</a>
				<div class="tw-flex-1"></div>
				{{if eq .App.Actual "running"}}
					<form method="post" action="{{.AdminAppLink}}/restart">{{.CsrfTokenHtml}}<button class="ui tiny button">재시작</button></form>
					<form method="post" action="{{.AdminAppLink}}/stop">{{.CsrfTokenHtml}}<button class="ui tiny button">중지</button></form>
				{{else if eq .App.Actual "suspended"}}
					<form method="post" action="{{.AdminAppLink}}/resume">{{.CsrfTokenHtml}}<button class="ui tiny primary button">정지 해제</button></form>
				{{else}}
					<form method="post" action="{{.AdminAppLink}}/start">{{.CsrfTokenHtml}}<button class="ui tiny primary button">시작</button></form>
				{{end}}
				{{if .App.SHA}}
					{{/* Retry the recorded commit. A build breaks for reasons that
					     have nothing to do with the code — a full queue, PyPI
					     unreachable — and without this the only way back was asking
					     the department to submit the whole request again. */}}
					<form method="post" action="{{.AdminAppLink}}/redeploy">
						{{.CsrfTokenHtml}}<button class="ui tiny basic button">다시 배포</button>
					</form>
				{{end}}
				{{if ne .App.Actual "suspended"}}
					{{/* Suspend is the platform-protection verb: unlike a department's
					     stop, the department cannot undo it. The reason is required
					     because "an administrator stopped this" with no explanation
					     leaves them nothing to act on. */}}
					<form method="post" action="{{.AdminAppLink}}/suspend" class="tw-flex tw-gap-1">
						{{.CsrfTokenHtml}}
						<input class="tw-w-48" type="text" name="reason" placeholder="정지 사유" required>
						<button class="ui tiny red basic button">강제 정지</button>
					</form>
				{{end}}
				<form method="post" action="{{.AdminAppLink}}/remove" data-company-confirm="이 앱을 플랫폼에서 완전히 제거합니다. 코드는 배포 저장소에 남지만 실행 중인 앱과 환경변수는 삭제됩니다. 계속할까요?">
					{{.CsrfTokenHtml}}<button class="ui tiny red button">제거</button>
				</form>
			</div>
		</div>

		{{if or (not .Sandboxed) (not .LimitsEnforced)}}
			<div class="ui attached warning message">
				{{if not .Sandboxed}}
					<div><strong>이 앱은 격리 없이 실행됩니다.</strong> {{.SandboxDetail}}</div>
				{{end}}
				{{if not .LimitsEnforced}}
					<div>{{.LimitsDetail}}</div>
				{{end}}
			</div>
		{{end}}

		{{/* Why it is broken, in the order an admin needs it: the classified
		     cause, then the raw detail, then where to read more. The
		     department sees only the first part, so it is shown here too —
		     their question will be about that sentence, not about the log. */}}
		{{if .App.Reason}}
			<div class="ui attached negative message">
				<div class="tw-flex tw-items-baseline tw-gap-2 tw-flex-wrap">
					<strong>{{with .Cause}}{{.Summary}}{{end}}</strong>
					<code class="tw-text-12">{{.App.Reason}}</code>
					{{/* An admin correlates this against the log, so the absolute
					     time matters as much as the relative one. */}}
					{{with .Cause}}{{if .At}}
						<span class="text-grey tw-text-12">{{DateUtils.TimeSince .At}} · {{DateUtils.AbsoluteShort .At}}</span>
					{{end}}{{end}}
				</div>
				{{with .Cause}}
					{{/* What the operator should do comes first — it is their page.
					     What the department is being told comes second and is
					     labelled, because their question will be about that
					     sentence rather than about the log. */}}
					{{if .AdminHint}}<div class="tw-mt-1">{{.AdminHint}}</div>{{end}}
					{{if .Detail}}
						<div class="tw-text-13 tw-mt-2 text-grey">부서에 보이는 안내:
							{{range StringUtils.Split .Detail "\n"}}<div class="company-app-cause-line">{{.}}</div>{{end}}
						</div>
					{{end}}
				{{end}}
				{{if .App.Message}}
					{{/* Admin-only by definition — this is the half that can carry
					     absolute paths and build output (company/usererror.go). */}}
					<details class="tw-mt-2">
						<summary class="tw-cursor-pointer tw-text-13">원문 (관리자만)</summary>
						<pre class="company-log tw-mt-1">{{.App.Message}}</pre>
					</details>
				{{end}}
				<a class="ui tiny basic button tw-mt-2" href="{{.AdminAppLink}}/logs">{{svg "octicon-log" 14}} 로그 전체 보기</a>
			</div>
		{{end}}

		<div class="ui attached segment">
			<div class="company-kpis">
				<div class="company-kpi"><b>{{.Summary.Requests}}</b><span>요청</span></div>
				<div class="company-kpi"><b>{{.Summary.Users}}</b><span>사용자{{if eq .Settings.Access "public"}} (IP 기준){{end}}</span></div>
				<div class="company-kpi"><b>{{printf "%.1f" .Summary.ErrorRate}}%</b><span>에러율</span></div>
				<div class="company-kpi"><b>{{.Summary.P95}}ms</b><span>응답시간 p95</span></div>
				<div class="company-kpi"><b>{{.Summary.MemMaxMB}}<small>/{{.MemoryLimitMB}}MB</small></b><span>메모리 최대</span></div>
				{{if .Summary.Blocked}}<div class="company-kpi bad"><b>{{.Summary.Blocked}}</b><span>차단된 다운로드</span></div>{{end}}
			</div>
			<div class="tw-mt-2">
				{{range $r := (StringUtils.Split "1h,24h,7d,30d" ",")}}
					<a class="ui tiny {{if eq $.Window $r}}primary{{else}}basic{{end}} button" href="?range={{$r}}">{{$r}}</a>
				{{end}}
			</div>
			{{/* Distinct visitors cannot be summed across five-minute windows
			     without counting someone twice, so this is the busiest single
			     window, not a total. Saying so here is cheaper than an admin
			     drawing the wrong conclusion from it. */}}
			<div class="text-grey tw-text-12 tw-mt-2">사용자 수는 5분 구간 중 가장 많았던 값입니다(합계가 아닙니다). 메모리는 프로세스 트리 합산이라 공유 메모리가 중복 계산되어 실제보다 크게 나옵니다.</div>
		</div>

		<div class="ui attached segment company-charts"
			data-points="{{.ChartPoints}}"
			data-annotations="{{.ChartAnnotations}}"
			data-memory-limit="{{.MemoryLimitMB}}">
			<div class="company-chart"><h5>요청 수 · 에러</h5><div class="company-chart-canvas"><canvas data-chart="requests"></canvas></div></div>
			<div class="company-chart"><h5>메모리 (MB) · CPU (%)</h5><div class="company-chart-canvas"><canvas data-chart="resources"></canvas></div></div>
			<div class="company-chart"><h5>응답시간 p95 (ms)</h5><div class="company-chart-canvas"><canvas data-chart="latency"></canvas></div></div>
		</div>

		<h4 class="ui top attached header tw-mt-4">환경변수</h4>
		<div class="ui attached segment">
			{{if .EnvError}}
				<div class="ui negative message tw-m-0">{{.EnvError}}</div>
			{{else if .EnvNames}}
				{{if .EnvRestartRequired}}
					<div class="ui warning message tw-mt-0">저장된 환경변수가 실행 중인 값과 다릅니다. 적용하려면 재시작이 필요합니다.</div>
				{{end}}
				{{/* Names only, never values — see company/envstore.go. */}}
				<div>{{range .EnvNames}}<span class="ui label tw-mr-1">{{.}}</span>{{end}}</div>
				<div class="text-grey tw-text-12 tw-mt-2">값은 암호화되어 저장되며 다시 표시되지 않습니다. 값 변경은 부서가 저장소의 앱 화면에서 합니다.</div>
			{{else}}
				<span class="text-grey">설정된 환경변수가 없습니다.</span>
			{{end}}
		</div>

		{{/* Split by where the permission came from. The platform's stack is the
		     same for every app and is not this app's decision; the approved list
		     is what an admin granted to this one, and is the only part worth
		     reviewing here. */}}
		{{/* The other side of the approval flow. A department asks to widen
		     inbound and can only ask for outbound; this is an admin closing
		     something that should not have been open, or opening it without
		     waiting for a request to be written. Removal matters more than
		     addition — an approval flow that can only add is a ratchet, and "we
		     approved that by mistake" has to have an answer. */}}
		<h4 class="ui top attached header tw-mt-4">접근 · 통신 정책</h4>
		<div class="ui attached segment">
			<form method="post" action="{{.AdminAppLink}}/network" class="ui form">
				{{.CsrfTokenHtml}}
				<input type="hidden" name="what" value="access">
				<div class="tw-mb-1"><strong>들어오는 접근 (inbound)</strong></div>
				<div class="tw-flex tw-items-center tw-gap-2 tw-flex-wrap">
					<select name="access">
						{{range .AccessOptions}}
							<option value="{{.Value}}" {{if .Selected}}selected{{end}}>{{.Label}} — {{.Explain}}</option>
						{{end}}
					</select>
					<button class="ui button">적용</button>
				</div>
				<div class="text-grey tw-text-12 tw-mt-1">
					부서가 스스로 좁힐 수 있지만 넓히려면 승인이 필요합니다. 여기서는 관리자가 양쪽 다 바로 정합니다.
				</div>
			</form>

			<div class="tw-mt-4"><strong>나가는 통신 (outbound)</strong></div>
			{{if not .NetworkEnforced}}
				{{/* The control is written down and not applied. Said here rather
				     than only in the sandbox banner, because this is the panel an
				     operator reads when deciding whether an app may handle real
				     data — and "차단됨" beside a host list is read as a guarantee. */}}
				<div class="ui negative message tw-mt-1">
					<div class="header">이 서버에서는 외부 통신 차단이 적용되지 않습니다</div>
					<div class="tw-text-13 tw-mt-1">
						아래 설정은 정책으로 저장되지만, 지금 이 호스트는 앱의 외부 연결을 막을 수 없습니다.
						앱은 실제로 어디로든 연결할 수 있습니다. 격리가 되는 서버에서만 위 목록이 실제 통제가 됩니다.
					</div>
					<div class="text-grey tw-text-12 tw-mt-1">{{.NetworkUnenforcedWhy}}</div>
				</div>
			{{end}}
			<div class="text-grey tw-text-12 tw-mt-1">
				{{if eq .NetworkMode "open"}}
					<span class="company-app-state failed">제한 없음</span>
					이 앱은 어디로든 연결할 수 있습니다. 예외 설정이며, 아래에서 특정 주소만 허용하도록 좁힐 수 있습니다.
				{{else if eq .NetworkMode "broker"}}
					아래 주소로만 연결할 수 있습니다. 그 외에는 모두 차단됩니다.
				{{else}}
					지금은 외부 통신이 모두 차단되어 있습니다. 주소를 추가하면 그 주소만 열립니다.
				{{end}}
			</div>
			{{if .OutboundRules}}
				<table class="ui very basic table tw-text-13">
					<tbody>
						{{range .OutboundRules}}
							<tr>
								<td class="tw-font-mono">{{.Host}}</td>
								<td class="tw-w-32">{{if .Methods}}{{StringUtils.Join .Methods ", "}}{{else}}GET{{end}}</td>
								<td class="tw-w-24">
									<form method="post" action="{{$.AdminAppLink}}/network"
										data-company-confirm="{{.Host}} 로의 통신을 차단합니다. 이 주소를 쓰는 기능이 동작하지 않게 됩니다. 계속할까요?">
										{{$.CsrfTokenHtml}}
										<input type="hidden" name="what" value="outbound-remove">
										<input type="hidden" name="host" value="{{.Host}}">
										<button class="ui tiny basic red button">차단</button>
									</form>
								</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			{{end}}
			<form method="post" action="{{.AdminAppLink}}/network" class="ui form tw-mt-2">
				{{.CsrfTokenHtml}}
				<input type="hidden" name="what" value="outbound-add">
				<div class="tw-flex tw-items-center tw-gap-2 tw-flex-wrap">
					<input type="text" name="host" class="tw-flex-1" autocomplete="off"
						placeholder="주소 붙여넣기 (예: https://erp.internal.company.com/api 또는 erp.internal.company.com)">
					<select name="methods">
						<option value="GET">읽기만 (GET)</option>
						<option value="GET,POST">읽기와 보내기 (GET, POST)</option>
					</select>
					<button class="ui button">허용</button>
				</div>
			</form>

			<div class="tw-mt-4"><strong>파일 다운로드</strong></div>
			<form method="post" action="{{.AdminAppLink}}/network" class="tw-flex tw-items-center tw-gap-2 tw-mt-1 tw-flex-wrap">
				{{.CsrfTokenHtml}}
				<input type="hidden" name="what" value="download">
				{{if .DownloadAllowed}}
					<span class="company-app-state running">허용됨</span>
					<button class="ui tiny basic red button">차단하기</button>
				{{else}}
					<span class="company-app-state failed">차단됨</span>
					<input type="hidden" name="allow" value="1">
					<button class="ui tiny basic button">허용하기</button>
				{{end}}
				<span class="text-grey tw-text-12">
					화면에 보이는 것은 막지 못합니다 — 막히는 것은 다운로드 버튼과 대량 반출입니다.
				</span>
			</form>
		</div>

		<h4 class="ui top attached header tw-mt-4">설치 가능한 패키지</h4>
		<div class="ui attached segment">
			<div class="tw-mb-2">
				<span class="text-grey tw-text-13">플랫폼 기본</span>
				<div class="tw-mt-1">
					{{range .BasePackages}}<span class="ui basic label tw-mr-1">{{.}}</span>{{else}}<span class="text-grey">없음</span>{{end}}
				</div>
			</div>
			{{if .SharedAllow}}
				<div class="tw-mb-2">
					<span class="text-grey tw-text-13">모든 앱에 허용</span>
					<div class="tw-mt-1">{{range .SharedAllow}}<span class="ui basic label tw-mr-1">{{.}}</span>{{end}}</div>
				</div>
			{{end}}
			<div>
				<span class="text-grey tw-text-13">이 앱에 승인된 패키지</span>
				<div class="tw-mt-1">
					{{range .ApprovedExtra}}<span class="ui green basic label tw-mr-1">{{.}}</span>{{else}}<span class="text-grey">아직 승인된 것이 없습니다. 배포 요청을 승인하면 여기에 추가됩니다.</span>{{end}}
				</div>
			</div>
			{{/* The case this exists for: a dependency the build resolved that
			     appears in no file anyone wrote, so the department has nothing
			     to tick and cannot raise a request for it at all. The button
			     sits with the names because by the time this panel is on screen
			     the decision is already made — what is missing is one click. */}}
			<form method="post" action="{{.AdminAppLink}}/approve-packages" class="ui form tw-mt-4">
				{{.CsrfTokenHtml}}
				{{if .MissingPackages}}
					<div class="ui warning message tw-mt-0">
						<div class="header">직전 배포가 이 패키지에서 멈췄습니다</div>
						<div class="tw-text-13 tw-mt-1">
							승인한 패키지가 필요로 하는 의존성이라 부서에서는 요청할 방법이 없습니다.
						</div>
						<div class="tw-flex tw-items-center tw-gap-3 tw-flex-wrap tw-mt-3">
							{{range .MissingPackages}}
								<label class="tw-inline-flex tw-items-center tw-gap-1">
									<input type="checkbox" name="package" value="{{.}}" checked>
									<span class="tw-font-mono">{{.}}</span>
								</label>
							{{end}}
							<button class="ui primary button tw-ml-2">승인</button>
						</div>
					</div>
				{{end}}
				{{/* Secondary: for an admin who already knows what is needed and
				     does not want to wait for a build to discover it. */}}
				<details class="tw-mt-2">
					<summary class="text-grey tw-text-13 tw-cursor-pointer">패키지를 직접 지정해 승인</summary>
					<div class="tw-flex tw-items-center tw-gap-2 tw-flex-wrap tw-mt-2">
						<input type="text" name="extra" placeholder="한 줄에 하나, 이름 또는 이름==버전" class="tw-flex-1">
						<button class="ui button">승인</button>
					</div>
				</details>
				<div class="text-grey tw-text-12 tw-mt-3">
					보통은 배포 요청을 머지할 때 승인됩니다. 어느 쪽이든 결과는 central-deploy 의
					<code>.company/apps.yml</code> 커밋으로 남고, 커밋 작성자가 승인한 사람입니다.
					승인해도 <strong>[다시 배포]</strong> 를 눌러야 실제로 설치됩니다.
					<a href="{{AppSubUrl}}/-/admin/company-packages">패키지 관리</a>
				</div>
			</form>
		</div>

		<h4 class="ui top attached header">최근 이력</h4>
		<div class="ui attached table segment">
			{{/* Headers and plain words, as on the department screen — a column of
			     bare "activating / rolled_back" says nothing on its own. The raw
			     code stays beside it: this is the admin view, and the code is
			     what matches the logs and the source. */}}
			{{template "company/history_table" dict "Rows" .HistoryRows "Raw" true}}
		</div>
	</div>
{{template "admin/layout_footer" .}}

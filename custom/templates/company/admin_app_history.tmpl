{{template "admin/layout_head" (dict "pageClass" "admin company-app-history")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header tw-flex tw-items-center tw-gap-2">
			<a href="{{.AdminAppLink}}">{{.App.Owner}}/{{.App.Repo}}</a>
			<span class="text-grey">/ {{ctx.Locale.Tr "company.history.title"}}</span>
			{{/* The app's own state, not a per-attempt outcome: a deploy that is
			     queued or building has no entry in the log below yet. */}}
			<span class="company-app-state {{.App.Actual}}">{{ctx.Locale.Tr .StatusLabel}}</span>
			<div class="tw-flex-1"></div>
			<span class="text-grey tw-text-13">{{ctx.Locale.Tr "company.history.count" .TotalAttempts}}</span>
		</h4>
		<div class="ui attached segment">
			{{/* Read from the build log's own headers, which are written by the
			     deploy itself — so this cannot drift from what happened. It
			     reaches back as far as the logs are kept, not as far as the app
			     has existed. */}}
			{{/* The one thing that is not obvious from a list of past versions:
			     this is not a restore. The build uses today's policy, today's base
			     packages and today's interpreter. */}}
			<p class="text-grey tw-text-13 tw-mt-0">
				{{ctx.Locale.Tr "company.history.intro_admin"}}
				{{ctx.Locale.Tr "company.history.rebuild_note"}}
				{{if .Running.SHA}}{{ctx.Locale.Tr "company.history.running_is" (ShortSha .Running.SHA)}}{{end}}
			</p>
			<table class="ui very basic table tw-text-13">
				<thead>
					<tr>
						<th class="tw-w-1/6">{{ctx.Locale.Tr "company.history.col_when"}}</th>
						<th class="tw-w-24">{{ctx.Locale.Tr "company.history.col_result"}}</th>
						<th class="tw-w-1/6">{{ctx.Locale.Tr "company.history.col_version"}}</th>
						<th>{{ctx.Locale.Tr "company.history.col_detail"}}</th>
						<th class="tw-w-32"></th>
					</tr>
				</thead>
				<tbody>
					{{range .Attempts}}
						<tr{{if .InProgress}} class="company-attempt-live"{{end}}>
							<td title="{{DateUtils.AbsoluteShort .At}}">{{DateUtils.TimeSince .At}}</td>
							<td>
								{{/* A deploy that has not finished has no build-log entry yet,
								     so without this row the page implies nothing is happening. */}}
								{{if .InProgress}}
									<span class="company-app-state building">{{.State}}</span>
								{{else if .Failed}}
									<span class="company-app-state failed">{{ctx.Locale.Tr "company.history.failed"}}</span>
								{{else}}
									<span class="company-app-state running">{{ctx.Locale.Tr "company.history.succeeded"}}</span>
								{{end}}
							</td>
							{{/* Which one is live is not "the newest": a failed deploy
							     leaves the previous version running, and a rollback puts
							     an older one back. */}}
							{{/* "Running" and "latest" are different rows after a failed
							     deploy or a rollback, and that difference is usually what
							     someone came here to find. */}}
							<td class="tw-font-mono">
								{{if .SHA}}{{ShortSha .SHA}}{{else}}<span class="text-grey">—</span>{{end}}
								{{if .Current}}<span class="ui green mini label tw-ml-1">{{ctx.Locale.Tr "company.history.badge_running"}}</span>{{end}}
								{{if .Latest}}<span class="ui blue mini label tw-ml-1">{{ctx.Locale.Tr "company.history.badge_latest"}}</span>{{end}}
							</td>
							{{/* The build log is the app's own output and an admin screen,
							     so paths are left alone here — see company/applogs.go. */}}
							{{/* Summary is a locale key for the in-progress row (built with no reader
							     and so no language) and the build log's own words for a finished
							     one. HasKey tells them apart. */}}
							<td>{{if .Summary}}{{if ctx.Locale.HasKey .Summary}}{{ctx.Locale.Tr .Summary}}{{else}}{{.Summary}}{{end}}{{else}}<span class="text-grey">—</span>{{end}}</td>
							<td>
								{{/* Offered for failures too: what a build was refused for is
								     usually policy, and policy has since changed — the package
								     it needed is approved now. */}}
								{{if and .SHA (and (not .Current) (not .InProgress))}}
									<form method="post" action="{{$.AdminAppLink}}/deploy-version"
										data-company-confirm="{{ctx.Locale.Tr "company.history.deploy_confirm" (ShortSha .SHA)}}">
										{{$.CsrfTokenHtml}}
										<input type="hidden" name="sha" value="{{.SHA}}">
										<button class="ui tiny basic button">{{ctx.Locale.Tr "company.history.deploy_this"}}</button>
									</form>
								{{end}}
							</td>
						</tr>
					{{else}}
						<tr><td colspan="5" class="text-grey">{{ctx.Locale.Tr "company.history.empty"}}</td></tr>
					{{end}}
				</tbody>
			</table>
		</div>
		{{template "base/paginate" .}}

		{{/* State changes, not deploys: who stopped it, when it was rolled back.
		     Capped at ten by the state file, which is why it is a panel here
		     rather than a second paged table. */}}
		<h4 class="ui top attached header tw-mt-4">{{ctx.Locale.Tr "company.history.state_changes"}}</h4>
		<div class="ui attached table segment">
			{{template "company/history_table" dict "Rows" .HistoryRows "Raw" true}}
		</div>
	</div>
{{template "admin/layout_footer" .}}

{{/* The right column of a Deploy Request PR, in place of Gitea's own
     (reviewers, milestone, assignees, due date, dependencies — none of
     which decide whether an app goes live). What does: who asked, what
     the app wants to be allowed, which packages it installs, and an
     assistant that has read the change. Set up by
     company.SetDeployRequestPageData (company/deploy_review.go). */}}
<div class="issue-content-right company-deploy-review" data-global-init="initCompanyDeployReviewPackages" data-i18n-ai-author="{{ctx.Locale.Tr "company.review.ai_author"}}" data-i18n-platform-author="{{ctx.Locale.Tr "company.review.platform_author"}}" data-central-owner-link="{{.DeployCentralOwnerLink}}">
	<div class="ui segment company-deploy-review-panel">
		<h4 class="tw-mb-3">{{if .DeployRemoval}}{{svg "octicon-trash" 16 "tw-mr-1"}}{{ctx.Locale.Tr "company.review.title_removal"}}{{else}}{{svg "octicon-rocket" 16 "tw-mr-1"}}{{ctx.Locale.Tr "company.review.title"}}{{end}}</h4>
		<div class="company-deploy-review-facts">
			<span class="text-grey">{{ctx.Locale.Tr "company.review.department"}}</span>
			<a href="{{.DeployDeptLink}}">{{.DeployDeptOwner}}/{{.DeployDeptName}}</a>
			<span class="text-grey">{{ctx.Locale.Tr "company.review.requester"}}</span>
			<span>{{if .DeployRequester}}{{ctx.AvatarUtils.Avatar .DeployRequester 18 "tw-mr-1"}}{{.DeployRequester.Name}}{{else}}{{.Issue.Poster.Name}}{{end}}</span>
			<span class="text-grey">{{ctx.Locale.Tr "company.review.submitted"}}</span>
			<span>{{DateUtils.AbsoluteShort .Issue.CreatedUnix}}</span>
		</div>
		{{with .DeployRequestStatus}}
			<div class="ui {{if eq .Status "approved" "deployed"}}green{{else if eq .Status "rejected" "deploy_failed"}}red{{else if eq .Status "cancelled"}}grey{{else}}yellow{{end}} label tw-mt-3">
				{{ctx.Locale.Tr (printf "company.deploy_status.%s" .Status)}}
			</div>
		{{end}}
		{{if not .Issue.IsClosed}}
			<p class="text-grey tw-text-12 tw-mt-3 tw-mb-0">{{if .DeployRemoval}}{{ctx.Locale.Tr "company.review.decide_removal"}}{{else}}{{ctx.Locale.Tr "company.review.decide"}}{{end}}</p>
		{{end}}
		{{/* Main moved on since the request was made and git cannot apply it.
		     The files are known, so the way through is one press: the same
		     files on today's main, as a new request. See company/deploy_rebase.go. */}}
		{{if and .DeployConflict (not .Issue.IsClosed)}}
			<div class="ui warning message tw-mt-3 tw-mb-0">
				<div class="header">{{ctx.Locale.Tr "company.review.conflict_header"}}</div>
				<p class="tw-text-13 tw-mt-1">{{ctx.Locale.Tr "company.review.conflict_explain"}}</p>
				<form method="post" action="{{.DeployRebaseURL}}">{{.CsrfTokenHtml}}
					<button class="ui primary tiny button">{{ctx.Locale.Tr "company.review.conflict_fix"}}</button>
				</form>
			</div>
		{{end}}
	</div>

	{{if .DeployRemoval}}
		<div class="ui negative message company-deploy-review-panel">
			<div class="header">{{svg "octicon-trash" 16 "tw-mr-1"}}{{ctx.Locale.Tr "company.review.removal_header"}}</div>
			<p class="tw-text-13 tw-mt-1 tw-mb-0">{{ctx.Locale.Tr "company.review.removal_explain"}}</p>
		</div>
	{{end}}

	{{/* Merging is the approval — the items are applied with it
	     (company/permissions_commit.go), and there is no second button. */}}
	<div class="ui segment company-deploy-review-panel">
		<h4 class="tw-mb-2">{{svg "octicon-shield-lock" 16 "tw-mr-1"}}{{ctx.Locale.Tr "company.deploy.requested_perms" (len .PermissionRequests)}}</h4>
		{{range .PermissionRequests}}
			<div class="company-perm-review-item">
				<div>
					<strong>{{if ctx.Locale.HasKey .Label}}{{ctx.Locale.Tr .Label}}{{else}}{{.Label}}{{end}}</strong> — {{if .DetailKey}}{{ctx.Locale.Tr .DetailKey}}{{else}}{{.Detail}}{{end}}
					{{if .Evidence}}<div class="text-grey tw-text-12">{{if not (ctx.Locale.HasKey .Evidence)}}{{.Evidence}}{{else if .EvidenceArg}}{{ctx.Locale.Tr .Evidence .EvidenceArg}}{{else}}{{ctx.Locale.Tr .Evidence}}{{end}}</div>{{end}}
					{{if .Reason}}<div class="tw-text-13 tw-mt-1">{{ctx.Locale.Tr "company.deploy.perm_reason" .Reason}}</div>{{end}}
				</div>
			</div>
		{{else}}
			<p class="text-grey tw-text-13 tw-mb-0">{{ctx.Locale.Tr "company.review.perms_none"}}</p>
		{{end}}
		{{if and .PermissionRequests (not .Issue.IsClosed)}}
			<p class="text-grey tw-text-12 tw-mt-2 tw-mb-0">{{ctx.Locale.Tr "company.deploy.perm_merge_note"}}</p>
		{{end}}
	</div>

	{{/* The requested version, run on its own for a look before deciding —
	     its own process and a copy of today's data, never the live app.
	     See company/apppreview.go. */}}
	{{if and (not .Issue.IsClosed) (not .DeployRemoval)}}
		{{with .DeployPreview}}
			<div class="ui segment company-deploy-review-panel company-deploy-preview" data-global-init="initCompanyDeployPreview" data-state="{{.State}}" data-status-url="{{$.DeployPreviewURL}}/status">
				<h4 class="tw-mb-2">{{svg "octicon-eye" 16 "tw-mr-1"}}{{ctx.Locale.Tr "company.preview.title"}}</h4>
				<p class="text-grey tw-text-12">{{ctx.Locale.Tr "company.preview.explain"}}</p>
				{{if eq .State "building"}}
					<div class="tw-flex tw-items-center tw-gap-2"><span class="ui yellow tiny label">{{ctx.Locale.Tr "company.preview.building"}}</span><span class="text-grey tw-text-12">{{ctx.Locale.Tr "company.preview.building_note"}}</span></div>
				{{else if eq .State "running"}}
					<div class="tw-flex tw-items-center tw-gap-2 tw-flex-wrap">
						<a class="ui primary tiny button" href="{{.URL}}" target="_blank" rel="noopener">{{svg "octicon-link-external" 14}} {{ctx.Locale.Tr "company.preview.open"}}</a>
						<form method="post" action="{{$.DeployPreviewURL}}/stop" class="tw-inline">{{$.CsrfTokenHtml}}<button class="ui basic tiny button">{{ctx.Locale.Tr "company.preview.stop"}}</button></form>
					</div>
					<p class="text-grey tw-text-12 tw-mt-2 tw-mb-0">{{if eq .DataNote "copied"}}{{ctx.Locale.Tr "company.preview.data_copied"}}{{else}}{{ctx.Locale.Tr "company.preview.data_empty"}}{{end}}</p>
				{{else if eq .State "failed"}}
					<div class="ui negative message tw-mt-0"><div class="header">{{ctx.Locale.Tr "company.preview.failed"}}</div><p class="tw-text-13">{{.Error}}</p></div>
				{{end}}
				{{if ne .State "building"}}
					<form method="post" action="{{$.DeployPreviewURL}}" class="tw-mt-2">{{$.CsrfTokenHtml}}
						<button class="ui tiny button">{{if eq .State "stopped"}}{{ctx.Locale.Tr "company.preview.build"}}{{else}}{{ctx.Locale.Tr "company.preview.rebuild"}}{{end}}</button>
					</form>
				{{end}}
				<p class="text-grey tw-text-12 tw-mt-2 tw-mb-0">{{ctx.Locale.Tr "company.preview.idle_note"}}</p>
			</div>
		{{end}}
	{{end}}

	{{/* Can the server carry it: the memory this app would hold against
	     what the running apps commit, the storage it asks for against the
	     volume. Numbers for the approver, not a gate. See company/deploy_capacity.go. */}}
	{{with .Capacity}}
		<div class="ui segment company-deploy-review-panel">
			<h4 class="tw-mb-2">{{svg "octicon-server" 16 "tw-mr-1"}}{{ctx.Locale.Tr "company.review.capacity_header"}}</h4>
			{{range .}}
				<div class="company-capacity-row {{.State}}">
					{{if eq .State "ok"}}{{svg "octicon-check-circle" 14}}{{else if eq .State "warn"}}{{svg "octicon-alert" 14}}{{else}}{{svg "octicon-x-circle" 14}}{{end}}
					<span class="tw-text-13">{{.Text}}</span>
				</div>
			{{end}}
		</div>
	{{end}}

	{{/* Every package the snapshot installs, not only the new ones: what
	     is already allowed is part of the picture too. */}}
	{{if not .DeployRemoval}}
	<div class="ui segment company-deploy-review-panel">
		<h4 class="tw-mb-2">{{svg "octicon-package" 16 "tw-mr-1"}}{{ctx.Locale.Tr "company.review.packages" (len .DeployPackages)}}</h4>
		{{/* Ticked packages travel with "Approve deploy" — company-deploy-review.ts
		     copies them into the merge form as it is submitted, and
		     company.ApprovePackagesOnMerge records them for the approval. */}}
		{{$canTick := and .DeployPackagesPending (not .Issue.IsClosed)}}
		{{if $canTick}}
			<label class="company-deploy-review-package company-deploy-review-allow-all">
				<span class="tw-flex tw-items-center tw-gap-2"><input type="checkbox" class="company-deploy-review-allow-all-box"> {{ctx.Locale.Tr "company.review.allow_all" .DeployPackagesPending}}</span>
			</label>
		{{end}}
		{{range .DeployPackages}}
			{{$tick := and $canTick (not .Allowed) (not .Requested)}}
			{{/* A label for every row, since a tag name cannot be chosen in a
			     template; one without a box is just text. */}}
			<label class="company-deploy-review-package">
				<span class="tw-flex tw-items-center tw-gap-2">
					{{if $tick}}<input type="checkbox" class="company-deploy-review-package-box" value="{{.Name}}">{{end}}
					<span class="tw-font-mono tw-text-13">{{.Name}}{{if .Version}} <span class="text-grey">{{.Version}}</span>{{end}}</span>
				</span>
				{{if .Allowed}}
					<span class="ui basic tiny label">{{ctx.Locale.Tr "company.review.pkg_allowed"}}</span>
				{{else if .Requested}}
					<span class="ui blue tiny label">{{ctx.Locale.Tr "company.review.pkg_requested"}}</span>
				{{else}}
					<span class="ui yellow tiny label">{{ctx.Locale.Tr "company.review.pkg_needs_approval"}}</span>
				{{end}}
			</label>
		{{else}}
			<p class="text-grey tw-text-13 tw-mb-0">{{if .Issue.IsClosed}}{{ctx.Locale.Tr "company.review.packages_unavailable"}}{{else}}{{ctx.Locale.Tr "company.review.packages_none"}}{{end}}</p>
		{{end}}
		{{if $canTick}}
			<p class="text-grey tw-text-12 tw-mt-2 tw-mb-0">{{ctx.Locale.Tr "company.review.allow_hint"}}</p>
		{{end}}
	</div>
	{{end}}

	{{if .CompanyAIOffered}}
		<div class="company-deploy-review-chat" data-global-init="initCompanyDeployReview" data-ai-ready="{{.AIEnabled}}"
			data-send-url="{{.DeployChatURL}}"
			data-ai-empty-state="{{ctx.Locale.Tr "company.review.ai_empty_state"}}"
			data-ai-not-configured="{{ctx.Locale.Tr "company.workspace.ai_not_configured"}}"
			data-ai-not-configured-link="{{ctx.Locale.Tr "company.workspace.ai_not_configured_link"}}"
			data-ai-not-configured-url="{{printf "%s/user/settings/ai" AppSubUrl}}"
			data-ai-not-configured-placeholder="{{ctx.Locale.Tr "company.workspace.ai_not_configured_placeholder"}}"
			data-ai-stop="{{ctx.Locale.Tr "company.workspace.ai_stop"}}"
			data-ai-request-failed="{{ctx.Locale.Tr "company.workspace.ai_request_failed"}}"
			data-ai-read-status="{{ctx.Locale.Tr "company.workspace.ai_read_status" "%s"}}"
			data-ai-edit-status="{{ctx.Locale.Tr "company.workspace.ai_edit_status" "%s"}}"
			data-ai-delete-status="{{ctx.Locale.Tr "company.workspace.ai_delete_status" "%s"}}"
			data-ai-rename-status="{{ctx.Locale.Tr "company.workspace.ai_rename_status" "%s" "%s"}}"
			data-ai-queued="{{ctx.Locale.Tr "company.workspace.ai_queued" "%s"}}"
		>
			<div class="company-ai-chat-header">{{svg "octicon-sparkle-fill" 14 "tw-mr-1"}}{{ctx.Locale.Tr "company.review.ai_title"}}</div>
			<div class="company-ai-chat-messages"></div>
			<div class="company-ai-chat-inputbar">
				<div class="company-ai-chat-queue tw-hidden"></div>
				<div class="company-ai-chat-inputwrap">
					<textarea class="company-ai-chat-input" rows="1" placeholder="{{ctx.Locale.Tr "company.review.ai_placeholder"}}"></textarea>
					<div class="company-ai-chat-inputtoolbar">
						<span class="company-ai-chat-context tw-hidden"></span>
						<select class="company-ai-chat-model" aria-label="{{ctx.Locale.Tr "company.workspace.ai_model"}}"
						        data-models-url="{{printf "%s/user/settings/ai/models" AppSubUrl}}"
						        data-provider="{{.AIProvider}}">
							{{if .AIModel}}<option value="{{.AIModel}}" selected>{{.AIModel}}</option>{{end}}
						</select>
						<button type="button" class="company-ai-chat-send" aria-label="{{ctx.Locale.Tr "company.workspace.ai_send"}}"></button>
					</div>
				</div>
			</div>
		</div>
	{{end}}
</div>

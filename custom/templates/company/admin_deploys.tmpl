{{template "admin/layout_head" (dict "pageClass" "admin company-deploys")}}
	<div class="admin-setting-content">

		{{/* The build environment, before the app list: a missing interpreter or
		     an unparsable policy file stops every deploy, and an admin should
		     not learn that from a failed deploy. */}}
		{{if or (not .PythonOK) (not .SandboxOK) .ConfigError}}
			<div class="ui attached warning message">
				{{if not .PythonOK}}<div><strong>{{ctx.Locale.Tr "company.admin.no_python"}}</strong> {{.PythonDetail}}</div>{{end}}
				{{if not .SandboxOK}}<div><strong>{{ctx.Locale.Tr "company.admin.no_sandbox"}}</strong> {{.SandboxDetail}}</div>{{end}}
				{{if .ConfigError}}<div><strong>{{ctx.Locale.Tr "company.admin.config_error"}}</strong> {{.ConfigError}}</div>{{end}}
			</div>
		{{end}}

		{{/* "Is the platform all right" — the question the list below cannot
		     answer without reading every row. */}}
		{{/* Title first, then the figure, then one line saying what the
		     figure is made of: a number with its meaning underneath was read
		     twice before it was understood. */}}
		<div class="company-kpis company-kpis-titled">
			<div class="company-kpi"><span class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_apps"}}</span><b>{{.CountTotal}}</b></div>
			<div class="company-kpi"><span class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_running"}}</span><b>{{.CountRunning}}</b></div>
			<div class="company-kpi"><span class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_error_rate"}}</span><b>{{printf "%.1f" .Fleet.ErrorRate}}%</b><span>{{ctx.Locale.Tr "company.admin.kpi_error_rate_note"}}</span></div>
			<div class="company-kpi"><span class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_p95"}}</span><b>{{.Fleet.P95}}<small>ms</small></b><span>{{ctx.Locale.Tr "company.admin.kpi_p95_note"}}</span></div>
			{{/* The limits added up against the machine: thirty modest apps, or
			     one generous one, can promise more memory than exists, and this
			     is where that shows before the kernel decides who finds out. */}}
			<div class="company-kpi{{if .Fleet.CommitOver}} full{{else if .Fleet.CommitWarn}} warn{{end}}">
				<span class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_committed"}}</span>
				<b>{{.Fleet.CommittedMB}}<small>MB{{if .Fleet.HostKnown}} / {{.Fleet.HostTotalMB}}MB{{end}}</small></b>
				<span>{{if .Fleet.HostKnown}}{{ctx.Locale.Tr "company.admin.kpi_committed_note" .Fleet.CommitPct}}{{else}}{{ctx.Locale.Tr "company.admin.kpi_committed_note_nohost"}}{{end}}</span>
			</div>
			{{if .Fleet.HostAvailable}}
				<div class="company-kpi"><span class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_host_free"}}</span><b>{{.Fleet.HostAvailMB}}<small>MB</small></b><span>{{ctx.Locale.Tr "company.admin.kpi_host_free_note"}}</span></div>
			{{end}}
			{{if .Fleet.HostKnown}}
				<div class="company-kpi{{if eq .Fleet.RoomApps 0}} warn{{end}}"><span class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_room"}}</span><b>{{.Fleet.RoomApps}}<small> {{ctx.Locale.Tr "company.admin.kpi_room_unit"}}</small></b><span>{{ctx.Locale.Tr "company.admin.kpi_room_note" .Fleet.DefaultMemMB .Fleet.RoomMB}}</span></div>
			{{end}}
		</div>
		{{/* Which wall holds the limits: the kernel (a systemd scope) or the
		     watchdog alone. An operator sizing limits has to know which. */}}
		<p class="text-grey tw-text-12 tw-mt-2">{{if .CgroupOK}}{{svg "octicon-shield-check" 12}}{{else}}{{svg "octicon-shield" 12}}{{end}} {{ctx.Locale.Tr "company.admin.limits_enforced_by"}} {{.CgroupDetail}}</p>
		{{if .Fleet.CommitWarn}}
			<div class="ui {{if .Fleet.CommitOver}}negative{{else}}warning{{end}} message">
				{{ctx.Locale.Tr "company.admin.commit_warning" .Fleet.CommittedMB .Fleet.HostTotalMB .Fleet.CommitPct}}
			</div>
		{{end}}

		{{if .Attention}}
			{{/* Only rendered when there is something to act on. A section that
			     is always present stops being read — see docs/company/app-platform.md
			     on the dashboard layout. */}}
			<h4 class="ui top attached header company-deploys-attention-header">
				{{svg "octicon-alert" 16 "tw-mr-2"}}{{ctx.Locale.Tr "company.admin.attention" (len .Attention)}}
			</h4>
			<div class="ui attached table segment">
				<table class="ui very basic table">
					<tbody>
						{{range .Attention}}
							<tr>
								<td class="tw-w-1/3">
									{{if .Repo}}
										<a href="{{AppSubUrl}}/-/admin/company-deploys/{{PathEscape .State.Owner}}/{{PathEscape .State.Repo}}">{{.State.Owner}}/{{.State.Repo}}</a>
									{{else}}
										{{.State.Owner}}/{{.State.Repo}}
									{{end}}
								</td>
								<td>
									{{template "company/admin_deploys_status" .State}}
									{{if not .Repo}}<span class="text-red tw-ml-2">{{ctx.Locale.Tr "company.admin.repo_gone"}}</span>{{end}}
									{{if and (eq .State.Actual "running") (not .State.Sandboxed)}}<span class="text-red tw-ml-2">{{ctx.Locale.Tr "company.admin.unsandboxed"}}</span>{{end}}
									{{if .NetworkOpen}}<span class="text-red tw-ml-2">{{ctx.Locale.Tr "company.admin.network_open"}}</span>{{end}}
									{{if .State.Reason}}<span class="text-grey tw-ml-2">{{.State.Reason}}</span>{{end}}
								</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			</div>
		{{end}}

		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "company.admin.deploys_title" .CountTotal}}
			<div class="ui right">
				<span class="text-grey tw-text-13">{{ctx.Locale.Tr "company.admin.counts" .CountRunning .CountStopped .CountFailed}}</span>
			</div>
		</h4>
		<div class="ui attached table segment">
			<table class="ui very basic table">
				<thead>
					<tr>
						<th class="tw-w-1/12">{{ctx.Locale.Tr "company.admin.col_status"}}</th>
						<th>{{ctx.Locale.Tr "company.admin.col_app"}}</th>
						<th class="tw-w-1/6">{{ctx.Locale.Tr "company.admin.col_deploy"}}</th>
						<th class="tw-w-1/6">{{ctx.Locale.Tr "company.admin.col_requests"}}</th>
						<th class="tw-w-1/6">{{ctx.Locale.Tr "company.admin.col_memory"}}</th>
						{{if $.DataEnabled}}<th class="tw-w-1/12">{{ctx.Locale.Tr "company.admin.col_data"}}</th>{{end}}
					</tr>
				</thead>
				<tbody>
					{{range .Rows}}
						<tr>
							<td>{{template "company/admin_deploys_status" .State}}</td>
							<td>
								{{if .Repo}}
									<a href="{{AppSubUrl}}/-/admin/company-deploys/{{PathEscape .State.Owner}}/{{PathEscape .State.Repo}}">{{.State.Owner}}/{{.State.Repo}}</a>
									<a class="muted tw-ml-2 tw-text-12" href="{{.Repo.Link}}">{{svg "octicon-link-external" 12}}</a>
								{{else}}
									{{.State.Owner}}/{{.State.Repo}}
								{{end}}
							</td>
							<td class="tw-text-13">
								{{if .State.UpdatedAt}}
									{{DateUtils.TimeSince .State.UpdatedAt}}
								{{else}}
									<span class="text-grey">{{ctx.Locale.Tr "company.admin.never_deployed"}}</span>
								{{end}}
							</td>
							{{/* No health column: the status already comes from the health
							     check (a failing one flips it), and the app page has the
							     detail. Memory sits here instead — the figure that decides
							     whether the limits can all be honoured. */}}
							{{/* The shape, not just the number: "1.2k" cannot say whether
							     that is normal for this app, and a spike is what someone
							     scanning this page is looking for. */}}
							<td class="tw-text-13">
								{{if .Sparkline}}
									{{template "company/sparkline" dict "Points" .Sparkline}}
									<span class="text-grey tw-ml-1">{{.Requests}}</span>
								{{else}}
									<span class="text-grey">—</span>
								{{end}}
							</td>
							<td class="tw-text-13">
								{{if .MemLimitMB}}
									{{if .MemPeakMB}}{{.MemNowMB}}<span class="text-grey">/{{.MemLimitMB}}MB · {{ctx.Locale.Tr "company.adminapp.kpi_memory_peak" .MemPeakMB}}</span>{{else}}<span class="text-grey">—/{{.MemLimitMB}}MB</span>{{end}}
								{{else}}
									<span class="text-grey">—</span>
								{{end}}
							</td>
							{{if $.DataEnabled}}
								<td class="tw-text-13">
									{{if .HasData}}
										<span{{if .Data.Full}} class="company-data-full"{{else if .Data.Warning}} class="company-data-warn"{{end}}>{{.Data.Percent}}%</span>
										<span class="text-grey tw-ml-1">{{FormatByteSize .Data.Bytes}}</span>
									{{else}}
										<span class="text-grey">—</span>
									{{end}}
								</td>
							{{end}}
						</tr>
					{{else}}
						<tr><td colspan="{{if .DataEnabled}}6{{else}}5{{end}}" class="text-grey">{{ctx.Locale.Tr "company.admin.no_repos"}}</td></tr>
					{{end}}
				</tbody>
			</table>
		</div>
	</div>
<style>
.company-deploys-attention-header { background: var(--color-error-bg) !important; }
.company-deploy-state { display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; font-weight: 600; white-space: nowrap; }
.company-deploy-state.running { color: var(--color-success-text); }
.company-deploy-state.failed, .company-deploy-state.suspended { color: var(--color-error-text); }
.company-deploy-state.queued, .company-deploy-state.building, .company-deploy-state.activating { color: var(--color-warning-text); }
.company-deploy-state.stopped { color: var(--color-text-light-2); }
</style>
{{template "admin/layout_footer" .}}

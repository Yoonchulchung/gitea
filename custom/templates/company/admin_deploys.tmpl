{{template "admin/layout_head" (dict "pageClass" "admin company-deploys")}}
	<div class="admin-setting-content">

		{{/* The build environment, before the app list: a missing interpreter or
		     an unparsable policy file stops every deploy, and an admin should
		     not learn that from a failed deploy. */}}
		{{if or (not .PythonOK) (not .SandboxOK) .ConfigError}}
			<div class="ui attached warning message">
				{{if not .PythonOK}}<div><strong>{{ctx.Locale.Tr "company.admin.no_python"}}</strong> {{.PythonDetail}}</div>{{end}}
				{{if not .SandboxOK}}<div><strong>{{ctx.Locale.Tr "company.admin.no_sandbox"}}</strong> {{.SandboxDetail}}</div>{{end}}
				{{if .ConfigError}}<div><strong>{{ctx.Locale.Tr "company.admin.config_error"}}</strong> {{.ConfigError}}</div>{{end}}
			</div>
		{{end}}

		{{/* "Is the platform all right" — the question the list below cannot
		     answer without reading every row. */}}
		<div class="company-kpis">
			<div class="company-kpi"><b>{{.CountTotal}}</b><span>{{ctx.Locale.Tr "company.admin.kpi_apps"}}</span></div>
			<div class="company-kpi"><b>{{.CountRunning}}</b><span>{{ctx.Locale.Tr "company.admin.kpi_running"}}</span></div>
			<div class="company-kpi"><b>{{printf "%.1f" .Fleet.ErrorRate}}%</b><span>{{ctx.Locale.Tr "company.admin.kpi_error_rate"}}</span></div>
			<div class="company-kpi"><b>{{.Fleet.P95}}<small>ms</small></b><span>{{ctx.Locale.Tr "company.admin.kpi_p95"}}</span></div>
		</div>

		{{if .Attention}}
			{{/* Only rendered when there is something to act on. A section that
			     is always present stops being read — see docs/company/app-platform.md
			     on the dashboard layout. */}}
			<h4 class="ui top attached header company-deploys-attention-header">
				{{svg "octicon-alert" 16 "tw-mr-2"}}{{ctx.Locale.Tr "company.admin.attention" (len .Attention)}}
			</h4>
			<div class="ui attached table segment">
				<table class="ui very basic table">
					<tbody>
						{{range .Attention}}
							<tr>
								<td class="tw-w-1/3">
									{{if .Repo}}
										<a href="{{AppSubUrl}}/-/admin/company-deploys/{{PathEscape .State.Owner}}/{{PathEscape .State.Repo}}">{{.State.Owner}}/{{.State.Repo}}</a>
									{{else}}
										{{.State.Owner}}/{{.State.Repo}}
									{{end}}
								</td>
								<td>
									{{template "company/admin_deploys_status" .State}}
									{{if not .Repo}}<span class="text-red tw-ml-2">{{ctx.Locale.Tr "company.admin.repo_gone"}}</span>{{end}}
									{{if and (eq .State.Actual "running") (not .State.Sandboxed)}}<span class="text-red tw-ml-2">{{ctx.Locale.Tr "company.admin.unsandboxed"}}</span>{{end}}
									{{if .NetworkOpen}}<span class="text-red tw-ml-2">{{ctx.Locale.Tr "company.admin.network_open"}}</span>{{end}}
									{{if .State.Reason}}<span class="text-grey tw-ml-2">{{.State.Reason}}</span>{{end}}
								</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			</div>
		{{end}}

		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "company.admin.deploys_title" .CountTotal}}
			<div class="ui right">
				<span class="text-grey tw-text-13">{{ctx.Locale.Tr "company.admin.counts" .CountRunning .CountStopped .CountFailed}}</span>
			</div>
		</h4>
		<div class="ui attached table segment">
			<table class="ui very basic table">
				<thead>
					<tr>
						<th class="tw-w-1/12">{{ctx.Locale.Tr "company.admin.col_status"}}</th>
						<th>{{ctx.Locale.Tr "company.admin.col_app"}}</th>
						<th class="tw-w-1/6">{{ctx.Locale.Tr "company.admin.col_deploy"}}</th>
						<th class="tw-w-1/6">{{ctx.Locale.Tr "company.admin.col_health"}}</th>
						<th class="tw-w-1/6">{{ctx.Locale.Tr "company.admin.col_requests"}}</th>
					</tr>
				</thead>
				<tbody>
					{{range .Rows}}
						<tr>
							<td>{{template "company/admin_deploys_status" .State}}</td>
							<td>
								{{if .Repo}}
									<a href="{{AppSubUrl}}/-/admin/company-deploys/{{PathEscape .State.Owner}}/{{PathEscape .State.Repo}}">{{.State.Owner}}/{{.State.Repo}}</a>
									<a class="muted tw-ml-2 tw-text-12" href="{{.Repo.Link}}">{{svg "octicon-link-external" 12}}</a>
								{{else}}
									{{.State.Owner}}/{{.State.Repo}}
								{{end}}
							</td>
							<td class="tw-text-13">
								{{if .State.UpdatedAt}}
									{{DateUtils.TimeSince .State.UpdatedAt}}
								{{else}}
									<span class="text-grey">{{ctx.Locale.Tr "company.admin.never_deployed"}}</span>
								{{end}}
							</td>
							<td class="tw-text-13">
								{{if eq .State.Health.State "up"}}
									<span class="text-green">{{ctx.Locale.Tr "company.admin.health_up"}}</span>
								{{else if eq .State.Health.State "down"}}
									<span class="text-red">{{ctx.Locale.Tr "company.admin.health_down"}}</span>
								{{else}}
									<span class="text-grey">—</span>
								{{end}}
								{{/* A health result with no timestamp is indistinguishable from a
								     stale one, so always show when it was taken. */}}
								{{if .State.Health.CheckedAt}}<span class="text-grey">· {{DateUtils.TimeSince .State.Health.CheckedAt}}</span>{{end}}
							</td>
							{{/* The shape, not just the number: "1.2k" cannot say whether
							     that is normal for this app, and a spike is what someone
							     scanning this page is looking for. */}}
							<td class="tw-text-13">
								{{if .Sparkline}}
									{{template "company/sparkline" dict "Points" .Sparkline}}
									<span class="text-grey tw-ml-1">{{.Requests}}</span>
								{{else}}
									<span class="text-grey">—</span>
								{{end}}
							</td>
						</tr>
					{{else}}
						<tr><td colspan="5" class="text-grey">{{ctx.Locale.Tr "company.admin.no_repos"}}</td></tr>
					{{end}}
				</tbody>
			</table>
		</div>
	</div>
<style>
.company-deploys-attention-header { background: var(--color-error-bg) !important; }
.company-deploy-state { display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; font-weight: 600; white-space: nowrap; }
.company-deploy-state.running { color: var(--color-success-text); }
.company-deploy-state.failed, .company-deploy-state.suspended { color: var(--color-error-text); }
.company-deploy-state.queued, .company-deploy-state.building, .company-deploy-state.activating { color: var(--color-warning-text); }
.company-deploy-state.stopped { color: var(--color-text-light-2); }
</style>
{{template "admin/layout_footer" .}}

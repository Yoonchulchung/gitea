{{template "admin/layout_head" (dict "pageClass" "admin company-deploys")}}
	<div class="admin-setting-content">

		{{/* The build environment, before the app list: a missing interpreter or
		     an unparsable policy file stops every deploy, and an admin should
		     not learn that from a failed deploy. */}}
		{{if or (not .PythonOK) (not .SandboxOK) .ConfigError}}
			<div class="ui attached warning message">
				{{if not .PythonOK}}<div><strong>{{ctx.Locale.Tr "company.admin.no_python"}}</strong> {{.PythonDetail}}</div>{{end}}
				{{if not .SandboxOK}}<div><strong>{{ctx.Locale.Tr "company.admin.no_sandbox"}}</strong> {{.SandboxDetail}}</div>{{end}}
				{{if .ConfigError}}<div><strong>{{ctx.Locale.Tr "company.admin.config_error"}}</strong> {{.ConfigError}}</div>{{end}}
			</div>
		{{end}}

		{{/* "Is the platform all right" — the question the list below cannot
		     answer without reading every row. */}}
		{{/* Title first, then the figure, then one line saying what the
		     figure is made of: a number with its meaning underneath was read
		     twice before it was understood. */}}
		<div class="company-kpis company-kpis-titled">
			<div class="company-kpi"><h3 class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_apps"}}</h3><b>{{.CountTotal}}</b></div>
			<div class="company-kpi"><h3 class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_running"}}</h3><b>{{.CountRunning}}</b></div>
			<div class="company-kpi"><h3 class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_error_rate"}}</h3><b>{{printf "%.1f" .Fleet.ErrorRate}}%</b></div>
			<div class="company-kpi"><h3 class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_p95"}}</h3><b>{{.Fleet.P95}}<small>ms</small></b></div>
			{{/* The limits added up against the machine: thirty modest apps, or
			     one generous one, can promise more memory than exists, and this
			     is where that shows before the kernel decides who finds out. */}}
			<div class="company-kpi{{if .Fleet.CommitOver}} full{{else if .Fleet.CommitWarn}} warn{{end}}">
				<h3 class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_memory_used"}}</h3>
				<b>{{.Fleet.UsedMB}}<small>MB{{if .Fleet.HostKnown}} / {{.Fleet.HostTotalMB}}MB · {{.Fleet.UsedPct}}%{{end}}</small></b>
				<span>{{ctx.Locale.Tr "company.admin.kpi_memory_used_note" .Fleet.CommittedMB}}</span>
			</div>
			{{if .Fleet.HostAvailable}}
				<div class="company-kpi"><h3 class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_host_free"}}</h3><b>{{.Fleet.HostAvailMB}}<small>MB</small></b><span>{{ctx.Locale.Tr "company.admin.kpi_host_free_note"}}</span></div>
			{{end}}
			{{if .Fleet.HostKnown}}
				<div class="company-kpi{{if eq .Fleet.RoomApps 0}} warn{{end}}"><h3 class="company-kpi-title">{{ctx.Locale.Tr "company.admin.kpi_room"}}</h3><b>{{.Fleet.RoomApps}}<small> {{ctx.Locale.Tr "company.admin.kpi_room_unit"}} · {{.Fleet.RoomMB}}MB</small></b></div>
			{{end}}
		</div>
		{{template "company/admin_flow" .}}
		<h4 class="ui top attached header tw-mt-4">
			{{ctx.Locale.Tr "company.admin.system_header"}}
			<div class="ui right tw-flex tw-gap-1">
				{{range $r := (StringUtils.Split "1h,24h,7d" ",")}}
					<a class="ui mini {{if eq $r $.SystemRange}}primary{{else}}basic{{end}} button" href="?sys={{$r}}">{{$r}}</a>
				{{end}}
			</div>
		</h4>
		<div class="ui attached segment">
			{{if .System}}
				<div class="company-kpis company-kpis-titled">
					<div class="company-kpi{{if ge .System.CPU 90.0}} full{{else if ge .System.CPU 70.0}} warn{{end}}"><h3 class="company-kpi-title">CPU</h3><b>{{printf "%.0f" .System.CPU}}<small>%</small></b><span>{{ctx.Locale.Tr "company.admin.system_load" (printf "%.2f" .System.Load1)}}</span></div>
					<div class="company-kpi{{if ge .System.MemPercent 90.0}} full{{else if ge .System.MemPercent 75.0}} warn{{end}}"><h3 class="company-kpi-title">{{ctx.Locale.Tr "company.admin.system_memory"}}</h3><b>{{printf "%.0f" .System.MemPercent}}<small>% · {{.System.MemUsedMB}} / {{.System.MemTotalMB}}MB</small></b><span>{{ctx.Locale.Tr "company.admin.system_apps_memory" .System.Apps .System.AppsMemMB}}</span></div>
					<div class="company-kpi{{if ge .System.DiskPercent 90.0}} full{{else if ge .System.DiskPercent 80.0}} warn{{end}}"><h3 class="company-kpi-title">{{ctx.Locale.Tr "company.admin.system_disk"}}</h3><b>{{printf "%.0f" .System.DiskPercent}}<small>% · {{.System.DiskUsedMB}} / {{.System.DiskTotalMB}}MB</small></b><span>{{ctx.Locale.Tr "company.admin.system_disk_note"}}</span></div>
				</div>
			{{end}}
			<div class="company-system-charts"
				data-points="{{.SystemPoints}}"
				data-i18n-empty="{{ctx.Locale.Tr "company.admin.system_empty"}}"
				data-i18n-cpu="CPU %"
				data-i18n-load="{{ctx.Locale.Tr "company.admin.system_load_series"}}"
				data-i18n-memory="{{ctx.Locale.Tr "company.admin.system_memory_series"}}"
				data-i18n-apps="{{ctx.Locale.Tr "company.admin.system_apps_series"}}"
				data-i18n-total="{{ctx.Locale.Tr "company.admin.system_total_series"}}"
				data-i18n-disk="{{ctx.Locale.Tr "company.admin.system_disk_series"}}">
				<div class="company-chart"><div class="company-chart-canvas"><canvas data-chart="cpu"></canvas></div></div>
				<div class="company-chart"><div class="company-chart-canvas"><canvas data-chart="memory"></canvas></div></div>
				<div class="company-chart"><div class="company-chart-canvas"><canvas data-chart="disk"></canvas></div></div>
			</div>
		</div>

		{{/* Which wall holds the limits: the kernel (a systemd scope) or the
		     watchdog alone. An operator sizing limits has to know which. */}}
		<p class="text-grey tw-text-12 tw-mt-2">{{if .CgroupOK}}{{svg "octicon-shield-check" 12}}{{else}}{{svg "octicon-shield" 12}}{{end}} {{ctx.Locale.Tr "company.admin.limits_enforced_by"}} {{.CgroupDetail}}</p>
		{{if .Fleet.CommitWarn}}
			<div class="ui {{if .Fleet.CommitOver}}negative{{else}}warning{{end}} message">
				{{ctx.Locale.Tr "company.admin.commit_warning" .Fleet.CommittedMB .Fleet.HostTotalMB .Fleet.CommitPct}}
			</div>
		{{end}}

		{{if .Attention}}
			{{/* Only rendered when there is something to act on. A section that
			     is always present stops being read — see docs/company/app-platform.md
			     on the dashboard layout. */}}
			<h4 class="ui top attached header company-deploys-attention-header">
				{{svg "octicon-alert" 16 "tw-mr-2"}}{{ctx.Locale.Tr "company.admin.attention" (len .Attention)}}
			</h4>
			<div class="ui attached table segment">
				<table class="ui very basic table">
					<tbody>
						{{range .Attention}}
							<tr>
								<td class="tw-w-1/3">
									{{if .Repo}}
										<a href="{{AppSubUrl}}/-/admin/company-deploys/{{PathEscape .State.Owner}}/{{PathEscape .State.Repo}}">{{.State.Owner}}/{{.State.Repo}}</a>
									{{else}}
										{{.State.Owner}}/{{.State.Repo}}
									{{end}}
								</td>
								<td>
									{{template "company/admin_deploys_status" .State}}
									{{if not .Repo}}
										<span class="text-red tw-ml-2">{{ctx.Locale.Tr "company.admin.repo_gone"}}</span>
										<form method="post" action="{{AppSubUrl}}/-/admin/company-deploys/{{PathEscape .State.Owner}}/{{PathEscape .State.Repo}}/purge" class="tw-inline-block tw-ml-2" data-company-confirm="{{ctx.Locale.Tr "company.admin.purge_confirm"}}">{{$.CsrfTokenHtml}}<button type="submit" class="ui tiny basic red button" title="{{ctx.Locale.Tr "company.admin.purge_hint"}}">{{ctx.Locale.Tr "company.admin.purge"}}</button></form>
									{{end}}
									{{if and (eq .State.Actual "running") (not .State.Sandboxed)}}<span class="text-red tw-ml-2">{{ctx.Locale.Tr "company.admin.unsandboxed"}}</span>{{end}}
									{{if .NetworkOpen}}<span class="text-red tw-ml-2">{{ctx.Locale.Tr "company.admin.network_open"}}</span>{{end}}
									{{if .State.Reason}}<span class="text-grey tw-ml-2">{{.State.Reason}}</span>{{end}}
								</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			</div>
		{{end}}

	</div>
<style>
.company-deploys-attention-header { background: var(--color-error-bg) !important; }
.company-deploy-state { display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; font-weight: 600; white-space: nowrap; }
.company-deploy-state.running { color: var(--color-success-text); }
.company-deploy-state.failed, .company-deploy-state.suspended { color: var(--color-error-text); }
.company-deploy-state.queued, .company-deploy-state.building, .company-deploy-state.activating { color: var(--color-warning-text); }
.company-flow { background: var(--color-secondary-bg) !important; }
.company-flow-scroll { overflow: auto; max-height: 640px; }
.company-flow-canvas { position: relative; margin: 0 auto; }
.company-flow-edges { position: absolute; inset: 0; pointer-events: none; }
.company-flow-edges path { fill: none; stroke: var(--color-text-light-3); stroke-width: 1.2; stroke-dasharray: 4 3; }
.company-flow-node { position: absolute; display: flex; flex-direction: column; justify-content: center; gap: 8px; padding: 0 10px; background: var(--color-box-body); border: 1px solid var(--color-secondary); border-radius: 4px; box-shadow: 0 1px 2px var(--color-shadow); color: var(--color-text); }
.company-flow-head { display: flex; align-items: center; gap: 10px; min-width: 0; }
.company-flow-spark { width: 56px; flex: 0 0 56px; }
.company-flow-spark .company-sparkline { width: 56px; height: 20px; }
.company-flow-metrics { display: flex; flex-direction: column; gap: 5px; border-top: 1px solid var(--color-secondary); padding-top: 7px; }
.company-flow-metric { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: baseline; column-gap: 8px; line-height: 1.2; }
.company-flow-metric small { font-size: 11px; color: var(--color-text-light-2); white-space: nowrap; }
.company-flow-metric b { font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }
.company-flow-gauge { grid-column: 1 / -1; display: block; height: 6px; margin-top: 3px; border-radius: 3px; background: var(--color-secondary); overflow: hidden; }
.company-flow-gauge > span { display: block; height: 100%; border-radius: 3px; background: var(--color-primary); }
.company-flow-node.app .company-flow-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 18px; row-gap: 6px; }
.company-flow-metric.hot b { color: var(--color-red); }
.company-flow-node.app .company-flow-spark { width: 90px; flex-basis: 90px; }
.company-flow-node.app .company-flow-spark .company-sparkline { width: 90px; }
.company-flow-metric.ok .company-flow-gauge > span { background: var(--color-green); }
.company-flow-metric.warn .company-flow-gauge > span { background: var(--color-yellow); }
.company-flow-metric.hot .company-flow-gauge > span { background: var(--color-red); }
a.company-flow-node[href]:hover { border-color: var(--color-primary); color: var(--color-text); }
.company-flow-node.bad { border-color: var(--color-red); }
.company-flow-icon { display: flex; flex-direction: column; align-items: center; width: 44px; flex: 0 0 44px; color: var(--color-text-light-2); }
.company-flow-icon small { font-size: 10px; line-height: 1.2; margin-top: 2px; white-space: nowrap; }
.company-flow-node.root .company-flow-icon { width: 48px; height: 48px; flex-basis: 48px; margin-left: -4px; justify-content: center; border-radius: 50%; background: var(--color-text-light-3); color: var(--color-box-body); border: 4px solid var(--color-box-body); box-shadow: 0 0 0 1px var(--color-secondary); }
.company-flow-body { display: flex; flex-direction: column; min-width: 0; flex: 1 1 auto; gap: 2px; }
.company-flow-name { font-size: 13px; }
.company-flow-marks { display: flex; gap: 3px; height: 14px; }
.company-flow-heart.ok, .company-flow-sync.ok { color: var(--color-green); }
.company-flow-heart.bad { color: var(--color-red); }
.company-flow-heart.busy, .company-flow-sync.busy { color: var(--color-yellow); }
.company-flow-heart.idle { color: var(--color-text-light-3); }
.company-flow-badges { position: absolute; right: 2px; bottom: -9px; display: flex; gap: 2px; }
.company-flow-badge { font-size: 10.5px; line-height: 16px; padding: 0 5px; border: 1px solid var(--color-secondary-dark-2); border-radius: 3px; background: var(--color-secondary-alpha-60); color: var(--color-text-light-1); white-space: nowrap; }
.company-flow-badge.warn { border-color: var(--color-red); color: var(--color-red); background: var(--color-error-bg); }
.company-flow-deploy { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--color-secondary); }
.company-flow-deploy-label { font-size: 12px; font-weight: 600; margin-right: 4px; }
.company-flow-chip { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--color-secondary); background: var(--color-box-body); font-size: 12px; color: var(--color-text); }
a.company-flow-chip { border-color: var(--color-primary); }
.company-flow-chip.muted { color: var(--color-text-light-2); }
.company-flow-chev { color: var(--color-text-light-3); }
.company-deploy-state.stopped { color: var(--color-text-light-2); }
</style>
{{template "admin/layout_footer" .}}

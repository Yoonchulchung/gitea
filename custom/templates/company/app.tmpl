{{template "base/head" .}}
<div role="main" class="page-content repository company-app-page">
	{{template "repo/header" .}}
	<div class="ui container">

		<h2 class="tw-flex tw-items-center tw-gap-3">
			앱 관리
			<span class="company-app-state {{.App.Actual}}">{{.StatusLabel}}</span>
		</h2>

		{{/* The cause panel is absent when nothing is wrong. A panel that always
		     says something is a panel nobody reads on the day it matters — see
		     company/appcause.go. */}}
		{{with .CauseSummary}}
			<div class="ui negative message">
				<div class="header">{{.Summary}}</div>
				{{/* When, not just what: "it broke four minutes ago" is what tells
				     someone whether their last change caused it. */}}
				{{if .At}}<div class="tw-text-13 tw-mt-1">{{DateUtils.TimeSince .At}} · {{DateUtils.AbsoluteShort .At}}</div>{{end}}
				{{range StringUtils.Split .Detail "\n"}}<div class="tw-mt-1 company-app-cause-line">{{.}}</div>{{end}}
				{{if .ActionLabel}}
					<a class="ui small primary button tw-mt-2"
						href="{{if eq .Action "deploy"}}{{$.DeployLink}}{{else}}{{$.AppLink}}{{end}}">{{.ActionLabel}}</a>
				{{end}}
			</div>
		{{end}}

		<div class="ui segment">
			<div class="tw-flex tw-items-center tw-gap-3 tw-flex-wrap">
				<a class="ui basic button" href="{{.AppURL}}" target="_blank" rel="noopener">{{svg "octicon-link-external" 14}} 앱 열어보기</a>
				<div class="tw-flex-1"></div>
				{{if .CanControl}}
					{{if eq .App.Actual "suspended"}}
						{{/* Deliberately no start button: an app an administrator stopped
						     stays stopped, or protecting the platform would mean nothing.
						     The reason is in the message above so they know who to ask. */}}
						<span class="text-grey">관리자가 정지시킨 앱은 부서에서 다시 시작할 수 없습니다.</span>
					{{else if eq .App.Actual "running"}}
						<form method="post" action="{{.AppLink}}/restart">{{.CsrfTokenHtml}}<button class="ui button">재시작</button></form>
						<form method="post" action="{{.AppLink}}/stop" data-company-confirm="앱을 중지하면 지금 사용 중인 사람들이 접속할 수 없게 됩니다. 계속할까요?">
							{{.CsrfTokenHtml}}<button class="ui button">중지</button>
						</form>
					{{else if .App.HasRelease}}
						<form method="post" action="{{.AppLink}}/start">{{.CsrfTokenHtml}}<button class="ui primary button">시작</button></form>
					{{else}}
						{{/* Nothing built yet — a start button here could only fail. */}}
						<a class="ui primary button" href="{{.DeployLink}}">배포 요청하기</a>
					{{end}}
					<form method="post" action="{{.AppLink}}/rollback" data-company-confirm="이전 버전으로 되돌립니다. 계속할까요?">
						{{.CsrfTokenHtml}}<button class="ui basic button">이전 버전으로</button>
					</form>
				{{end}}
			</div>
		</div>

		<h3>환경변수</h3>
		<div class="ui segment">
			<p class="text-grey tw-text-13">
				데이터베이스 주소나 API 키처럼 코드에 넣으면 안 되는 값을 여기에 저장합니다.
				값은 암호화되어 저장되고, 저장한 뒤에는 다시 보이지 않습니다.
				<strong>바꾼 값은 앱을 재시작해야 적용됩니다.</strong>
			</p>
			{{if .EnvError}}
				<div class="ui negative message">{{.EnvError}}</div>
			{{end}}
			{{if .EnvRestartRequired}}
				<div class="ui warning message">
					저장한 환경변수가 아직 적용되지 않았습니다.
					<form method="post" action="{{.AppLink}}/restart" class="tw-inline">{{.CsrfTokenHtml}}<button class="ui tiny primary button">지금 재시작</button></form>
				</div>
			{{end}}
			{{if .CanControl}}
				<form method="post" action="{{.AppLink}}/env" class="ui form">
					{{.CsrfTokenHtml}}
					<table class="ui very basic table">
						<thead><tr><th class="tw-w-1/3">이름</th><th>값</th><th class="tw-w-16">삭제</th></tr></thead>
						<tbody>
							{{range $i, $name := .EnvNames}}
								<tr>
									<td><input type="text" name="env_name_{{$i}}" value="{{$name}}" readonly></td>
									{{/* Blank means "leave it alone" — the same (unchanged)
									     convention as the AI settings screen, so nobody has to
									     retype a secret they cannot see. */}}
									<td><input type="password" name="env_value_{{$i}}" placeholder="(변경하지 않음)" autocomplete="new-password"></td>
									<td><input type="checkbox" name="env_delete_{{$i}}" value="1"></td>
								</tr>
							{{end}}
							<tr>
								<td><input type="text" name="env_name_new" placeholder="NEW_VARIABLE"></td>
								<td><input type="password" name="env_value_new" placeholder="값" autocomplete="new-password"></td>
								<td></td>
							</tr>
						</tbody>
					</table>
					<button class="ui primary button">저장</button>
				</form>
			{{end}}
			{{if .EnvHistory}}
				<h4 class="tw-mt-4">변경 이력</h4>
				{{/* Which keys changed and when, never the values. A secret's rotation
				     time is something an incident investigation regularly needs. */}}
				<table class="ui very basic table tw-text-13">
					<tbody>
						{{range .EnvHistory}}
							<tr>
								<td class="tw-w-1/4">{{DateUtils.TimeSince .At}}</td>
								<td class="tw-w-1/4">{{.Actor}}</td>
								<td>
									{{if .Set}}변경: {{StringUtils.Join .Set ", "}}{{end}}
									{{if .Unset}}삭제: {{StringUtils.Join .Unset ", "}}{{end}}
								</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			{{end}}
		</div>

		<h3>접근 권한</h3>
		<div class="ui segment">
			{{/* Each option says what happens, not what it is called: the person
			     choosing is deciding an outcome, not picking a keyword. */}}
			{{range .AccessOptions}}
				<div class="tw-py-2">
					<strong>{{if .Selected}}✓ {{end}}{{.Label}}</strong>
					<span class="text-grey tw-ml-2">— {{.Explain}}</span>
					{{if and .NeedsRequest (not .Selected)}}
						<a class="tw-ml-2 tw-text-13" href="{{$.DeployLink}}">더 넓히려면 승인이 필요합니다 →</a>
					{{end}}
				</div>
			{{end}}
		</div>

		<h3>최근 이력</h3>
		<div class="ui segment">
			<table class="ui very basic table tw-text-13">
				<tbody>
					{{range .App.History}}
						<tr>
							<td class="tw-w-1/4">{{DateUtils.TimeSince .At}}</td>
							<td class="tw-w-1/4">{{.Actor}}</td>
							<td>{{.Status}}{{if .Reason}} · {{.Reason}}{{end}}</td>
						</tr>
					{{else}}
						<tr><td class="text-grey">아직 이력이 없습니다.</td></tr>
					{{end}}
				</tbody>
			</table>
		</div>
	</div>
</div>
{{template "base/footer" .}}

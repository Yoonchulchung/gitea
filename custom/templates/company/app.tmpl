{{template "base/head" .}}
<div role="main" class="page-content repository company-app-page">
	{{template "repo/header" .}}
	<div class="ui container">

		<h2 class="tw-flex tw-items-center tw-gap-3">
			{{ctx.Locale.Tr "company.app.title"}}
			<span class="company-app-state {{.App.Actual}}">{{ctx.Locale.Tr .StatusLabel}}</span>
		</h2>

		{{/* The cause panel is absent when nothing is wrong. A panel that always
		     says something is a panel nobody reads on the day it matters — see
		     company/appcause.go. */}}
		{{with .CauseSummary}}
			<div class="ui negative message">
				<div class="header">{{ctx.Locale.Tr .Summary}}</div>
				{{/* When, not just what: "it broke four minutes ago" is what tells
				     someone whether their last change caused it. */}}
				{{if .At}}<div class="tw-text-13 tw-mt-1">{{DateUtils.TimeSince .At}} · {{DateUtils.AbsoluteShort .At}}</div>{{end}}
				{{if .Detail}}<div class="tw-mt-1 company-app-cause-line">{{ctx.Locale.Tr .Detail .DetailArg}}</div>{{end}}
				{{range StringUtils.Split .DetailText "\n"}}<div class="tw-mt-1 company-app-cause-line">{{.}}</div>{{end}}
				{{if .ActionLabel}}
					<a class="ui small primary button tw-mt-2"
						href="{{if eq .Action "deploy"}}{{$.DeployLink}}{{else}}{{$.AppLink}}{{end}}">{{ctx.Locale.Tr .ActionLabel}}</a>
				{{end}}
			</div>
		{{end}}

		{{if .MissingPackages}}
			{{/* The department cannot work this out from anywhere else: these
			     names are in no file they wrote, and the deploy that needed them
			     failed while the previous version kept serving — so the app looks
			     fine and their change is simply not live. */}}
			<div class="ui warning message">
				<div class="header">{{ctx.Locale.Tr "company.app.blocked_header"}}</div>
				<div class="tw-mt-1">
					{{ctx.Locale.Tr "company.app.blocked_packages"}}: <span class="tw-font-mono">{{StringUtils.Join .MissingPackages ", "}}</span>
				</div>
				<div class="tw-text-13 tw-mt-1">
					{{ctx.Locale.Tr "company.app.blocked_explain"}}
				</div>
				<a class="ui small primary button tw-mt-2" href="{{.DeployLink}}">{{ctx.Locale.Tr "company.app.request_approval"}}</a>
			</div>
		{{end}}
		<div class="ui segment">
			<div class="tw-flex tw-items-center tw-gap-3 tw-flex-wrap">
				<a class="ui basic button" href="{{.AppURL}}" target="_blank" rel="noopener">{{svg "octicon-link-external" 14}} {{ctx.Locale.Tr "company.app.open"}}</a>
				{{if .CanControl}}<a class="ui basic button" href="{{.AppLink}}/logs">{{svg "octicon-log" 14}} {{ctx.Locale.Tr "company.app.logs"}}</a>{{end}}
				{{if .CanControl}}<a class="ui basic button" href="{{.AppLink}}/history">{{svg "octicon-history" 14}} {{ctx.Locale.Tr "company.app.deploy_history"}}</a>{{end}}
				<div class="tw-flex-1"></div>
				{{if .CanControl}}
					{{if eq .App.Actual "suspended"}}
						{{/* Deliberately no start button: an app an administrator stopped
						     stays stopped, or protecting the platform would mean nothing.
						     The reason is in the message above so they know who to ask. */}}
						<span class="text-grey">{{ctx.Locale.Tr "company.app.suspended_note"}}</span>
					{{else if eq .App.Actual "running"}}
						<form method="post" action="{{.AppLink}}/restart">{{.CsrfTokenHtml}}<button class="ui button">{{ctx.Locale.Tr "company.app.restart"}}</button></form>
						<form method="post" action="{{.AppLink}}/stop" data-company-confirm="{{ctx.Locale.Tr "company.app.stop_confirm"}}">
							{{.CsrfTokenHtml}}<button class="ui button">{{ctx.Locale.Tr "company.app.stop"}}</button>
						</form>
					{{else if .App.HasRelease}}
						<form method="post" action="{{.AppLink}}/start">{{.CsrfTokenHtml}}<button class="ui primary button">{{ctx.Locale.Tr "company.app.start"}}</button></form>
					{{else}}
						{{/* Nothing built yet — a start button here could only fail. */}}
						<a class="ui primary button" href="{{.DeployLink}}">{{ctx.Locale.Tr "company.app.request_deploy"}}</a>
					{{end}}
					{{if .App.SHA}}
						<form method="post" action="{{.AppLink}}/redeploy">
							{{.CsrfTokenHtml}}<button class="ui basic button">{{ctx.Locale.Tr "company.app.redeploy"}}</button>
						</form>
					{{end}}
					{{/* Only offered when there is somewhere to go: a button that can
					     only fail is worse than no button. */}}
					{{if .Previous.Exists}}
						<form method="post" action="{{.AppLink}}/rollback"
							data-company-confirm="{{ctx.Locale.Tr "company.app.rollback_confirm" (Iif .Previous.SHA (ShortSha .Previous.SHA) (ctx.Locale.Tr "company.app.rollback_prior"))}}">
							{{.CsrfTokenHtml}}<button class="ui basic button">{{ctx.Locale.Tr "company.app.rollback"}}</button>
						</form>
					{{end}}
				{{end}}
			</div>
			{{/* Which version, and since when. Without it "이전 버전으로" is a
			     decision made blind — read from the release on disk, not from the
			     deploy that was intended, so it stays right after a rollback. */}}
			{{if .Running.Exists}}
				<div class="tw-mt-3 tw-pt-3 tw-border-t tw-text-13 tw-flex tw-gap-6 tw-flex-wrap">
					<span>
						<span class="text-grey">{{ctx.Locale.Tr "company.app.running_version"}}</span>
						<span class="tw-font-mono tw-ml-2">{{if .Running.SHA}}{{ShortSha .Running.SHA}}{{else}}{{ctx.Locale.Tr "company.app.version_unknown"}}{{end}}</span>
						<span class="text-grey tw-ml-2" title="{{DateUtils.AbsoluteShort .Running.BuiltAt}}">{{ctx.Locale.Tr "company.app.deployed_ago" (DateUtils.TimeSince .Running.BuiltAt)}}</span>
					</span>
					{{if .Previous.Exists}}
						<span>
							<span class="text-grey">{{ctx.Locale.Tr "company.app.rollback_target"}}</span>
							<span class="tw-font-mono tw-ml-2">{{if .Previous.SHA}}{{ShortSha .Previous.SHA}}{{else}}{{ctx.Locale.Tr "company.app.version_unknown"}}{{end}}</span>
							<span class="text-grey tw-ml-2" title="{{DateUtils.AbsoluteShort .Previous.BuiltAt}}">{{ctx.Locale.Tr "company.app.deployed_ago" (DateUtils.TimeSince .Previous.BuiltAt)}}</span>
						</span>
					{{else}}
						<span class="text-grey">{{ctx.Locale.Tr "company.app.no_rollback_target"}}</span>
					{{end}}
				</div>
			{{end}}
		</div>

		<h3>{{ctx.Locale.Tr "company.app.env_header"}}</h3>
		<div class="ui segment">
			<p class="text-grey tw-text-13">
				{{ctx.Locale.Tr "company.app.env_explain"}}
				<strong>{{ctx.Locale.Tr "company.app.env_restart_note"}}</strong>
			</p>
			{{if .EnvError}}
				<div class="ui negative message">{{.EnvError}}</div>
			{{end}}
			{{if .EnvRestartRequired}}
				<div class="ui warning message">
					{{ctx.Locale.Tr "company.app.env_pending"}}
					<form method="post" action="{{.AppLink}}/restart" class="tw-inline">{{.CsrfTokenHtml}}<button class="ui tiny primary button">{{ctx.Locale.Tr "company.app.restart_now"}}</button></form>
				</div>
			{{end}}
			{{if .CanControl}}
				{{/* One blank row and an add button, rather than a guess at how many
				     to render — see web_src/js/features/company-app-env.ts. */}}
				<form method="post" action="{{.AppLink}}/env" class="ui form company-env" data-company-env data-company-env-next="1">
					{{.CsrfTokenHtml}}
					<table class="ui very basic table company-env-table">
						<thead>
							<tr>
								<th class="company-env-select"><input type="checkbox" data-company-env-all aria-label="{{ctx.Locale.Tr "company.app.env_select_all"}}"></th>
								<th>{{ctx.Locale.Tr "company.app.env_name"}}</th>
								<th>{{ctx.Locale.Tr "company.app.env_value"}}</th>
							</tr>
						</thead>
						<tbody data-company-env-rows>
							{{range $i, $name := .EnvNames}}
								<tr>
									<td class="company-env-select"><input type="checkbox" name="env_delete_{{$i}}" value="1" data-company-env-delete aria-label="{{ctx.Locale.Tr "company.app.env_delete" $name}}"></td>
									<td><input type="text" name="env_name_{{$i}}" value="{{$name}}" readonly></td>
									{{/* Blank means "leave it alone" — the same (변경하지 않음)
									     convention as the AI settings screen, so nobody has to
									     retype a secret they cannot see. */}}
									<td><input type="password" name="env_value_{{$i}}" placeholder="{{ctx.Locale.Tr "company.app.env_unchanged"}}" autocomplete="new-password"></td>
								</tr>
							{{end}}
							{{/* An unsaved row is selectable too: it is the row most likely
							     to be wrong, and having to reload the page to drop a typo is
							     worse than the checkbox costing a column. It carries no name —
							     there is nothing on the server to delete — so the JS removes
							     it from the form instead. */}}
							<tr>
								<td class="company-env-select"><input type="checkbox" data-company-env-delete data-company-env-new aria-label="{{ctx.Locale.Tr "company.app.env_select_row"}}"></td>
								<td><input type="text" name="env_name_new0" placeholder="NEW_VARIABLE"></td>
								<td><input type="password" name="env_value_new0" placeholder="{{ctx.Locale.Tr "company.app.env_value"}}" autocomplete="new-password"></td>
							</tr>
						</tbody>
					</table>
					{{/* Cloned by the add button; data-name-prefix becomes the real
					     name so a new row cannot collide with one already on the page. */}}
					<template data-company-env-template>
						<tr>
							<td class="company-env-select"><input type="checkbox" data-company-env-delete data-company-env-new aria-label="{{ctx.Locale.Tr "company.app.env_select_row"}}"></td>
							<td><input type="text" data-name-prefix="env_name_" placeholder="NEW_VARIABLE"></td>
							<td><input type="password" data-name-prefix="env_value_" placeholder="{{ctx.Locale.Tr "company.app.env_value"}}" autocomplete="new-password"></td>
						</tr>
					</template>
					<div class="tw-flex tw-items-center tw-gap-2 tw-flex-wrap">
						<button class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
						<button class="ui basic button" data-company-env-add type="button">{{svg "octicon-plus" 14}} {{ctx.Locale.Tr "company.app.env_add"}}</button>
						<div class="tw-flex-1"></div>
						<button class="ui basic red button" data-company-env-remove>{{ctx.Locale.Tr "company.app.env_remove_selected"}}</button>
					</div>
				</form>
			{{end}}
			{{if .EnvHistory}}
				<h4 class="tw-mt-4">{{ctx.Locale.Tr "company.app.env_history"}}</h4>
				{{/* Which keys changed and when, never the values. A secret's rotation
				     time is something an incident investigation regularly needs. */}}
				<table class="ui very basic table tw-text-13">
					<tbody>
						{{range .EnvHistory}}
							<tr>
								<td class="tw-w-1/4">{{DateUtils.TimeSince .At}}</td>
								<td class="tw-w-1/4">{{.Actor}}</td>
								<td>
									{{if .Set}}{{ctx.Locale.Tr "company.app.env_changed"}}: {{StringUtils.Join .Set ", "}}{{end}}
									{{if .Unset}}{{ctx.Locale.Tr "company.app.env_removed"}}: {{StringUtils.Join .Unset ", "}}{{end}}
								</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			{{end}}
		</div>

		<h3>{{ctx.Locale.Tr "company.app.perm_header"}}</h3>
		<div class="ui segment">
			{{/* Denied and pending first in the reader's eye, because those are the
			     lines that answer "why doesn't my app work" — a panel listing only
			     what was approved leaves that question with no answer on screen.
			     Same rows as the repository sidebar (company/app_sidebar.go). */}}
			<table class="ui very basic table tw-text-13">
				<tbody>
					{{/* Label/Value/Reason are locale keys; ValueText/ReasonText are
					     data — a host, a package list — rendered verbatim (escaped). */}}
					{{range .PermissionRows}}
						<tr>
							<td class="tw-w-1/6">{{ctx.Locale.Tr .Label}}</td>
							<td class="tw-w-1/6">
								{{if eq .State "allowed"}}<span class="company-app-state running">{{ctx.Locale.Tr "company.app.perm_allowed"}}</span>
								{{else if eq .State "pending"}}<span class="company-app-state building">{{ctx.Locale.Tr "company.app.perm_pending"}}</span>
								{{else}}<span class="company-app-state failed">{{ctx.Locale.Tr "company.app.perm_denied"}}</span>{{end}}
							</td>
							<td>
								{{if .Value}}{{ctx.Locale.Tr .Value}}{{end}}{{.ValueText}}
								{{if or .Reason .ReasonText}}<span class="text-grey tw-text-12 tw-block">{{if .Reason}}{{ctx.Locale.Tr .Reason}}{{end}} {{.ReasonText}}</span>{{end}}
							</td>
						</tr>
					{{end}}
				</tbody>
			</table>

			{{if .PendingRequests}}
				{{/* "Nobody asked" and "somebody asked and an admin has not decided"
				     are different answers, and a screen that cannot tell them apart
				     sends the department to ask an administrator either way. */}}
				<div class="ui info message tw-mt-2">
					<div class="header">{{ctx.Locale.Tr "company.app.pending_header"}}</div>
					<table class="ui very basic table tw-text-13 tw-mt-1">
						<tbody>
							{{/* The label comes from Kind, not from the stored Label: the
							     record was written in whichever language the form rendered
							     in, and Kind is the stable enum underneath it. */}}
							{{range .PendingRequests}}
								<tr>
									<td class="tw-w-1/4">{{ctx.Locale.Tr (print "company.perm.kind." .Kind)}}</td>
									<td>{{.Detail}}{{if .Reason}}<span class="text-grey tw-text-12 tw-block">{{ctx.Locale.Tr "company.app.pending_reason"}}: {{.Reason}}</span>{{end}}</td>
								</tr>
							{{end}}
						</tbody>
					</table>
				</div>
			{{else}}
				<a class="ui basic button tw-mt-2" href="{{.DeployLink}}">{{ctx.Locale.Tr "company.app.request_permission"}}</a>
			{{end}}
		</div>

		<h3>{{ctx.Locale.Tr "company.app.access_header"}}</h3>
		<div class="ui segment">
			<p class="text-grey tw-text-13">
				{{ctx.Locale.Tr "company.app.access_explain"}}
			</p>
			{{/* Each option says what happens, not what it is called: the person
			     choosing is deciding an outcome, not picking a keyword. */}}
			<form method="post" action="{{.AppLink}}/access" class="ui form">
				{{.CsrfTokenHtml}}
				{{range .AccessOptions}}
					<div class="tw-py-2">
						<label class="tw-flex tw-items-baseline tw-gap-2">
							<input type="radio" name="access" value="{{.Value}}"
								{{if .Selected}}checked{{end}}
								{{if or .NeedsRequest (not $.CanControl)}}disabled{{end}}>
							<span>
								<strong>{{ctx.Locale.Tr .Label}}</strong>
								<span class="text-grey tw-ml-2">— {{ctx.Locale.Tr .Explain}}</span>
								{{if .NeedsRequest}}
									<a class="tw-ml-2 tw-text-13" href="{{$.DeployLink}}">{{ctx.Locale.Tr "company.app.access_needs_request"}}</a>
								{{end}}
							</span>
						</label>
					</div>
				{{end}}
				{{if .CanControl}}<button class="ui primary button tw-mt-2">{{ctx.Locale.Tr "company.app.apply"}}</button>{{end}}
			</form>
		</div>

		<h3>{{ctx.Locale.Tr "company.app.recent_history"}}</h3>
		<div class="ui segment">
			{{/* Words instead of state-machine vocabulary — see
			     custom/templates/company/history_table.tmpl. No raw codes here:
			     "rolled_back" tells a non-developer nothing. */}}
			{{template "company/history_table" dict "Rows" .HistoryRows}}

		</div>
	</div>
</div>
{{template "base/footer" .}}

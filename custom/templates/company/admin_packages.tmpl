{{template "admin/layout_head" (dict "pageClass" "admin company-packages")}}
	<div class="admin-setting-content">

		{{if .ConfigError}}
			{{/* Keeping the last good config is deliberate — a broken commit must
			     not change every app's policy at the moment nobody is looking at
			     the file — but it has to be visible, or the page would show
			     something other than what is in force. */}}
			<div class="ui attached negative message">
				<strong>{{ctx.Locale.Tr "company.admin.config_error"}}</strong> {{.ConfigError}}
			</div>
		{{end}}

		{{/* Oldest first, because it has waited longest. The policy page answers
		     "what may apps install"; this answers the natural next question,
		     "and what is waiting on me" — until now that lived only on each
		     org's own dashboard, where a request could sit unnoticed. */}}
		<h4 class="ui top attached header">{{ctx.Locale.Tr "company.policy.pending_header"}}</h4>
		<div class="ui attached segment">
			{{if .PendingApprovals}}
				<table class="ui very basic table tw-text-13">
					<tbody>
						{{range .PendingApprovals}}
							<tr>
								<td class="tw-w-1/6" title="{{DateUtils.AbsoluteShort .At}}">{{DateUtils.TimeSince .At}}</td>
								<td class="tw-w-1/5">{{.Owner}}/{{.Repo}}</td>
								<td>
									{{range $i, $r := .Requests}}{{if $i}}, {{end}}{{if ctx.Locale.HasKey $r.Label}}{{ctx.Locale.Tr $r.Label}}{{else}}{{$r.Label}}{{end}} ({{$r.Detail}}){{end}}
									{{range .Requests}}{{if .Reason}}<span class="text-grey tw-text-12 tw-block">{{ctx.Locale.Tr "company.policy.pending_reason"}}: {{.Reason}}</span>{{break}}{{end}}{{end}}
								</td>
								<td class="tw-w-32">
									<a class="ui tiny basic button" href="{{AppSubUrl}}/org/{{.Owner}}/dashboard/deploy-requests/{{.PRID}}">{{ctx.Locale.Tr "company.policy.pending_review"}}</a>
								</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			{{else}}
				<span class="text-grey">{{ctx.Locale.Tr "company.policy.pending_empty"}}</span>
			{{end}}
		</div>

		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "company.pkg.base_header"}}
			{{if .PolicyHistoryLink}}
				<div class="ui right">
					<a class="tw-text-13" href="{{.PolicyHistoryLink}}">{{ctx.Locale.Tr "company.pkg.history_link"}}</a>
				</div>
			{{end}}
		</h4>
		<div class="ui attached segment">
			<p class="text-grey tw-text-13 tw-mt-0">
				{{ctx.Locale.Tr "company.pkg.base_explain"}}
			</p>
			<form method="post" action="{{AppSubUrl}}/-/admin/company-packages/base" class="ui form">
				{{.CsrfTokenHtml}}
				<textarea name="packages" rows="6" class="tw-font-mono">{{.BasePackages}}</textarea>
				<div class="tw-flex tw-items-center tw-gap-3 tw-mt-2">
					<button class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
					<span class="text-grey tw-text-12">
				{{ctx.Locale.Tr "company.pkg.base_note"}}
				{{if .PythonOK}}<br>{{ctx.Locale.Tr "company.pkg.python_is"}} <code>{{.PythonDetail}}</code>{{else}}<br><strong>{{ctx.Locale.Tr "company.admin.no_python"}}</strong> {{.PythonDetail}}{{end}}
				<br><span class="tw-text-12">{{ctx.Locale.Tr "company.pkg.ai_note"}}</span>
			</div>
		</div>

		{{if .SharedAllow}}
			<h4 class="ui top attached header">{{ctx.Locale.Tr "company.pkg.shared_header"}}</h4>
			<div class="ui attached segment">
				<p class="text-grey tw-text-13 tw-mt-0">{{ctx.Locale.Tr "company.pkg.shared_explain"}}</p>
				<div>{{range .SharedAllow}}<span class="ui label tw-mr-1 tw-mb-1">{{.}}</span>{{end}}</div>
			</div>
		{{end}}

		<h4 class="ui top attached header">{{ctx.Locale.Tr "company.pkg.per_app_header" (len .AppPackages)}}</h4>
		<div class="ui attached table segment">
			<table class="ui very basic table">
				<thead><tr><th class="tw-w-1/4">{{ctx.Locale.Tr "company.pkg.col_app"}}</th><th>{{ctx.Locale.Tr "company.pkg.col_approved"}}</th></tr></thead>
				<tbody>
					{{range .AppPackages}}
						<tr>
							<td><a href="{{AppSubUrl}}/-/admin/company-deploys/{{PathEscape .Owner}}/{{PathEscape .Repo}}">{{.Owner}}/{{.Repo}}</a></td>
							<td>{{range .Packages}}<span class="ui label tw-mr-1 tw-mb-1">{{.}}</span>{{end}}</td>
						</tr>
					{{else}}
						{{/* The normal state early on, and worth saying plainly: nothing
						     is approved until a deploy request asks for it. */}}
						<tr><td colspan="2" class="text-grey">{{ctx.Locale.Tr "company.pkg.per_app_empty"}}</td></tr>
					{{end}}
				</tbody>
			</table>
		</div>

		<p class="text-grey tw-text-12 tw-mt-3">
			{{/* One source of truth, and the reason it is a file rather than a
			     table: the commit is the audit record. */}}
			{{ctx.Locale.Tr "company.pkg.audit_note"}}
		</p>
	</div>
{{template "admin/layout_footer" .}}

{{template "admin/layout_head" (dict "pageClass" "admin company-app-logs")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">
			<a href="{{AppSubUrl}}/-/admin/company-deploys">{{ctx.Locale.Tr "company.admin.deploys_nav"}}</a>
			<span class="text-grey tw-mx-2">/</span>
			<a href="{{.AdminAppLink}}">{{.App.Owner}}/{{.App.Repo}}</a>
			<span class="text-grey tw-mx-2">/</span>{{ctx.Locale.Tr "company.admin.logs_title"}}
		</h4>

		<div class="ui attached segment">
			{{/* `ui form` so the input gets the instance's own field styling — a
			     bare <input> outside one is the browser's, which is a different
			     height from the button beside it. Full-size button for the same
			     reason: a small one does not line up with a standard field. */}}
			<form method="get" class="ui form tw-flex tw-gap-2 tw-items-end tw-flex-wrap">
				<div class="field tw-flex-1 tw-mb-0"><input type="search" name="q" value="{{.Query}}" placeholder="{{ctx.Locale.Tr "company.logs.search_placeholder_admin"}}"></div>
				{{/* Regexp is opt-in: a user-supplied pattern can backtrack
				     catastrophically, and the search timeout bounds that but does
				     not remove it. See company/applogs.go. */}}
				<label class="tw-flex tw-items-center tw-gap-1 tw-text-13 tw-pb-2">
					<input type="checkbox" name="regexp" value="1" {{if .UseRegexp}}checked{{end}}> {{ctx.Locale.Tr "company.logs.regexp"}}
				</label>
				{{/* Named views rather than a pattern box: the routine traffic
				     is the same shape in every Python web server, so the
				     platform can recognise it and nobody has to write the
				     regexp for it. See company/logclass.go. */}}
				<div class="field tw-mb-0">
					<select name="view" class="ui selection dropdown">
						<option value="">{{ctx.Locale.Tr "company.logs.view_all"}}</option>
						<option value="errors" {{if eq .LogView "errors"}}selected{{end}}>{{ctx.Locale.Tr "company.logs.view_errors"}}{{if .ErrorCount}} ({{.ErrorCount}}){{end}}</option>
						<option value="app" {{if eq .LogView "app"}}selected{{end}}>{{ctx.Locale.Tr "company.logs.view_app"}}</option>
						<option value="requests" {{if eq .LogView "requests"}}selected{{end}}>{{ctx.Locale.Tr "company.logs.view_requests"}}</option>
					</select>
				</div>
				<button class="ui primary button">{{ctx.Locale.Tr "company.logs.search"}}</button>
			</form>
			{{/* Its own form: the search above is a GET that must stay
			     bookmarkable, and asking a model to read the log is a POST that
			     costs something and should not fire on a page reload. */}}
			{{if .ErrorCount}}
				<form method="post" action="{{.AdminAppLink}}/logs/diagnose" class="tw-mt-2">
					{{.CsrfTokenHtml}}
					<button class="ui basic button" {{if not .AIEnabled}}disabled{{end}}>
						{{svg "octicon-sparkle-fill" 14}} {{ctx.Locale.Tr "company.logs.diagnose"}}
					</button>
					<span class="text-grey tw-text-12 tw-ml-2">
						{{if .AIEnabled}}{{ctx.Locale.Tr "company.logs.diagnose_note"}}{{else}}{{ctx.Locale.Tr "company.logs.diagnose_off"}}{{end}}
					</span>
				</form>
			{{end}}
			{{if .SearchError}}
				<div class="ui negative message tw-mt-2">{{ctx.Locale.Tr "company.logs.bad_regexp"}} {{.SearchError}}</div>
			{{end}}
			{{if .Truncated}}
				<div class="ui warning message tw-mt-2">{{ctx.Locale.Tr "company.logs.truncated"}}</div>
			{{end}}
		</div>

		<div class="ui attached segment">
			{{/* Text nodes, never innerHTML: an app prints whatever it wants to
			     stdout, and "<script>" in a log line must not run in an admin's
			     session. Go templates escape this by default — do not add a
			     `safeHTML` here. */}}
			{{/* Build output comes first, then the running app's. The two have no
			     shared clock, so they are shown as blocks rather than interleaved
			     — which would imply an ordering that is not there. */}}
			<pre class="company-log">{{range .Lines}}{{if .At}}<span class="company-log-time" title="{{DateUtils.AbsoluteShort .At}}">{{DateUtils.AbsoluteShort .At}}</span> {{end}}{{if .Build}}<span class="company-log-build">{{.Text}}</span>{{else}}{{.Text}}{{end}}
{{else}}{{ctx.Locale.Tr "company.logs.empty_admin"}}{{end}}</pre>
			<p class="text-grey tw-text-12 tw-mt-2 tw-mb-0">
				{{ctx.Locale.Tr "company.logs.legend" (HTMLFormat `<span class="%s">%s</span>` "company-log-build" (ctx.Locale.Tr "company.logs.legend_colour"))}}
			</p>
		</div>
	</div>
{{template "admin/layout_footer" .}}

{{template "admin/layout_head" (dict "pageClass" "admin company-network")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">
			<a href="{{AppSubUrl}}/-/admin/company-deploys">{{ctx.Locale.Tr "company.admin.deploys_nav"}}</a>
			<span class="text-grey tw-mx-2">/</span>{{ctx.Locale.Tr "company.adminnetwork.title"}}
		</h4>
		<div class="ui attached segment">
			{{/* Policy and enforcement are different facts. On a host without a
			     sandbox the rules below are still the rules and nothing is
			     applying them, and a review page that hid that would be worse
			     than no page. */}}
			{{if not .Enforced}}
				<div class="ui warning message">{{ctx.Locale.Tr "company.adminnetwork.not_enforced" .EnforcedDetail}}</div>
			{{end}}
			<div class="company-kpis">
				<div class="company-kpi"><b>{{.Total}}</b><span>{{ctx.Locale.Tr "company.adminnetwork.kpi_apps"}}</span></div>
				<div class="company-kpi{{if .Exceptions}} bad{{end}}">
					<b>{{.Exceptions}}</b><span>{{ctx.Locale.Tr "company.adminnetwork.kpi_exceptions"}}</span>
				</div>
			</div>
			<p class="text-grey tw-text-13 tw-mt-2">{{ctx.Locale.Tr "company.adminnetwork.explain"}}</p>
		</div>

		{{/* Above every other rule: a destination here is refused for every
		     app in every mode, so the platform is never a way round the
		     company's own edge. See company/blocklist.go. */}}
		<h4 class="ui attached header company-perm-review-header">{{svg "octicon-blocked" 16 "tw-mr-2"}}{{ctx.Locale.Tr "company.adminnetwork.blocked_header" (len .Blocked)}}</h4>
		<div class="ui attached segment">
			<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminnetwork.blocked_explain"}}</p>
			<div class="tw-mb-3">
				{{range .Blocked}}
					<form method="post" action="{{$.NetworkLink}}/unblock" class="tw-inline-block tw-mr-1 tw-mb-1" data-company-confirm="{{ctx.Locale.Tr "company.adminnetwork.unblock_confirm" .}}">
						{{$.CsrfTokenHtml}}
						<input type="hidden" name="entry" value="{{.}}">
						<span class="ui red basic label tw-font-mono">{{.}} <button type="submit" class="company-label-remove" data-tooltip-content="{{ctx.Locale.Tr "company.adminnetwork.unblock"}}" aria-label="{{ctx.Locale.Tr "company.adminnetwork.unblock"}}">{{svg "octicon-x" 12}}</button></span>
					</form>
				{{else}}
					<span class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminnetwork.blocked_none"}}</span>
				{{end}}
			</div>
			<form method="post" action="{{.NetworkLink}}/block" class="ui form tw-flex tw-gap-2 tw-items-center tw-flex-wrap">
				{{.CsrfTokenHtml}}
				<input type="text" name="entry" class="tw-w-80" placeholder="{{ctx.Locale.Tr "company.adminnetwork.block_placeholder"}}" autocomplete="off" required>
				<button class="ui red button">{{ctx.Locale.Tr "company.adminnetwork.block"}}</button>
			</form>
		</div>

		<h4 class="ui attached header">{{ctx.Locale.Tr "company.adminnetwork.inbound_header"}}</h4>
		<div class="ui attached segment">
			<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.adminnetwork.inbound_explain"}}</p>
			<div class="company-kpis">
				<div class="company-kpi{{if .Inbound.OpenAllowed}} bad{{end}}">
					<b>{{if .Inbound.OpenAllowed}}{{ctx.Locale.Tr "company.adminnetwork.yes"}}{{else}}{{ctx.Locale.Tr "company.adminnetwork.no"}}{{end}}</b>
					<span>{{ctx.Locale.Tr "company.adminnetwork.kpi_open_allowed"}}</span>
				</div>
				<div class="company-kpi"><b>{{.Inbound.MaxAccess}}</b><span>{{ctx.Locale.Tr "company.adminnetwork.kpi_max_access"}}</span></div>
				<div class="company-kpi{{if not .Inbound.ListenerWatch}} bad{{end}}">
					<b>{{if .Inbound.ListenerWatch}}{{ctx.Locale.Tr "company.adminnetwork.yes"}}{{else}}{{ctx.Locale.Tr "company.adminnetwork.no"}}{{end}}</b>
					<span>{{ctx.Locale.Tr "company.adminnetwork.kpi_listener_watch"}}</span>
				</div>
				<div class="company-kpi{{if .Banned}} bad{{end}}"><b>{{len .Banned}}</b><span>{{ctx.Locale.Tr "company.adminnetwork.kpi_banned"}}</span></div>
			</div>
			{{/* The ceilings are app.ini settings, not buttons: they are the
			     operator's policy, and a page where an administrator could
			     loosen "no app may be a server" with one click would be the
			     thing the policy exists to prevent. */}}
			<p class="text-grey tw-text-13 tw-mt-2">{{ctx.Locale.Tr "company.adminnetwork.inbound_where"}}</p>
			{{if .Banned}}
				<table class="ui very basic table tw-text-13 tw-mt-2">
					<thead><tr><th>{{ctx.Locale.Tr "company.adminnetwork.col_visitor"}}</th><th>{{ctx.Locale.Tr "company.adminnetwork.col_until"}}</th><th></th></tr></thead>
					<tbody>
						{{range .Banned}}
							<tr>
								<td class="tw-font-mono">{{.Key}}</td>
								<td title="{{DateUtils.AbsoluteShort .Until}}">{{DateUtils.TimeSince .Until}}</td>
								<td class="tw-text-right">
									<form method="post" action="{{$.NetworkLink}}/unban" class="tw-inline">
										{{$.CsrfTokenHtml}}<input type="hidden" name="key" value="{{.Key}}">
										<button class="ui tiny button">{{ctx.Locale.Tr "company.adminnetwork.unban"}}</button>
									</form>
								</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			{{end}}
		</div>

		<div class="ui attached segment">
			{{if .Rows}}
				<table class="ui very basic table tw-text-13">
					<thead>
						<tr>
							<th>{{ctx.Locale.Tr "company.admin.col_app"}}</th>
							<th class="tw-w-1/6">{{ctx.Locale.Tr "company.adminnetwork.col_mode"}}</th>
							<th>{{ctx.Locale.Tr "company.adminnetwork.col_allow"}}</th>
							<th class="tw-w-1/6">{{ctx.Locale.Tr "company.adminnetwork.col_exposure"}}</th>
							<th class="tw-w-1/6">{{ctx.Locale.Tr "company.adminnetwork.col_traffic"}}</th>
						</tr>
					</thead>
					<tbody>
						{{range .Rows}}
							<tr>
								<td><a href="{{$.AppLinkPrefix}}{{.Owner}}/{{.Repo}}">{{.Owner}}/{{.Repo}}</a></td>
								<td>
									{{if eq .Mode "open"}}
										<span class="company-data-full">{{ctx.Locale.Tr "company.adminnetwork.mode_open"}}</span>
									{{else if eq .Mode "broker"}}
										<span class="company-data-warn">{{ctx.Locale.Tr "company.adminnetwork.mode_broker"}}</span>
									{{else}}
										<span class="text-grey">{{ctx.Locale.Tr "company.adminnetwork.mode_none"}}</span>
									{{end}}
								</td>
								<td>
									{{if .Allow}}
										{{range .Allow}}
											<div class="tw-font-mono">{{.Host}}{{if .Methods}} <span class="text-grey">({{StringUtils.Join .Methods ", "}})</span>{{end}}</div>
										{{end}}
									{{else if eq .Mode "open"}}
										<span class="text-grey">{{ctx.Locale.Tr "company.adminnetwork.allow_anything"}}</span>
									{{else}}
										<span class="text-grey">—</span>
									{{end}}
								</td>
								<td>
									{{.Access}}
									{{if ne .Access .Written}}<span class="text-grey tw-ml-1" title="{{ctx.Locale.Tr "company.adminnetwork.clamped_from" .Written}}">({{ctx.Locale.Tr "company.adminnetwork.clamped"}})</span>{{end}}
								</td>
								<td>
									<a href="{{$.NetworkLink}}/{{.Owner}}/{{.Repo}}">{{.Recent}} {{ctx.Locale.Tr "company.adminnetwork.requests"}}</a>
									{{if .Blocked}}<span class="company-data-full tw-ml-1">{{.Blocked}} {{ctx.Locale.Tr "company.adminnetwork.blocked"}}</span>{{end}}
								</td>
							</tr>
						{{end}}
					</tbody>
				</table>
			{{else}}
				<p class="text-grey">{{ctx.Locale.Tr "company.adminnetwork.no_apps"}}</p>
			{{end}}
		</div>
	</div>
{{template "admin/layout_footer" .}}

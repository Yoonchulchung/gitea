{{/* One app's state as a coloured word. Takes an *AppState as its dot.
     Shared by the list and the "조치 필요" section so the same state never
     reads differently in two places on one screen. */}}
<span class="company-deploy-state {{.Actual}}">
	{{if eq .Actual "running"}}
		{{svg "octicon-check-circle" 13}}{{ctx.Locale.Tr "company.status.running"}}
	{{else if eq .Actual "failed"}}
		{{svg "octicon-x-circle" 13}}{{ctx.Locale.Tr "company.status.failed"}}
	{{else if eq .Actual "suspended"}}
		{{svg "octicon-blocked" 13}}{{ctx.Locale.Tr "company.status.suspended"}}
	{{else if eq .Actual "queued"}}
		{{svg "octicon-clock" 13}}{{ctx.Locale.Tr "company.status.queued"}}
	{{else if eq .Actual "building"}}
		{{svg "octicon-sync" 13}}{{ctx.Locale.Tr "company.status.building"}}
	{{else if eq .Actual "activating"}}
		{{svg "octicon-sync" 13}}{{ctx.Locale.Tr "company.status.activating"}}
	{{else}}
		{{svg "octicon-circle-slash" 13}}{{ctx.Locale.Tr "company.status.stopped"}}
	{{end}}
</span>

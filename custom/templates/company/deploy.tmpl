{{template "base/head" .}}
<div role="main" class="page-content company-deploy-page">
	<div class="ui container company-deploy-wrap">
		<a href="{{.Repo.Link}}" class="muted company-deploy-back">{{svg "octicon-chevron-left" 15}}{{.Repo.Name}}</a>

		<div class="company-deploy-title">
			<h1>{{ctx.Locale.Tr "company.deploy.title"}}</h1>
			{{if .DeployRequestStatus}}
				<span class="company-deploy-status-badge {{.DeployRequestStatus.Status}}">
					{{svg .DeployStatusIcon 13}}{{ctx.Locale.Tr (printf "company.deploy_status.%s" .DeployRequestStatus.Status)}} - {{DateUtils.AbsoluteShort .DeployRequestStatus.Date}}
				</span>
			{{end}}
		</div>
		{{if .DeployRequester}}
			<div class="company-deploy-subline">
				{{ctx.AvatarUtils.Avatar .DeployRequester 20}}
				{{ctx.Locale.Tr "company.deploy.requested_by" .DeployRequester.Name}}
			</div>
		{{end}}

		{{if .RejectionComments}}
			{{/* Whatever the admin wrote when rejecting — typed alongside
			     closing the PR natively, same source as DeployRequestFiles'
			     own comment list (company/deployrequestfiles.go). Without
			     this the requester only ever saw "Rejected" with no way to
			     find out why. No separate "This deploy was rejected"
			     heading here — the badge above already says that; this box
			     only exists to show the one thing the badge can't: why. */}}
			<div class="company-deploy-statusbox {{.DeployRequestStatus.Status}}">
				{{range .RejectionComments}}
					<div class="company-deploy-reason">
						<div class="company-deploy-reason-head">{{ctx.AvatarUtils.Avatar .Poster 20}}<strong>{{.Poster.Name}}</strong><span class="muted">{{DateUtils.TimeSince .CreatedUnix}}</span></div>
						<div class="company-deploy-reason-quote">{{.Content}}</div>
					</div>
				{{end}}
			</div>
		{{end}}

		{{/* Outside the deploy form on purpose: a <form> inside a <form> is
		     invalid, so the browser drops the inner one and its required field
		     becomes part of the outer form — which then refuses to submit with
		     no visible reason. */}}
		{{with .OpenRequest}}
			{{/* An unanswered request looked like no request, and the only way
			     to find out was to submit another — which supersedes the first
			     and starts the wait over. */}}
			<div class="ui warning message">
				<div class="header">이미 제출한 요청이 관리자 승인을 기다리고 있습니다</div>
				<div class="tw-mt-1">{{.Issue.Title}}</div>
				{{with $.OpenRequestItems}}
					<div class="tw-text-13 tw-mt-1">
						요청한 항목:
						{{range $i, $item := .}}{{if $i}}, {{end}}{{$item.Label}} ({{$item.Detail}}){{end}}
					</div>
				{{end}}
				<div class="tw-text-13 tw-mt-2">
					새 요청을 제출하면 이 요청은 자동으로 취소되고 처음부터 다시 기다리게 됩니다.
					더 이상 필요 없다면 아래에서 취소해 주세요.
				</div>
				<form method="post" action="{{AppSubUrl}}/company/deploy-request/{{.ID}}/cancel" class="tw-mt-2 tw-flex tw-gap-2 tw-flex-wrap tw-items-center"
					data-company-confirm="이 배포 요청을 취소합니다. 계속할까요?">
					{{$.CsrfTokenHtml}}
					<input type="hidden" name="org" value="{{$.Repository.OwnerName}}">
					{{/* Required by the handler, and worth requiring: the admin
					     watching this request disappear should be told why. */}}
					<input type="text" name="reason" class="tw-flex-1" required autocomplete="off"
						placeholder="취소 사유 (예: 코드를 더 고쳐야 해서 다시 요청하겠습니다)">
					<button class="ui basic red button">요청 취소</button>
				</form>
			</div>
		{{end}}

		<form class="ui form company-deploy-form" id="deploy-form" method="post">
			<div class="company-deploy-section-lbl">{{ctx.Locale.Tr .DeployFormHeadingKey}}</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "company.deploy.title_field_label"}}</label>
				{{/* Same reason as perm_reason below: a title recalled from a previous
				     request describes that one, not this one. */}}
				<input type="text" name="title" value="{{.SubmittedTitle}}" placeholder="{{ctx.Locale.Tr "company.deploy.title_field_placeholder"}}" required autocomplete="off">
			</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "company.deploy.message_label"}}</label>
				<textarea name="message" rows="3" placeholder="{{ctx.Locale.Tr "company.deploy.message_placeholder"}}">{{.SubmittedMessage}}</textarea>
			</div>
			{{/* Permission items, detected from the files being deployed rather
			     than asked for on a blank form — a non-developer handed an empty
			     permissions form fills in either nothing or something unusable.
			     The person supplies only the reason, which is required: an
			     operator who is not a developer cannot judge "allow outbound
			     access to api.foo.com?" on its own. See company/permissions.go. */}}

			{{with .Preflight}}
				{{/* Shown only after a submission was stopped: these are the checks
				     the build performs, run before anything was written, so the
				     department finds out now rather than after an admin approved
				     something that then did not work (company/preflight.go). */}}
				<div class="ui negative message">
					<div class="header">{{.Summary}}</div>
					<div class="company-preflight-list">
						{{range .Checks}}
							<div class="company-preflight-row">
								<span class="company-preflight-{{.Status}}">
									{{if eq .Status "ok"}}확인됨{{else if eq .Status "warn"}}확인 필요{{else}}고쳐야 함{{end}}
								</span>
								<strong>{{if ctx.Locale.HasKey .Label}}{{ctx.Locale.Tr .Label}}{{else}}{{.Label}}{{end}}</strong>
								{{/* pip's own words and a package name the department wrote —
								     escaped by default, never innerHTML. */}}
								<div class="company-preflight-detail">{{.Detail}}</div>
							</div>
						{{end}}
					</div>
				</div>
			{{end}}

			<div class="company-perm-request">
				{{with .PermissionRequests}}
					<div class="company-deploy-section-lbl">이번 배포에 필요한 승인</div>
					{{range .}}
						<label class="company-perm-request-item">
							<input type="checkbox" name="perm_{{.Kind}}_{{.Value}}" value="1" checked>
							<span>
								<strong>{{if ctx.Locale.HasKey .Label}}{{ctx.Locale.Tr .Label}}{{else}}{{.Label}}{{end}}</strong> — {{.Detail}}
								{{if .Evidence}}<span class="text-grey tw-text-12 tw-block">{{if ctx.Locale.HasKey .Evidence}}{{ctx.Locale.Tr .Evidence}}{{else}}{{.Evidence}}{{end}}</span>{{end}}
							</span>
						</label>
					{{end}}
				{{end}}

				{{/* Nothing in an app says "this needs to reach erp.internal" or
				     "this needs to hand people a file". Those are intentions, and
				     without somewhere to say them a department that needs one had
				     no route to a request at all. */}}
				<div class="company-deploy-section-lbl tw-mt-3">추가로 요청할 것이 있나요?</div>
				{{if not .DownloadAllowed}}
					<label class="company-perm-request-item">
						<input type="checkbox" name="perm_want_download" value="1">
						<span>
							<strong>파일 다운로드 허용</strong>
							<span class="text-grey tw-text-12 tw-block">
								엑셀·PDF 처럼 파일을 내려받게 해야 한다면 선택하세요. 지금은 화면에 보여주는 것만 됩니다.
							</span>
						</span>
					</label>
				{{end}}
				<div class="field tw-mt-2">
					<label>외부 통신 <span class="text-grey tw-text-12">(다른 시스템의 자료를 가져와야 할 때만 적으세요)</span></label>
					<div class="tw-flex tw-gap-2 tw-flex-wrap">
						<input type="text" name="perm_want_host" class="tw-flex-1"
							placeholder="주소 붙여넣기 (예: https://erp.internal.company.com/api)" autocomplete="off">
						{{/* Fomantic dropdown, as on /user/settings/ai — a bare <select>
						     is the browser's own widget and looks like nothing else here. */}}
						<div class="ui selection dropdown">
							<input type="hidden" name="perm_want_methods" value="GET">
							<div class="text"></div> {{svg "octicon-triangle-down" 14 "dropdown icon"}}
							<div class="menu">
								<div class="item" data-value="GET">읽기만 (GET)</div>
								<div class="item" data-value="GET,POST">읽기와 보내기 (GET, POST)</div>
							</div>
						</div>
					</div>
					<span class="text-grey tw-text-12">
						{{if .OutboundAllowed}}현재 허용: {{StringUtils.Join .OutboundAllowed ", "}}{{else}}지금은 외부 통신이 모두 차단되어 있습니다.{{end}}
					</span>
				</div>

				<div class="field tw-mt-2">
					<label>사유 <span class="text-grey tw-text-12">(관리자가 판단할 수 있도록 왜 필요한지 적어 주세요)</span></label>
						{{/* autocomplete off: the browser offers what was typed into this field on
						     a previous request, and a reason carried over from a different
						     approval is worse than no reason — the admin reads it as though it
						     were written about this one. */}}
					{{/* Not `required`: a deploy with no permission items needs no
					     reason, and a browser refusing to submit a form over a field
					     the person cannot see is indistinguishable from a broken
					     button. The reason is required where it matters — an item
					     without one is what the admin sees. */}}
					<input type="text" name="perm_reason" value="{{$.SubmittedReason}}" placeholder="예: 엑셀 보고서를 만들기 위해 openpyxl 이 필요합니다" autocomplete="off">
				</div>
			</div>
			{{/* The label is wrapped so the loading state can hide it: .is-loading
			     dims child *elements*, and a bare text node would stay visible
			     behind the spinner. */}}
			<button type="submit" id="submit-button" class="ui primary button">
				<span>{{ctx.Locale.Tr "company.deploy.submit_button"}}</span>
			</button>
		</form>

		<div class="company-deploy-files" data-global-init="initCompanyDeployForm"
			data-i18n-collapse-all="{{ctx.Locale.Tr "company.deploy.collapse_all"}}"
			data-i18n-expand-all="{{ctx.Locale.Tr "company.deploy.expand_all"}}"
			data-i18n-none-matching-search="{{ctx.Locale.Tr "company.deploy.none_matching_search" "%s"}}"
			data-i18n-none-matching-filter="{{ctx.Locale.Tr "company.deploy.none_matching_filter"}}"
		>
			<div class="company-deploy-files-head">
				<span class="company-deploy-files-heading">{{svg "octicon-file-diff" 16}}{{ctx.Locale.Tr "company.deploy.files_heading" (len .DeployFiles)}}</span>
				{{if .DeployFiles}}
					<span class="company-deploy-diffstat" title="{{ctx.Locale.Tr "company.deploy.diffstat_label" .DeployDiffAdds .DeployDiffDels}}">
						<span class="company-deploy-add">+{{.DeployDiffAdds}}</span><span class="company-deploy-del">&minus;{{.DeployDiffDels}}</span>
					</span>
				{{end}}
			</div>

			{{if .DeployFiles}}
				<div class="company-deploy-toolbar">
					<div class="company-deploy-search">
						{{svg "octicon-search" 15}}
						<input class="company-deploy-filter-input" placeholder="{{ctx.Locale.Tr "company.deploy.filter_placeholder"}}" autocomplete="off">
					</div>
					<div class="company-deploy-filters">
						<button type="button" class="company-deploy-flt on" data-type="all">{{ctx.Locale.Tr "company.deploy.filter_all"}} <span class="company-deploy-count">{{len .DeployFiles}}</span></button>
						<button type="button" class="company-deploy-flt" data-type="A">{{ctx.Locale.Tr "company.deploy.filter_added"}} <span class="company-deploy-count">{{.DeployFilesAdded}}</span></button>
						<button type="button" class="company-deploy-flt" data-type="M">{{ctx.Locale.Tr "company.deploy.filter_modified"}} <span class="company-deploy-count">{{.DeployFilesModified}}</span></button>
						<button type="button" class="company-deploy-flt" data-type="D">{{ctx.Locale.Tr "company.deploy.filter_removed"}} <span class="company-deploy-count">{{.DeployFilesRemoved}}</span></button>
					</div>
					<button type="button" class="company-deploy-collapse-all">{{ctx.Locale.Tr "company.deploy.expand_all"}}</button>
				</div>

				{{range $i, $f := .DeployFiles}}
					<div class="company-deploy-file" data-type="{{$f.TypeClass}}" data-path="{{$f.Path}}"{{if ge $i $.DeployFilesVisibleLimit}} data-more="1"{{end}}>
						<div class="company-deploy-fhead">
							{{svg "octicon-chevron-right" 13 "company-deploy-chev"}}
							{{if eq $f.TypeClass "A"}}
								{{svg "octicon-diff-added" 16 "tw-text-green"}}
							{{else if eq $f.TypeClass "D"}}
								{{svg "octicon-diff-removed" 16 "tw-text-red"}}
							{{else}}
								{{svg "octicon-diff-modified" 16 "tw-text-yellow"}}
							{{end}}
							<span class="company-deploy-fname">{{$f.Path}}</span>
							<span class="company-deploy-fmeta">
								{{if not (or $f.IsBinary $f.TooLarge)}}
									<span class="company-deploy-fd"><span class="company-deploy-add">+{{$f.Adds}}</span> <span class="company-deploy-del">&minus;{{$f.Dels}}</span></span>
								{{end}}
								{{if not $f.IsRemoved}}
									<a class="company-deploy-ext" href="{{$.Repo.Link}}/src/branch/{{PathEscapeSegments $.Repo.DefaultBranch}}/{{PathEscapeSegments $f.Path}}" target="_blank" rel="noopener" title="{{ctx.Locale.Tr "company.deploy.view_file"}}">
										{{svg "octicon-link-external" 13}}
									</a>
								{{end}}
							</span>
						</div>
						<div class="company-deploy-fbody">
							{{if $f.IsBinary}}
								<div class="tw-p-3 text-grey">{{ctx.Locale.Tr "repo.diff.bin"}}</div>
							{{else if $f.TooLarge}}
								<div class="tw-p-3 text-grey">{{ctx.Locale.Tr "repo.diff.file_suppressed"}}</div>
							{{else if or $f.IsNew $f.IsRemoved}}
								{{/* Single full-width column — the other side is always entirely
								     blank for a brand-new or fully-removed file (every row is
								     "add" or every row is "del"), so the split view's two-column
								     layout would waste half the width on nothing and cramp the
								     side that actually has content. */}}
								<table class="company-deploy-diff-table company-deploy-diff-table-single">
									<colgroup>
										<col class="company-deploy-diff-ln-col"><col>
									</colgroup>
									<tbody>
										{{range $f.Rows}}
											{{if $f.IsNew}}
												<tr>
													<td class="company-deploy-diff-ln new add">{{.NewNum}}</td>
													<td class="company-deploy-diff-code new add"><code class="code-inner">{{.NewContent}}</code></td>
												</tr>
											{{else}}
												<tr>
													<td class="company-deploy-diff-ln old del">{{.OldNum}}</td>
													<td class="company-deploy-diff-code old del"><code class="code-inner">{{.OldContent}}</code></td>
												</tr>
											{{end}}
										{{end}}
									</tbody>
								</table>
							{{else}}
								{{/* Split (side-by-side) view — real old/new line numbers on each
								     side, computed in company/deploy.go's diffPreviewSplitRows,
								     so "before" and "after" are never ambiguous the way a single
								     +/- column with no numbering was. Long unchanged stretches
								     (deployDiffSegment.Collapsed) start hidden behind a "Show N
								     more lines" toggle — see company-deploy-form.ts — the same
								     "changed parts first, expand for the rest" convention `git
								     diff` itself uses. */}}
								<table class="company-deploy-diff-table">
									<colgroup>
										<col class="company-deploy-diff-ln-col"><col><col class="company-deploy-diff-ln-col"><col>
									</colgroup>
									{{range $f.Segments}}
										{{$seg := .}}
										<tbody{{if $seg.Collapsed}} class="company-deploy-diff-collapsed"{{end}}>
											{{if $seg.Collapsed}}
												<tr class="company-deploy-diff-expand-row">
													<td colspan="4">
														<button type="button" class="company-deploy-diff-expand-btn">{{svg "octicon-unfold" 14}}{{ctx.Locale.Tr "company.deploy.expand_lines" (len $seg.Rows)}}</button>
													</td>
												</tr>
											{{end}}
											{{range $seg.Rows}}
												<tr{{if $seg.Collapsed}} class="tw-hidden"{{end}}>
													<td class="company-deploy-diff-ln old{{if not .OldNum}} blank{{else if eq .OldType "del"}} del{{end}}">{{if .OldNum}}{{.OldNum}}{{end}}</td>
													<td class="company-deploy-diff-code old{{if not .OldNum}} blank{{else if eq .OldType "del"}} del{{end}}"><code class="code-inner">{{.OldContent}}</code></td>
													<td class="company-deploy-diff-ln new{{if not .NewNum}} blank{{else if eq .NewType "add"}} add{{end}}">{{if .NewNum}}{{.NewNum}}{{end}}</td>
													<td class="company-deploy-diff-code new{{if not .NewNum}} blank{{else if eq .NewType "add"}} add{{end}}"><code class="code-inner">{{.NewContent}}</code></td>
												</tr>
											{{end}}
										</tbody>
									{{end}}
								</table>
							{{end}}
						</div>
					</div>
				{{end}}

				<div class="company-deploy-none tw-hidden"></div>

				{{if .DeployFilesRemaining}}
					<div class="company-deploy-loadmore">
						<button type="button" class="company-deploy-loadmore-btn">{{ctx.Locale.Tr "company.deploy.load_remaining" .DeployFilesRemaining}}</button>
					</div>
				{{end}}
			{{else}}
				<div class="text-grey tw-text-13">{{ctx.Locale.Tr "company.deploy.no_files"}}</div>
			{{end}}
		</div>
	</div>
</div>
<style>
.company-deploy-wrap { padding-top: 16px; padding-bottom: 64px; }
.company-deploy-back { display: inline-flex; align-items: center; gap: 4px; margin-bottom: 14px; }
.company-deploy-title { display: flex; align-items: center; gap: 11px; flex-wrap: wrap; }
.company-deploy-title h1 { margin: 0; font-size: 22px; display: flex; align-items: center; }
.company-deploy-subline { display: flex; align-items: center; gap: 6px; color: var(--color-text-light-2); font-size: 13px; margin-top: 8px; }

/* Same class the repo home page's own badge uses (custom/templates/custom/header.tmpl,
   company-deploy-status.ts) — this page renders it server-side instead of fetching it,
   but it should look identical wherever it shows up. */
.company-deploy-status-badge { display: inline-flex; align-items: center; gap: 5px; }

/* Only ever rendered for "rejected" (see RejectionComments, company/deploy.go) — the
   badge above already states the status itself, so this box exists purely to hold the
   admin's own reason, not to restate "rejected" a second time. */
.company-deploy-statusbox { border: 1px solid var(--color-secondary); border-radius: 6px; margin-top: 16px; padding: 12px 14px; }
.company-deploy-statusbox.rejected { background: var(--color-error-bg); }
.company-deploy-reason + .company-deploy-reason { margin-top: 10px; }
.company-deploy-reason-head { display: flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--color-text-light-2); margin-bottom: 4px; }
.company-deploy-reason-head strong { color: var(--color-text); }
.company-deploy-reason-quote { white-space: pre-wrap; font-size: 14px; }

.company-deploy-form { margin-top: 20px; max-width: 640px; }
.company-deploy-section-lbl { font-size: 16px; font-weight: 600; margin-bottom: 10px; }

.company-deploy-files { margin-top: 30px; }
.company-deploy-files-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
.company-deploy-files-heading { font-size: 16px; font-weight: 600; display: flex; align-items: center; gap: 8px; color: var(--color-text-light-2); }
.company-deploy-diffstat { font-family: var(--fonts-monospace); font-size: 12.5px; display: inline-flex; gap: 7px; }
.company-deploy-add { color: var(--color-green); font-weight: 600; }
.company-deploy-del { color: var(--color-red); font-weight: 600; }

.company-deploy-toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
.company-deploy-search { position: relative; flex: 1; min-width: 200px; }
.company-deploy-search svg { position: absolute; left: 9px; top: 50%; transform: translateY(-50%); color: var(--color-text-light-3); }
.company-deploy-filter-input { width: 100%; font-family: var(--fonts-monospace); font-size: 13px; padding: 6px 10px 6px 30px; border: 1px solid var(--color-secondary); border-radius: 6px; background: var(--color-input-background); color: var(--color-text); }
.company-deploy-filters { display: inline-flex; border: 1px solid var(--color-secondary); border-radius: 6px; overflow: hidden; }
.company-deploy-flt { font-size: 12.5px; font-weight: 500; padding: 6px 11px; border: 0; border-right: 1px solid var(--color-secondary); background: var(--color-box-body); color: var(--color-text-light-2); cursor: pointer; }
.company-deploy-flt:last-child { border-right: 0; }
.company-deploy-flt:hover { background: var(--color-hover); }
.company-deploy-flt.on { background: var(--color-primary); color: var(--color-primary-contrast); }
.company-deploy-count { font-family: var(--fonts-monospace); font-size: 11px; opacity: .8; }
.company-deploy-collapse-all { font-size: 12.5px; color: var(--color-primary); background: 0; border: 0; cursor: pointer; margin-left: auto; }
.company-deploy-collapse-all:hover { text-decoration: underline; }

.company-deploy-file { border: 1px solid var(--color-secondary); border-radius: 6px; margin-bottom: 10px; overflow: hidden; }
.company-deploy-fhead { display: flex; align-items: center; gap: 9px; padding: 8px 12px; background: var(--color-nav-bg); cursor: pointer; }
.company-deploy-fhead:hover { background: var(--color-hover); }
.company-deploy-chev { color: var(--color-text-light-2); flex: none; transition: transform .12s; }
.company-deploy-file.open .company-deploy-chev { transform: rotate(90deg); }
.company-deploy-fname { font-family: var(--fonts-monospace); font-size: 13px; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.company-deploy-fmeta { display: flex; align-items: center; gap: 10px; flex: none; color: var(--color-text-light-2); }
.company-deploy-fd { font-family: var(--fonts-monospace); font-size: 12px; }
.company-deploy-ext { display: inline-flex; color: var(--color-text-light-3); }
.company-deploy-ext:hover { color: var(--color-primary); }
.company-deploy-fbody { display: none; border-top: 1px solid var(--color-secondary); overflow-x: auto; }
.company-deploy-file.open .company-deploy-fbody { display: block; }

/* Split diff — a "before" column and an "after" column side by side, each with its own
   real line number, so it's never ambiguous which side a given line belongs to. A pure
   add/removal (company-deploy-diff-table-single) skips the split entirely — there's
   nothing to show on the other side, so it gets the full width instead of half of it. */
.company-deploy-diff-table { width: 100%; border-collapse: collapse; table-layout: fixed; font-family: var(--fonts-monospace); font-size: 12.5px; background: var(--color-code-bg); }
.company-deploy-diff-ln-col { width: 48px; }
.company-deploy-diff-ln { padding: 0 8px; text-align: right; color: var(--color-text-light-3); user-select: none; white-space: nowrap; vertical-align: top; }
.company-deploy-diff-table:not(.company-deploy-diff-table-single) .company-deploy-diff-ln.new { border-left: 1px solid var(--color-secondary); }
/* pre-wrap (not pre) + overflow-wrap so a long line wraps within its own column instead of
   overflowing, uncontained, into the next one — table cells don't clip overflow on their own. */
.company-deploy-diff-code { padding: 0 10px; white-space: pre-wrap; overflow-wrap: anywhere; vertical-align: top; }
.company-deploy-diff-code .code-inner { white-space: pre-wrap; }
.company-deploy-diff-ln.del { background: var(--color-diff-removed-linenum-bg); }
.company-deploy-diff-code.del { background: var(--color-diff-removed-row-bg); }
.company-deploy-diff-ln.add { background: var(--color-diff-added-linenum-bg); }
.company-deploy-diff-code.add { background: var(--color-diff-added-row-bg); }
.company-deploy-diff-ln.blank, .company-deploy-diff-code.blank { background: var(--color-diff-inactive); }

.company-deploy-diff-expand-row td { padding: 4px 10px; background: var(--color-nav-bg); }
.company-deploy-diff-expand-btn { display: inline-flex; align-items: center; gap: 6px; font-family: var(--fonts-monospace); font-size: 12px; color: var(--color-primary); background: 0; border: 1px solid var(--color-secondary); border-radius: 6px; padding: 3px 10px; cursor: pointer; }
.company-deploy-diff-expand-btn:hover { background: var(--color-hover); }

.company-deploy-none { padding: 26px; text-align: center; color: var(--color-text-light-2); border: 1px dashed var(--color-secondary); border-radius: 6px; font-size: 13.5px; }
.company-deploy-loadmore { text-align: center; margin-top: 4px; }
.company-deploy-loadmore-btn { font-size: 13px; color: var(--color-primary); background: 0; border: 1px solid var(--color-secondary); border-radius: 6px; padding: 6px 15px; cursor: pointer; }
.company-deploy-loadmore-btn:hover { background: var(--color-hover); }

@media (max-width: 640px) {
	.company-deploy-fmeta .company-deploy-fd { display: none; }
	.company-deploy-collapse-all { margin-left: 0; }
}
@media (prefers-reduced-motion: reduce) { .company-deploy-chev { transition: none; } }
</style>
{{template "base/footer" .}}

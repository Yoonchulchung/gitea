{{template "base/head" .}}
<div role="main" class="page-content">
	<div class="ui container">
		<div class="tw-mb-4">
			<a href="{{.Repo.Link}}" class="muted">&larr; {{.Repo.Name}}</a>
		</div>

		<h1 class="tw-mb-2">{{svg "octicon-rocket" 22 "tw-mr-2"}}{{ctx.Locale.Tr "company.deploy.title"}} — {{.Repo.Name}}</h1>

		{{if .DeployRequestStatus}}
			<div class="ui {{if eq .DeployRequestStatus.Status "approved"}}green{{else if eq .DeployRequestStatus.Status "rejected"}}red{{else if eq .DeployRequestStatus.Status "cancelled"}}grey{{else}}yellow{{end}} label tw-mb-2">
				{{ctx.Locale.Tr (printf "company.deploy_status.%s" .DeployRequestStatus.Status)}} - {{DateUtils.AbsoluteShort .DeployRequestStatus.Date}}
			</div>
		{{end}}

		{{if .RejectionComments}}
			{{/* Whatever the admin wrote when rejecting — typed alongside closing
			     the PR natively, same source as DeployRequestFiles' own comment
			     list (company/deployrequestfiles.go). Without this the requester
			     only ever saw "Rejected" with no way to find out why. */}}
			<div class="ui warning message tw-mb-4">
				<div class="header">{{ctx.Locale.Tr "company.deploy.rejection_reason_heading"}}</div>
				{{range .RejectionComments}}
					<p class="tw-mt-2">
						<strong>{{.Poster.Name}}</strong>
						<span class="text-grey tw-text-13">{{DateUtils.TimeSince .CreatedUnix}}</span><br>
						<span class="tw-whitespace-pre-wrap">{{.Content}}</span>
					</p>
				{{end}}
			</div>
		{{end}}

		<form class="ui form tw-max-w-2xl" id="deploy-form" method="post">
			<div class="field">
				<label>{{ctx.Locale.Tr "company.deploy.title_field_label"}}</label>
				<input type="text" name="title" placeholder="{{ctx.Locale.Tr "company.deploy.title_field_placeholder"}}" required>
			</div>
			<div class="field">
				<label>{{ctx.Locale.Tr "company.deploy.message_label"}}</label>
				<textarea name="message" rows="3" placeholder="{{ctx.Locale.Tr "company.deploy.message_placeholder"}}"></textarea>
			</div>
			<button type="submit" id="submit-button" class="ui primary button">
				{{svg "octicon-rocket" 16 "tw-mr-1"}}{{ctx.Locale.Tr "company.deploy.title"}}
			</button>
		</form>

		<div class="tw-mt-5">
			<h4 class="tw-mb-2 flex-text-block">{{svg "octicon-file-diff" 16}}{{ctx.Locale.Tr "company.deploy.files_heading" (len .DeployFiles)}}</h4>
			{{if .DeployFiles}}
				{{range .DeployFiles}}
					<div class="ui top attached header flex-text-block company-deploy-diff-file-header">
						{{if .IsNew}}
							{{svg "octicon-diff-added" 16 "tw-text-green"}}
						{{else if .IsRemoved}}
							{{svg "octicon-diff-removed" 16 "tw-text-red"}}
						{{else}}
							{{svg "octicon-diff-modified" 16 "tw-text-yellow"}}
						{{end}}
						<span class="tw-flex-1 tw-font-mono tw-text-14">{{.Path}}</span>
						{{if not .IsRemoved}}
							<a class="muted tw-text-13" href="{{$.Repo.Link}}/src/branch/{{PathEscapeSegments $.Repo.DefaultBranch}}/{{PathEscapeSegments .Path}}" target="_blank" rel="noopener" title="{{ctx.Locale.Tr "company.deploy.view_file"}}">
								{{svg "octicon-link-external" 13}}
							</a>
						{{end}}
					</div>
					<div class="ui attached unstackable table segment tw-mb-4 tw-p-0 tw-overflow-x-auto">
						{{if .IsBinary}}
							<div class="tw-p-3 text-grey">{{ctx.Locale.Tr "repo.diff.bin"}}</div>
						{{else if .TooLarge}}
							<div class="tw-p-3 text-grey">{{ctx.Locale.Tr "repo.diff.file_suppressed"}}</div>
						{{else}}
							{{/* code-diff-unified is what scopes native Gitea's own add-code/
							     del-code row styling (web_src/css/repo.css) — reusing it here
							     means the green/red backgrounds come for free, no new CSS. */}}
							<table class="chroma tw-w-full code-diff-unified">
								<tbody>
									{{range .Lines}}
										<tr class="{{if eq .Type "add"}}add-code{{else if eq .Type "del"}}del-code{{else}}same-code{{end}}">
											<td class="lines-type-marker"><span class="tw-font-mono" data-type-marker="{{if eq .Type "add"}}+{{else if eq .Type "del"}}-{{end}}"></span></td>
											<td class="lines-code chroma"><code class="code-inner">{{.Content}}</code></td>
										</tr>
									{{end}}
								</tbody>
							</table>
						{{end}}
					</div>
				{{end}}
			{{else}}
				<div class="text-grey tw-text-13">{{ctx.Locale.Tr "company.deploy.no_files"}}</div>
			{{end}}
		</div>
	</div>
</div>
{{template "base/footer" .}}

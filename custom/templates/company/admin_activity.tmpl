{{template "admin/layout_head" (dict "pageClass" "admin company-activity")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">{{ctx.Locale.Tr "company.activity.title"}}</h4>
		{{/* One department at a time, because "what has PO been doing" is the
		     question an administrator arrives with once they know which
		     department they mean. The choice is in the URL, so the page can be
		     linked to and the pager keeps it.
		     A menu of links, not a field in a form: choosing applies at once,
		     and there is nothing the unsaved-changes guard could ask to save —
		     see custom/templates/company/admin_deploys.tmpl for the same
		     picker and why it stopped being a <select>. */}}
		<div class="ui attached segment">
			<div class="company-activity-filter">
				<div class="ui dropdown jump company-filter-menu">
					<span class="text-grey tw-text-13">{{ctx.Locale.Tr "company.activity.filter_dept"}}</span>
					<span class="company-filter-menu-value">{{with .Department}}{{.DisplayName}}{{else}}{{ctx.Locale.Tr "company.activity.dept_all"}}{{end}}</span>
					{{svg "octicon-triangle-down" 14 "dropdown icon"}}
					<div class="menu">
						<a class="item{{if not .Department}} active{{end}}" href="?">{{ctx.Locale.Tr "company.activity.dept_all"}}</a>
						{{range .Departments}}
							<a class="item{{if and $.Department (eq $.Department.ID .ID)}} active{{end}}" href="?dept={{PathEscape .Name}}">{{.DisplayName}}</a>
						{{end}}
					</div>
				</div>
				{{with .Department}}
					<a class="ui tiny basic button" href="{{AppSubUrl}}/{{PathEscape .Name}}">{{ctx.Locale.Tr "company.activity.open_dept"}}</a>
				{{end}}
			</div>
		</div>
		<div class="ui attached table segment">
			<table class="ui very basic table">
				<thead>
					<tr>
						<th class="tw-w-1/6">{{ctx.Locale.Tr "company.activity.col_when"}}</th>
						<th class="tw-w-1/6">{{ctx.Locale.Tr "company.activity.col_who"}}</th>
						<th>{{ctx.Locale.Tr "company.activity.col_what"}}</th>
						<th class="tw-w-1/4">{{ctx.Locale.Tr "company.activity.col_where"}}</th>
					</tr>
				</thead>
				<tbody>
					{{range .Rows}}
						<tr>
							<td title="{{DateUtils.FullTime .At}}">{{DateUtils.TimeSince .At}}</td>
							<td>
								{{/* A deleted account still has to be attributable: the row is
								     evidence that something happened, and dropping the name
								     because the user record went away loses exactly that. */}}
								{{if .Actor}}
									<a href="{{AppSubUrl}}/{{PathEscape .Actor.Name}}">{{.Actor.Name}}</a>
								{{else}}
									<span class="text-grey">{{ctx.Locale.Tr "company.activity.who_gone"}}</span>
								{{end}}
							</td>
							<td>
								{{ctx.Locale.Tr .OpKey}}
								{{if .Detail}}<span class="tw-font-mono text-grey tw-ml-2">{{.Detail}}</span>{{end}}
							</td>
							<td>{{if .Repo}}<a href="{{.Repo.Link}}">{{.Repo.OwnerName}}/{{.Repo.Name}}</a>{{end}}</td>
						</tr>
					{{else}}
						<tr><td colspan="4" class="text-grey">{{if .Department}}{{ctx.Locale.Tr "company.activity.none_dept" .Department.DisplayName}}{{else}}{{ctx.Locale.Tr "company.activity.none"}}{{end}}</td></tr>
					{{end}}
				</tbody>
			</table>
		</div>
		{{template "base/paginate" .}}
	</div>
{{template "admin/layout_footer" .}}

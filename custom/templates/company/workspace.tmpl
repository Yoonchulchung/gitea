<!--
	Multi-file editor for one repo/branch. Additive company/ page — no
	upstream template to diff against. Mounted at
	/{owner}/{repo}/_edits/{branch}, alongside Gitea's own _new/_edit/_upload
	routes (routers/web/web.go), so it inherits their branch parsing and
	write-access gate. The file tree and file contents load client-side
	from Gitea's own existing routes (tree-list/raw), and the actual
	editing reuses Gitea's own bundled CodeMirror setup
	(web_src/js/modules/codeeditor, wired in here through
	web_src/js/features/company-workspace.ts, data-global-init="initCompanyWorkspace")
	— one CodeMirror instance per open tab. Saving posts every changed/
	moved/deleted tab to company/workspace.go's WorkspaceSave, which
	commits them all as a single commit straight to this branch, same
	"direct" rule the simplified single-file editor follows
	(custom/templates/repo/editor/commit_form.tmpl). See docs/company/repo-ui.md.
-->
{{template "base/head" .}}
<div role="main" class="page-content company-workspace-page">
	<div class="ui container fluid tw-pt-2 tw-pb-4 tw-px-4">
		<a href="{{.BackLink}}" class="muted company-workspace-back-link">&larr; {{.Repo.Name}}</a>
	</div>

	<div class="company-workspace tw-flex" data-global-init="initCompanyWorkspace"
		data-repo-link="{{.Repo.Link}}" data-branch="{{.Branch}}"
		data-save-url="{{.Repo.Link}}/_edits/{{.Branch | PathEscapeSegments}}/save"
		data-ai-url="{{.Repo.Link}}/_edits_ai/{{.Branch | PathEscapeSegments}}"
		data-tmp-url="{{.Repo.Link}}/_edits_tmp/{{.Branch | PathEscapeSegments}}"
		data-folders-url="{{.Repo.Link}}/_edits_folders/{{.Branch | PathEscapeSegments}}"
		data-upload-url="{{.Repo.Link}}/_edits_upload/{{.Branch | PathEscapeSegments}}"
		data-upload-max-mb="{{.UploadMaxMB}}"
		data-i18n-upload-too-large="{{ctx.Locale.Tr "company.workspace.upload_too_large" "%s" "%s" .UploadMaxMB .SourceMaxMB}}"
		data-i18n-upload-refused="{{ctx.Locale.Tr "company.workspace.upload_refused" "%s"}}"
		data-icon-url="{{.Repo.Link}}/_edits_icon/{{.Branch | PathEscapeSegments}}"
		data-i18n-confirm-discard-tab="{{ctx.Locale.Tr "company.workspace.confirm_discard_tab" "%s"}}"
		data-i18n-confirm-delete-file="{{ctx.Locale.Tr "company.workspace.confirm_delete_file" "%s"}}"
		data-i18n-status-delete-pending="{{ctx.Locale.Tr "company.workspace.status_delete_pending" "%s"}}"
		data-i18n-status-deleted="{{ctx.Locale.Tr "company.workspace.status_deleted" "%s"}}"
		data-i18n-loading="{{ctx.Locale.Tr "company.workspace.loading"}}"
		data-i18n-error-load-file="{{ctx.Locale.Tr "company.workspace.error_load_file" "%s"}}"
		data-i18n-status-recovering="{{ctx.Locale.Tr "company.workspace.status_recovering" "%s"}}"
		data-i18n-error-file-exists="{{ctx.Locale.Tr "company.workspace.error_file_exists" "%s"}}"
		data-i18n-error-binary-file="{{ctx.Locale.Tr "company.workspace.error_binary_file" "%s"}}"
		data-i18n-status-moved="{{ctx.Locale.Tr "company.workspace.status_moved" "%s" "%s"}}"
		data-i18n-new-file-placeholder="{{ctx.Locale.Tr "company.workspace.new_file_placeholder"}}"
		data-i18n-confirm-upload-binary="{{ctx.Locale.Tr "company.workspace.confirm_upload_binary" "%s"}}"
		data-i18n-status-uploaded="{{ctx.Locale.Tr "company.workspace.status_uploaded" "%s"}}"
		data-i18n-error-upload="{{ctx.Locale.Tr "company.workspace.error_upload" "%s"}}"
		data-i18n-new-folder-placeholder="{{ctx.Locale.Tr "company.workspace.new_folder_placeholder"}}"
		data-i18n-status-no-changes="{{ctx.Locale.Tr "company.workspace.status_no_changes"}}"
		data-i18n-status-saving="{{ctx.Locale.Tr "company.workspace.status_saving"}}"
		data-i18n-status-saved="{{ctx.Locale.Tr "company.workspace.status_saved"}}"
		data-i18n-error-save-failed="{{ctx.Locale.Tr "company.workspace.error_save_failed"}}"
		data-i18n-folder-closed="{{ctx.Locale.Tr "company.workspace.folder_closed"}}"
		data-i18n-folder-open="{{ctx.Locale.Tr "company.workspace.folder_open"}}"
		data-i18n-delete-file="{{ctx.Locale.Tr "company.workspace.delete_file"}}"
		data-i18n-rename="{{ctx.Locale.Tr "company.workspace.rename"}}"
		data-i18n-status-renamed="{{ctx.Locale.Tr "company.workspace.status_renamed" "%s" "%s"}}"
		data-i18n-error-bad-name="{{ctx.Locale.Tr "company.workspace.error_bad_name" "%s"}}"
		data-i18n-confirm-leave-unsaved="{{ctx.Locale.Tr "company.workspace.confirm_leave_unsaved"}}"
		data-i18n-conflict-yours="{{ctx.Locale.Tr "company.workspace.conflict_yours"}}"
		data-i18n-conflict-theirs="{{ctx.Locale.Tr "company.workspace.conflict_theirs" "%s" "%s"}}"
		data-i18n-conflict-theirs-latest="{{ctx.Locale.Tr "company.workspace.conflict_theirs_latest"}}"
		data-i18n-conflict-use-yours="{{ctx.Locale.Tr "company.workspace.conflict_use_yours"}}"
		data-i18n-conflict-use-theirs="{{ctx.Locale.Tr "company.workspace.conflict_use_theirs"}}"
		data-i18n-conflict-use-both="{{ctx.Locale.Tr "company.workspace.conflict_use_both"}}"
		data-i18n-conflict-unresolved="{{ctx.Locale.Tr "company.workspace.conflict_unresolved" "%s"}}"
		data-i18n-status-auto-merged="{{ctx.Locale.Tr "company.workspace.status_auto_merged" "%s"}}"
		data-i18n-status-conflict="{{ctx.Locale.Tr "company.workspace.status_conflict" "%s"}}"
	>
		<div class="company-workspace-sidebar">
			<div class="flex-text-block">
				<button type="button" class="ui basic tiny fluid button company-workspace-new-file">
					{{svg "octicon-file-added" 14 "tw-mr-1"}}{{ctx.Locale.Tr "repo.editor.new_file"}}
				</button>
				<button type="button" class="ui basic tiny icon button company-workspace-new-folder" data-tooltip-content="{{ctx.Locale.Tr "company.workspace.new_folder"}}">
					{{svg "octicon-file-directory" 14}}
				</button>
				<button type="button" class="ui basic tiny icon button company-workspace-upload" data-tooltip-content="{{ctx.Locale.Tr "company.workspace.upload"}}">
					{{svg "octicon-upload" 14}}
				</button>
				<input type="file" multiple class="company-workspace-upload-input tw-hidden">
			</div>
			<div class="company-workspace-tree"></div>
		</div>
		<div class="company-workspace-main">
			<div class="company-workspace-toolbar">
				<div class="company-workspace-tabs"></div>
				<div class="company-workspace-actions">
					<span class="company-workspace-status tw-text-text-light"></span>
					{{/* A plain link on purpose: the delegated click handler in
					     company-workspace.ts already confirms before leaving with
					     unsaved work, so this inherits that instead of needing a
					     guard of its own — which matters here more than anywhere,
					     because a deploy request ships what was committed and
					     unsaved edits would silently not be in it.

					     Hidden while the repo has no commits: there is nothing to
					     request a deploy of yet, and a button that can only fail
					     is worse than no button. */}}
					{{if not .Repo.IsEmpty}}
						<a class="ui basic tiny button" href="{{.Repo.Link}}/deploy">{{ctx.Locale.Tr "company.app.request_deploy"}}</a>
					{{end}}
					<button type="button" class="ui primary tiny button company-workspace-save">{{ctx.Locale.Tr "save"}}</button>
				</div>
			</div>
			<div class="company-workspace-panes"></div>
		</div>
		{{/* Not rendered at all when the instance has AI switched off: the
		     "set up your key" state below is for someone who can set one up,
		     and offering it here would advertise a feature this instance does
		     not have. See company.AIOfferedTo. */}}
		{{if .CompanyAIOffered}}
		<div class="company-workspace-ai-chat" data-ai-ready="{{.AIEnabled}}"
			data-ai-empty-state="{{ctx.Locale.Tr "company.workspace.ai_empty_state"}}"
			data-ai-not-configured="{{ctx.Locale.Tr "company.workspace.ai_not_configured"}}"
			data-ai-not-configured-link="{{ctx.Locale.Tr "company.workspace.ai_not_configured_link"}}"
			data-ai-not-configured-url="{{printf "%s/user/settings/ai" AppSubUrl}}"
			data-ai-not-configured-placeholder="{{ctx.Locale.Tr "company.workspace.ai_not_configured_placeholder"}}"
			data-ai-stop="{{ctx.Locale.Tr "company.workspace.ai_stop"}}"
			data-ai-request-failed="{{ctx.Locale.Tr "company.workspace.ai_request_failed"}}"
			data-ai-read-status="{{ctx.Locale.Tr "company.workspace.ai_read_status" "%s"}}"
			data-ai-edit-status="{{ctx.Locale.Tr "company.workspace.ai_edit_status" "%s"}}"
			data-ai-delete-status="{{ctx.Locale.Tr "company.workspace.ai_delete_status" "%s"}}"
			data-ai-rename-status="{{ctx.Locale.Tr "company.workspace.ai_rename_status" "%s" "%s"}}"
			data-ai-queued="{{ctx.Locale.Tr "company.workspace.ai_queued" "%s"}}"
		>
			<div class="company-ai-chat-header">
				AI
			</div>
			<div class="company-ai-chat-messages"></div>
			<div class="company-ai-chat-inputbar">
				<div class="company-ai-chat-queue tw-hidden"></div>
				<div class="company-ai-chat-inputwrap">
					<textarea class="company-ai-chat-input" rows="1" placeholder="{{ctx.Locale.Tr "company.workspace.ai_placeholder"}}"></textarea>
					<div class="company-ai-chat-inputtoolbar">
						<span class="company-ai-chat-context tw-hidden" data-tooltip-content="{{ctx.Locale.Tr "company.workspace.ai_context_tooltip"}}"></span>
						{{/* Which model suits the question changes with the question, and
						     sending someone to their settings page to change it meant
						     nobody changed it. The pick applies to this request only —
						     it is never written back, so choosing something expensive
						     for one hard question does not become the standing cost. */}}
						<select class="company-ai-chat-model" aria-label="{{ctx.Locale.Tr "company.workspace.ai_model"}}"
						        data-models-url="{{printf "%s/user/settings/ai/models" AppSubUrl}}"
						        data-provider="{{.AIProvider}}">
							{{if .AIModel}}<option value="{{.AIModel}}" selected>{{.AIModel}}</option>{{end}}
						</select>
						<button type="button" class="company-ai-chat-send" aria-label="{{ctx.Locale.Tr "company.workspace.ai_send"}}"></button>
					</div>
				</div>
			</div>
		</div>
		{{end}}
	</div>
</div>

<style>
.company-workspace {
	/* No fixed height here on purpose — how much vertical chrome sits
	   above (navbar, our own breadcrumb) and below (site footer) isn't
	   ours to know from CSS alone, and any fixed calc() guess drifts the
	   moment either one's height changes. company-workspace.ts measures
	   the box's own actual top offset at runtime instead and sets height
	   to reach exactly to the bottom of the viewport (minus the footer's
	   own reserved space) — see initCompanyWorkspace's sizeToViewport. */
	min-height: 480px;
	border: 1px solid var(--color-secondary);
	border-radius: 6px;
	overflow: hidden;
	overscroll-behavior: contain;
}
.company-workspace-sidebar {
	width: 240px;
	flex-shrink: 0;
	border-right: 1px solid var(--color-secondary);
	background: var(--color-box-body);
	padding: .75rem;
	overflow-y: auto;
	/* A long filename (no spaces to wrap on) forced this flex column wider
	   than its own width, which then made the whole sidebar scroll
	   sideways — clip it instead; ellipsis below is what should show the
	   overflow, not a scrollbar. */
	overflow-x: hidden;
	/* Same fix as .cm-scroller below: without this, scrolling the file
	   tree past its own content chains up to the whole page once the
	   browser considers the sidebar's own scroll "done" for that wheel
	   tick — the page visibly jumps along with it. */
	overscroll-behavior: contain;
	display: flex;
	flex-direction: column;
	gap: .5rem;
}
.company-workspace-tree {
	display: flex;
	flex-direction: column;
	min-width: 0;
	/* Without flex:1 this only takes up its own content's height, so the
	   blank area below the last row belongs to .company-workspace-sidebar
	   instead — which has no drop handling wired to it at all, so a drop
	   there (or a click meant to deselect a folder) silently did nothing
	   unless it landed exactly on a row. */
	flex: 1;
}
.company-workspace-tree-row {
	display: flex;
	align-items: center;
	gap: .35rem;
	padding: .3rem .5rem;
	border-radius: 4px;
	cursor: pointer;
	font-size: .9rem;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	min-width: 0; /* let text-overflow:ellipsis actually apply instead of pushing the row wider */
}
.company-workspace-tree-row:hover { background: var(--color-hover); }
.company-workspace-tree-row.selected {
	background: var(--color-active);
}
.company-workspace-tree-item[draggable] {
	cursor: grab;
}
.drop-target {
	outline: 2px dashed var(--color-primary);
	outline-offset: -2px;
	background: var(--color-primary-light-7, rgba(0,0,0,.03));
}
.company-workspace-tree-row .company-workspace-tree-name {
	overflow: hidden;
	text-overflow: ellipsis;
	flex: 1;
	min-width: 0;
}
.company-workspace-tree-action {
	flex-shrink: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 20px;
	height: 20px;
	border: none;
	border-radius: 4px;
	background: transparent;
	color: var(--color-text-light-2);
	cursor: pointer;
	opacity: 0;
	/* Rename on every row; delete only on files — a folder deletes via its
	   own contents, not as a unit. */
}
.company-workspace-tree-row:hover .company-workspace-tree-action,
.company-workspace-tree-action:focus-visible {
	opacity: 1;
}
.company-workspace-tree-action:hover {
	background: var(--color-hover);
	color: var(--color-text);
}
.company-workspace-tree-delete:hover {
	background: var(--color-danger-hover, var(--color-hover));
	color: var(--color-danger, var(--color-red));
}
.company-workspace-tree-chevron {
	display: inline-flex;
	flex-shrink: 0;
	color: var(--color-text-light);
}
.company-workspace-tree-folder svg:not(.company-workspace-tree-chevron svg) {
	flex-shrink: 0;
	color: var(--color-text-light);
}
.company-workspace-tree-item svg {
	flex-shrink: 0;
	color: var(--color-text-light);
}
.company-workspace-tree-new-item {
	cursor: default;
}
.company-workspace-tree-new-item svg {
	flex-shrink: 0;
	color: var(--color-text-light);
}
.company-workspace-tree-new-input {
	flex: 1;
	min-width: 0;
	border: 1px solid var(--color-primary);
	border-radius: 3px;
	padding: .1rem .3rem;
	font-size: .9rem;
	background: var(--color-input-background);
	color: var(--color-text);
}
.company-workspace-main {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
}
.company-workspace-toolbar {
	display: flex;
	align-items: center;
	justify-content: space-between;
	border-bottom: 1px solid var(--color-secondary);
	padding: .65rem .75rem;
	gap: .5rem;
}
.company-workspace-tabs {
	display: flex;
	overflow-x: auto;
	flex: 1;
	min-width: 0;
}
.company-workspace-tab {
	display: flex;
	align-items: center;
	gap: .4rem;
	padding: .35rem .6rem;
	border-radius: 4px;
	cursor: pointer;
	font-size: .85rem;
	white-space: nowrap;
	color: var(--color-text-light);
}
.company-workspace-tab.active {
	background: var(--color-active);
	color: var(--color-text);
}
.company-workspace-tab-close {
	border: none;
	background: none;
	cursor: pointer;
	color: inherit;
	line-height: 1;
	padding: 0 .15rem;
}
.company-workspace-actions {
	display: flex;
	align-items: center;
	gap: .5rem;
	min-width: 0; /* a long status message must truncate, not push Save under the AI panel */
}
.company-workspace-status {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.company-workspace-actions .button {
	flex-shrink: 0;
}
/* conflict-resolution UI (company-conflict.ts): tinted sections + one-click buttons */
.cm-line.company-conflict-yours {
	background: var(--color-diff-added-row-bg);
}
.cm-line.company-conflict-theirs {
	background: var(--color-info-bg);
}
.cm-line.company-conflict-marker {
	background: var(--color-warning-bg);
	color: var(--color-text-light-2);
}
.company-conflict-actions {
	display: flex;
	gap: .75rem;
	padding: 2px 8px;
	font-size: 12px;
	background: var(--color-box-header);
	border-top: 1px solid var(--color-secondary);
}
.company-conflict-actions button {
	background: none;
	border: none;
	padding: 0;
	color: var(--color-primary);
	cursor: pointer;
	font-size: 12px;
}
.company-conflict-actions button:hover {
	text-decoration: underline;
}
.company-workspace-panes {
	flex: 1;
	min-height: 0;
	position: relative;
}
.company-workspace-pane {
	position: absolute;
	inset: 0;
	display: flex;
	flex-direction: column;
}
.company-workspace-editor-form {
	flex: 1;
	min-height: 0;
	display: flex;
	flex-direction: column;
}
.company-workspace-pane .code-editor-container,
.company-workspace-pane .CodeMirror {
	flex: 1;
	min-height: 0;
	height: 100%;
}
.company-workspace-pane .cm-editor {
	/* Gitea's own codeeditor.css never constrains .cm-editor's height —
	   native pages let it grow to its content and the whole page scrolls.
	   Our page needs a fixed-height box with internal scrolling instead;
	   without this, .cm-editor renders at its natural (taller) content
	   height, overflows its 100%-height parent, and the last lines get
	   silently clipped by .company-workspace's overflow:hidden — the
	   editor thinks it has more visible room than it actually does, so
	   scrolling to the bottom still doesn't show the last line. */
	height: 100%;
	/* codeeditor.css's own default is 12px — sized for the native, more
	   compact single-file editor. This page is the primary editing
	   surface, not a secondary panel, so it gets a size closer to a real
	   code editor's default. */
	font-size: 14px;
}
.company-workspace-pane .cm-content {
	/* codeeditor.css zeroes this out ("avoid the small top and bottom
	   padding") for the native compact editor — this page wants real
	   breathing room above the first line instead, so the text doesn't
	   start flush against the toolbar. */
	padding-top: 1rem;
}
.company-workspace-pane .cm-scroller {
	/* Without this, scrolling the editor past what the mouse wheel needs to
	   move it chains up to the page itself once the browser decides the
	   inner scroll is "done" for that wheel tick — the whole page (header,
	   file tree) visibly jumps along with the editor content. */
	overscroll-behavior: contain;
}
.company-workspace-ai-chat {
	width: 460px;
	flex-shrink: 0;
	border-left: 1px solid var(--color-secondary);
	background: var(--color-box-body);
	display: flex;
	flex-direction: column;
	min-height: 0;
}
</style>
{{template "base/footer" .}}

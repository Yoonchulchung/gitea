<!--
	/user/settings/ai — additive company/ page, no upstream equivalent to
	diff against. Reuses Gitea's own settings page chrome (layout_head/
	layout_footer, same as templates/user/settings/appearance.tmpl) so it
	looks and behaves like every other settings tab. See
	company/settings_ai.go.
-->
{{template "user/settings/layout_head" (dict "pageClass" "user settings")}}
	<div class="user-setting-content">
		<h4 class="ui top attached header">
			AI Agent
		</h4>
		<div class="ui attached segment">
			{{if not .GatewayConfigured}}
				<div class="ui warning message">
					{{ctx.Locale.Tr "company.settings_ai.gateway_not_configured"}}
				</div>
			{{end}}
			<p class="text-grey">{{ctx.Locale.Tr "company.settings_ai.description"}}</p>
			<form class="ui form" action="{{AppSubUrl}}/user/settings/ai" method="post" data-models-url="{{AppSubUrl}}/user/settings/ai/models" data-global-init="initCompanySettingsAI">
				<div class="field">
					<label>{{ctx.Locale.Tr "company.settings_ai.provider"}}</label>
					<div class="ui selection dropdown company-settings-ai-provider">
						<input type="hidden" name="provider" value="{{.Provider}}">
						<div class="text"></div> {{svg "octicon-triangle-down" 14 "dropdown icon"}}
						<div class="menu">
							<div class="item" data-value="openai">{{ctx.Locale.Tr "company.settings_ai.provider_openai"}}</div>
							<div class="item" data-value="anthropic">{{ctx.Locale.Tr "company.settings_ai.provider_anthropic"}}</div>
						</div>
					</div>
					<p class="help">{{ctx.Locale.Tr "company.settings_ai.provider_help"}}</p>
				</div>
				<div class="field">
					<label>{{ctx.Locale.Tr "company.settings_ai.api_key"}}</label>
					<input name="api_key" class="company-settings-ai-key" type="password" autocomplete="off" placeholder="{{if .APIKeySet}}{{ctx.Locale.Tr "company.settings_ai.api_key_unchanged"}}{{else}}{{ctx.Locale.Tr "company.settings_ai.api_key_placeholder"}}{{end}}">
					{{if .APIKeySet}}<p class="help">{{ctx.Locale.Tr "company.settings_ai.api_key_set_help"}}</p>{{end}}
				</div>
				<div class="field" data-i18n-models-empty="{{ctx.Locale.Tr "company.settings_ai.models_empty"}}">
					<label>{{ctx.Locale.Tr "company.settings_ai.model_id"}}</label>
					{{/* A real Fomantic dropdown rather than a bare <input list="...">:
					     a <datalist> renders inconsistently across browsers (and on
					     several shows no list at all), so the suggestions were
					     effectively invisible. "custom" keeps common-page.ts's global
					     dropdown init off it — company-settings-ai.ts initializes it
					     itself with allowAdditions, since a gateway's model IDs are
					     deployment-specific and must stay free-typeable. */}}
					<div class="tw-flex tw-gap-2">
						<div class="ui search selection dropdown custom company-settings-ai-model tw-flex-1">
							<input type="hidden" name="model_id" value="{{.ModelID}}">
							<div class="default text">{{ctx.Locale.Tr "company.settings_ai.model_id_placeholder"}}</div>
							{{svg "octicon-triangle-down" 14 "dropdown icon"}}
							<div class="menu"></div>
						</div>
						<button type="button" class="ui basic button company-settings-ai-fetch-models">{{ctx.Locale.Tr "company.settings_ai.fetch_models"}}</button>
					</div>
					<p class="help company-settings-ai-model-help"></p>
				</div>
				<div class="field">
					<label>{{ctx.Locale.Tr "company.settings_ai.reasoning_effort"}}</label>
					<div class="ui selection dropdown">
						<input type="hidden" name="reasoning_effort" value="{{.ReasoningEffort}}">
						<div class="text"></div> {{svg "octicon-triangle-down" 14 "dropdown icon"}}
						<div class="menu">
							<div class="item" data-value="">{{ctx.Locale.Tr "company.settings_ai.reasoning_effort_default"}}</div>
							<div class="item" data-value="low">Low</div>
							<div class="item" data-value="medium">Medium</div>
							<div class="item" data-value="high">High</div>
						</div>
					</div>
				</div>
				<button class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
			</form>
		</div>
	</div>
{{template "user/settings/layout_footer" .}}

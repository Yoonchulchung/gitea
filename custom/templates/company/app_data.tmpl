{{template "base/head" .}}
<div role="main" class="page-content repository company-app-page">
	{{template "repo/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		<div class="company-app-titlebar">
			{{template "company/app_title"}}
			{{if and .HasData .DataUsage}}
				<span class="tw-text-13 {{if .DataUsage.Full}}text-red{{else if .DataUsage.Warning}}text-orange{{else}}text-grey{{end}}" data-tooltip-content="{{ctx.Locale.Tr "company.adminapp.kpi_data"}}">
					{{FormatByteSize .DataUsage.Bytes}} / {{FormatByteSize .DataUsage.QuotaBytes}}
				</span>
			{{end}}
		</div>
		{{template "company/app_tabs"}}

		{{if not .DataEnabled}}
			<div class="ui segment">
				<p>{{ctx.Locale.Tr "company.data.disabled_user"}}</p>
			</div>
		{{else if not .HasData}}
			<div class="ui segment">
				<p>{{ctx.Locale.Tr "company.data.none_yet"}}</p>
			</div>
		{{else}}
			{{template "company/data_browse" .}}
			{{template "company/data_history" .}}
		{{end}}
	</div>
</div>
{{template "base/footer" .}}

{{/* The copies a change is undone from, and who changed what. Shared with
     the admin console; a department's restore stops and starts the app by
     itself (company/appdataedit.go), an administrator's asks them to. */}}
{{define "company/data_history"}}
	<h4 class="ui attached header tw-flex tw-items-center tw-justify-between">
		{{ctx.Locale.Tr "company.data.snapshots_header"}}
		<div class="flex-text-inline">
			<form method="post" action="{{.DataLink}}/snapshot">{{.CsrfTokenHtml}}
				<button class="ui tiny button">{{ctx.Locale.Tr "company.data.take_snapshot"}}</button>
			</form>
			{{template "company/data_upload" .}}
		</div>
	</h4>
	<div class="ui attached segment">
		<form method="post" action="{{.DataLink}}/auto-snapshot" class="ui form flex-text-block tw-mb-2">
			{{.CsrfTokenHtml}}
			<div class="ui toggle checkbox">
				<input id="auto-snapshot-on" type="checkbox" name="on" value="true" {{if .AutoSnapshot.On}}checked{{end}} data-company-autosubmit>
				<label for="auto-snapshot-on">{{ctx.Locale.Tr "company.data.auto_snapshot"}}</label>
			</div>
			<select name="days" class="ui small compact selection dropdown" aria-label="{{ctx.Locale.Tr "company.data.auto_snapshot"}}" data-company-autosubmit>
				{{range $d := .AutoSnapshot.Choices}}
					<option value="{{$d}}" {{if eq $d $.AutoSnapshot.Days}}selected{{end}}>{{ctx.Locale.Tr "company.data.auto_snapshot_every" $d}}</option>
				{{end}}
			</select>
			{{if .AutoSnapshot.On}}
				<span class="text-grey tw-text-13">
					{{if .AutoSnapshot.NextAt}}{{ctx.Locale.Tr "company.data.auto_snapshot_next" (DateUtils.TimeSince .AutoSnapshot.NextAt)}}{{else}}{{ctx.Locale.Tr "company.data.auto_snapshot_soon"}}{{end}}
				</span>
			{{end}}
		</form>
		{{template "company/data_snapshot_rows" (dict "Snapshots" .Snapshots "DataLink" .DataLink "CsrfTokenHtml" .CsrfTokenHtml "CanRestore" true "RestoreLabel" "company.data.snapshot_restore_dept" "RestoreConfirm" "company.data.restore_confirm_dept")}}
	</div>
	{{template "company/data_changes" .}}
{{end}}

{{define "company/data_changes"}}
	{{if .RecentChanges}}
		<h4 class="ui attached header">{{ctx.Locale.Tr "company.data.changes_header"}}</h4>
		<div class="ui attached segment">
			<table class="ui very basic compact table tw-text-13">
				<tbody>
					{{range .RecentChanges}}
						<tr>
							<td class="tw-w-32 text-grey tw-whitespace-nowrap" title="{{DateUtils.FullTime .At}}">{{DateUtils.TimeSince .At}}</td>
							<td class="tw-w-40">{{.Actor}}</td>
							<td>{{ctx.Locale.Tr .Label .Table .Detail}}</td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>
	{{end}}
{{end}}

{{/* An uploaded SQLite file becomes a snapshot; it takes effect only when
     restored, so the usual copy of what it replaces is taken first. */}}
{{define "company/data_upload"}}
	<form method="post" action="{{.DataLink}}/upload" enctype="multipart/form-data">
		{{.CsrfTokenHtml}}
		<label class="ui tiny button">
			{{svg "octicon-upload" 14}} {{ctx.Locale.Tr "company.data.snapshot_upload"}}
			<input type="file" name="file" class="tw-hidden" accept=".db,.sqlite,.sqlite3,application/vnd.sqlite3" data-company-autosubmit>
		</label>
	</form>
{{end}}

{{/* One table for both pages; only the restore button differs. */}}
{{define "company/data_snapshot_rows"}}
	{{if .Snapshots}}
		<table class="ui very basic compact table tw-text-13">
			<tbody>
				{{range $snap := .Snapshots}}
					<tr>
						<td class="tw-font-mono">{{$snap.Name}}</td>
						<td class="tw-w-24 tw-text-right">{{FormatByteSize $snap.Bytes}}</td>
						<td class="tw-w-32 text-grey tw-whitespace-nowrap" title="{{DateUtils.FullTime $snap.At}}">{{DateUtils.TimeSince $snap.At}}</td>
						<td class="tw-text-right">
							<div class="flex-text-inline tw-justify-end">
								<a class="ui tiny basic button" href="{{$.DataLink}}/snapshot?name={{$snap.Name}}" download>{{svg "octicon-download" 14}} {{ctx.Locale.Tr "company.data.snapshot_download"}}</a>
								{{if $.CanRestore}}
									<form method="post" action="{{$.DataLink}}/restore" data-company-confirm="{{ctx.Locale.Tr $.RestoreConfirm}}">
										{{$.CsrfTokenHtml}}
										<input type="hidden" name="name" value="{{$snap.Name}}">
										<button class="ui tiny button">{{ctx.Locale.Tr $.RestoreLabel}}</button>
									</form>
								{{end}}
							</div>
						</td>
					</tr>
				{{end}}
			</tbody>
		</table>
	{{else}}
		<p class="text-grey">{{ctx.Locale.Tr "company.data.no_snapshots"}}</p>
	{{end}}
{{end}}

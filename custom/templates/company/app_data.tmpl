{{template "base/head" .}}
<div role="main" class="page-content repository company-app-page">
	{{template "repo/header" .}}
	<div class="ui container">
		<h4 class="ui top attached header">
			<a href="{{.AppLink}}">{{.App.Owner}}/{{.App.Repo}}</a>
			<span class="text-grey tw-mx-2">/</span>{{ctx.Locale.Tr "company.data.title"}}
		</h4>

		{{if not .DataEnabled}}
			<div class="ui attached segment">
				<p>{{ctx.Locale.Tr "company.data.disabled_user"}}</p>
			</div>
		{{else if not .HasData}}
			<div class="ui attached segment">
				<p>{{ctx.Locale.Tr "company.data.none_yet"}}</p>
			</div>
		{{else}}
			<div class="ui attached segment">
				{{/* What is stored and how much room is left. A department can act
				     on the second one — by storing less — which is why the number
				     is theirs to see and not only the administrator's. */}}
				{{if .DataUsage}}
					<div class="company-kpis">
						<div class="company-kpi{{if .DataUsage.Full}} full{{else if .DataUsage.Warning}} warn{{end}}">
							<b>{{FormatByteSize .DataUsage.Bytes}}<small>/{{FormatByteSize .DataUsage.QuotaBytes}}</small></b>
							<span>{{ctx.Locale.Tr "company.adminapp.kpi_data"}}</span>
						</div>
					</div>
				{{end}}
				<p class="text-grey tw-text-13 tw-mb-0">{{ctx.Locale.Tr "company.data.edit_note"}}</p>
			</div>

			{{template "company/data_browse" .}}
			{{template "company/data_history" .}}
		{{end}}
	</div>
</div>
{{template "base/footer" .}}

{{/* The copies a change is undone from, and who changed what. Shared with
     the admin console; a department's restore stops and starts the app by
     itself (company/appdataedit.go), an administrator's asks them to. */}}
{{define "company/data_history"}}
	<h4 class="ui attached header">{{ctx.Locale.Tr "company.data.snapshots_header"}}</h4>
	<div class="ui attached segment">
		<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.data.snapshots_explain_dept"}}</p>
		<form method="post" action="{{.DataLink}}/snapshot" class="tw-mb-3">{{.CsrfTokenHtml}}
			<button class="ui small button">{{ctx.Locale.Tr "company.data.take_snapshot"}}</button>
		</form>
		{{if .Snapshots}}
			<table class="ui very basic table tw-text-13">
				<tbody>
					{{range .Snapshots}}
						<tr>
							<td class="tw-font-mono">{{.Name}}</td>
							<td>{{FormatByteSize .Bytes}}</td>
							<td title="{{DateUtils.FullTime .At}}">{{DateUtils.TimeSince .At}}</td>
							<td class="tw-text-right">
								<form method="post" action="{{$.DataLink}}/restore" class="tw-inline" data-company-confirm="{{ctx.Locale.Tr "company.data.restore_confirm_dept"}}">
									{{$.CsrfTokenHtml}}
									<input type="hidden" name="name" value="{{.Name}}">
									<button class="ui tiny button">{{ctx.Locale.Tr "company.data.snapshot_restore_dept"}}</button>
								</form>
							</td>
						</tr>
					{{end}}
				</tbody>
			</table>
		{{else}}
			<p class="text-grey">{{ctx.Locale.Tr "company.data.no_snapshots"}}</p>
		{{end}}
	</div>
	{{template "company/data_changes" .}}
{{end}}

{{define "company/data_changes"}}
	{{if .RecentChanges}}
		<h4 class="ui attached header">{{ctx.Locale.Tr "company.data.changes_header"}}</h4>
		<div class="ui attached segment">
			<table class="ui very basic table tw-text-13">
				<tbody>
					{{range .RecentChanges}}
						<tr>
							<td title="{{DateUtils.FullTime .At}}">{{DateUtils.TimeSince .At}}</td>
							<td>{{.Actor}}</td>
							<td>{{ctx.Locale.Tr .Label .Table .Detail}}</td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>
	{{end}}
{{end}}

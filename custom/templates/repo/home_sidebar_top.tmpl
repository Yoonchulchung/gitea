<!--
	Override of templates/repo/home_sidebar_top.tmpl. Non-admins only:
	- the code-search box is removed (git/code-search jargon, and
	  /{owner}/{repo}/search is blocked for them anyway — see gate.go's
	  isRepoScopedAllow, "search" isn't in the default-allow list... actually
	  it falls to the default case so it IS reachable, but showing a raw
	  code-search box still isn't something this audience needs).
	- an inline "편집" button next to the Description label lets a
	  Write-access (not necessarily repo-Admin) user change the
	  description directly — native Gitea only offers this on the repo
	  Settings page, which requires actual repo-Admin permission
	  (routers/web/web.go's reqRepoAdmin) and is out of reach for a
	  regular department-team member. Posts to company/description.go's
	  UpdateDescription, which uses the same Write-access check as the
	  workspace editor (company/workspace.go's resolveWritableRepo).
	Admins get the complete, unmodified upstream sidebar.
	See docs/company/repo-ui.md.
	Keep this in sync with the upstream file; diff it on every Gitea
	upgrade — see docs/company/architecture.md on custom/templates drift.
-->
{{if .IsAdmin}}
<div class="repo-home-sidebar-top flex-relaxed-list">
	<form class="ignore-dirty tw-flex" action="{{.RepoLink}}/search" method="get">
		<div class="ui small action input tw-flex tw-flex-1">
			<div class="ui input tw-flex tw-flex-1 global-shortcut-wrapper">
				<input name="q" size="10" placeholder="{{ctx.Locale.Tr "search.code_kind"}}">
				<kbd data-global-init="onGlobalShortcut" data-shortcut-keys="s">S</kbd>
			</div>
			{{template "shared/search/button"}}
		</div>
	</form>

	<div class="flex-relaxed-list">
		<div class="repo-home-sidebar-header">{{ctx.Locale.Tr "repo.repo_desc"}}</div>

		<div class="repo-description tw-break-anywhere tw-gap-2">
			{{- $description := .Repository.DescriptionHTML ctx -}}
			{{if $description}}{{$description | RenderCodeBlock}}{{else}}{{ctx.Locale.Tr "repo.repo_no_desc"}}{{end}}
		</div>

		{{if .Repository.Website}}
			<a class="flex-text-block" href="{{.Repository.Website}}">
				{{svg "octicon-link" 16 "tw-text-text"}} <span class="tw-text-primary">{{.Repository.Website}}</span>
			</a>
		{{end}}

		<div id="repo-topics" class="flex-text-block tw-flex-wrap tw-gap-1 tw-my-1 tw-text-text">
			{{/* !!!! it SHOULD and MUST match the code in repo-home.ts */}}
			{{range .Topics}}<a class="repo-topic ui large label gt-ellipsis" title={{.Name}} href="{{AppSubUrl}}/explore/repos?q={{.Name}}&topic=1">{{.Name}}</a>{{end}}
		</div>
		{{if and .Permission.IsAdmin (not .Repository.IsArchived)}}
			<button id="manage_topic" class="btn interact-fg tw-mb-2 tw-text-12">{{ctx.Locale.Tr "repo.topic.manage_topics"}}</button>
			<div class="ui form tw-hidden tw-my-2" id="topic_edit">
				<div class="ui fluid multiple search selection dropdown tw-flex-wrap tw-flex-1">
					<input type="hidden" name="topics" value="{{range $i, $v := .Topics}}{{.Name}}{{if Eval $i "+" 1 "<" (len $.Topics)}},{{end}}{{end}}">
					{{range .Topics}}
						{{/* keep the same layout as Fomantic UI generated labels */}}
						<a class="ui label transition visible tw-cursor-default tw-inline-block repo-topic" data-value="{{.Name}}">{{.Name}}{{svg "octicon-x" 16 "delete icon"}}</a>
					{{end}}
					<div class="text"></div>
				</div>
				<div class="tw-my-2">
					<button class="ui primary button" id="save_topic" data-link="{{.RepoLink}}/topics">{{ctx.Locale.Tr "save"}}</button>
					<button class="ui basic button" id="cancel_topic_edit">{{ctx.Locale.Tr "cancel"}}</button>
				</div>
			</div>
		{{end}}

		{{if .ReadmeExist}}
			<a class="flex-text-block muted" href="{{.RepoLink}}/src/{{.RefTypeNameSubURL}}/{{PathEscapeSegments .FileTreePath}}">
				{{svg "octicon-book"}} {{ctx.Locale.Tr "readme"}}
			</a>
		{{end}}

		{{range $licenseGroup := .LicenseGroups}}
			{{$licenseDisplayName := StringUtils.Join $licenseGroup.LicenseNames ", "}}
			<a class="flex-text-block muted" title="{{$licenseDisplayName}}" href="{{$.RepoLink}}/src/{{$.Repository.DefaultBranch}}/{{PathEscapeSegments $licenseGroup.LicensePath}}">
				{{svg "octicon-law"}} {{$licenseDisplayName}}
			</a>
		{{end}}

		{{if .CitiationExist}}
			{{template "repo/cite/cite_modal" .}}
			<a class="flex-text-block muted" id="cite-repo-button">
				{{svg "octicon-cross-reference"}} {{ctx.Locale.Tr "repo.cite_this_repo"}}
			</a>
		{{end}}
		<div class="flex-text-block muted" {{if not (eq .Repository.Size 0)}}data-tooltip-content="{{.Repository.SizeDetailsString}}"{{end}}>
			{{$fileSizeFormatted := FormatByteSize .Repository.Size}}{{/* the formatted string is always "{val} {unit}" */}}
			{{$fileSizeFields := StringUtils.Split $fileSizeFormatted " "}}
			{{svg "octicon-database"}} <b>{{ctx.Locale.PrettyNumber (index $fileSizeFields 0)}}</b> {{index $fileSizeFields 1}}
		</div>

		{{if not .DisableStars}}
			<a class="flex-text-block muted" href="{{.RepoLink}}/stars">
				{{svg "octicon-star"}} <b>{{CountFmt .Repository.NumStars}}</b> {{ctx.Locale.Tr "repo.stars"}}
			</a>
		{{end}}
		<a class="flex-text-block muted" href="{{.RepoLink}}/watchers">
			{{svg "octicon-eye"}} <b>{{CountFmt .Repository.NumWatches}}</b> {{ctx.Locale.Tr "repo.watchers"}}
		</a>
		<a class="flex-text-block muted" href="{{.RepoLink}}/forks">
			{{svg "octicon-repo-forked"}} <b>{{CountFmt .Repository.NumForks}}</b> {{ctx.Locale.Tr "repo.forks"}}
		</a>
	</div>
</div>
{{else}}
{{$canEditDesc := .Permission.CanWrite ctx.Consts.RepoUnitTypeCode}}
{{/* The app panel, first in the non-admin sidebar. This is the screen a
     non-developer actually opens, so "what is my app doing and what is it
     allowed to do" has to be answered here — anywhere else and it will not
     be found. Rendered only for repositories that have actually been
     deployed (company.SetAppPermissionData sets nothing otherwise), so a
     plain repository's sidebar is unchanged. Admins get the far more
     detailed /-/admin/company-deploys instead, which is why this lives only
     in the {{else}} branch. */}}
<div class="repo-home-sidebar-top flex-relaxed-list">
	{{/* Inside the existing sidebar block, never as a sibling of it:
	     .repo-home-sidebar-top is placed explicitly at grid-row 1 /
	     grid-column 2 (web_src/css/repo/home.css), so a second element with
	     that class lands in the same cell and draws on top of the first. */}}
	{{with .CompanyApp}}
	{{if not .Deployed}}
		{{/* Never deployed. The settings behind [앱 관리] — access mode,
		     environment variables, the permission request — all work before a
		     first deploy and are most useful then; without this row the only
		     way to find that screen was to already know its URL. One quiet
		     row, so a repository that never becomes an app is not shouting
		     about one. */}}
		<div class="flex-relaxed-list company-app-panel">
			<div class="repo-home-sidebar-header flex-text-block tw-justify-between">
				<span>{{ctx.Locale.Tr "company.sidebar.app"}}</span>
				<span class="text-grey tw-text-12 tw-font-normal">{{ctx.Locale.Tr "company.sidebar.not_deployed"}}</span>
			</div>
			{{if .CanControl}}
				<div class="tw-flex tw-gap-2 tw-flex-wrap">
					<a class="ui compact tiny basic button" href="{{.AppLink}}">{{ctx.Locale.Tr "company.app.title"}}</a>
					<a class="ui compact tiny basic button" href="{{.DeployLink}}">{{ctx.Locale.Tr "company.app.request_deploy"}}</a>
				</div>
			{{end}}
		</div>
	{{else}}
	<div class="flex-relaxed-list company-app-panel">
		<div class="repo-home-sidebar-header flex-text-block tw-justify-between">
			<span>{{ctx.Locale.Tr "company.sidebar.app"}}</span>
			<span class="tw-flex tw-items-center tw-gap-2">
				{{/* Beside the state rather than inside the message: "it broke" and
				     "it broke four minutes ago" are both about the state, and this
				     way the time is visible without reading the whole panel. */}}
				{{with .Cause}}{{if .At}}
					<span class="text-grey tw-text-12 tw-font-normal" data-tooltip-content="{{DateUtils.AbsoluteShort .At}}">{{DateUtils.TimeSince .At}}</span>
				{{end}}{{end}}
				{{if and $.CompanyApp.Running $.CompanyApp.StartedAt}}
					<span class="text-grey tw-text-12 tw-font-normal" data-tooltip-content="{{DateUtils.AbsoluteShort $.CompanyApp.StartedAt}}">{{ctx.Locale.Tr "company.sidebar.started_ago" (DateUtils.TimeSince $.CompanyApp.StartedAt)}}</span>
				{{end}}
				<span class="company-app-state {{$.CompanyApp.Status}}">{{ctx.Locale.Tr $.CompanyApp.StatusLabel}}</span>
			</span>
		</div>

		{{with .Cause}}
			{{/* Only rendered when something is actually wrong. */}}
			<div class="company-app-cause">
				{{/* Summary and Detail are locale keys; DetailText is verbatim
				     data (an admin's words, a pip line) and is never translated. */}}
				<div class="tw-font-semibold">{{ctx.Locale.Tr .Summary}}</div>
				{{if .Detail}}<div class="tw-text-12 tw-mt-1 company-app-cause-line">{{ctx.Locale.Tr .Detail .DetailArg}}</div>{{end}}
				{{range StringUtils.Split .DetailText "\n"}}<div class="tw-text-12 tw-mt-1 company-app-cause-line">{{.}}</div>{{end}}
			</div>
		{{end}}

		<a class="flex-text-block muted" href="{{AppSubUrl}}{{.AppURL}}" target="_blank" rel="noopener">
			{{svg "octicon-link-external"}} {{ctx.Locale.Tr "company.sidebar.open_app"}}
		</a>

		<div class="repo-home-sidebar-header flex-text-block"><span>{{ctx.Locale.Tr "company.sidebar.perms"}}</span></div>
		{{range .Rows}}
			<div class="company-perm-row {{.State}}">
				<span class="company-perm-label">{{ctx.Locale.Tr .Label}}</span>
				<span class="company-perm-value">{{if .Value}}{{ctx.Locale.Tr .Value}}{{end}}{{.ValueText}}</span>
				{{/* The reason is the point of showing a denial at all: without it
				     the person still has to go and ask an administrator. */}}
				{{if or .Reason .ReasonText}}<span class="company-perm-reason">{{if .Reason}}{{ctx.Locale.Tr .Reason}}{{end}} {{.ReasonText}}</span>{{end}}
			</div>
		{{end}}

		{{if .MemoryLimit}}
			{{/* Usage next to the limit, not the limit alone — otherwise nobody
			     has grounds to judge whether to ask for more. */}}
			<div class="company-perm-row allowed">
				<span class="company-perm-label">{{ctx.Locale.Tr "company.sidebar.memory"}}</span>
				{{/* A dash, not a zero, where nothing measured it. */}}
				<span class="company-perm-value">{{if .MemoryMeasured}}{{ctx.Locale.Tr "company.sidebar.memory_used" .MemoryUsed .MemoryLimit}}{{else}}{{ctx.Locale.Tr "company.sidebar.memory_limit" .MemoryLimit}}{{end}}</span>
			</div>
		{{end}}

		<div class="tw-flex tw-gap-2 tw-mt-2 tw-flex-wrap">
			<a class="ui tiny basic button" href="{{.AppLink}}">{{ctx.Locale.Tr "company.app.title"}}</a>
			{{/* Straight to the logs from the panel that just said something is
			     wrong — the next question after "why" is always "show me". */}}
			{{if .CanControl}}<a class="ui tiny basic button" href="{{.AppLink}}/logs">{{ctx.Locale.Tr "company.app.logs"}}</a>{{end}}
			<a class="ui tiny basic button" href="{{.DeployLink}}">{{ctx.Locale.Tr "company.app.request_permission"}}</a>
		</div>
	</div>
	{{end}}
	{{end}}
	<div class="flex-relaxed-list">
		<div class="repo-home-sidebar-header flex-text-block tw-justify-between">
			<span>{{ctx.Locale.Tr "repo.repo_desc"}}</span>
			{{if $canEditDesc}}
			<button type="button" class="btn interact-fg tw-text-12" id="company-desc-edit-btn">{{ctx.Locale.Tr "edit"}}</button>
			{{end}}
		</div>

		<div class="repo-description tw-break-anywhere tw-gap-2" id="company-desc-view">
			{{- $description := .Repository.DescriptionHTML ctx -}}
			{{if $description}}{{$description | RenderCodeBlock}}{{else}}{{ctx.Locale.Tr "repo.repo_no_desc"}}{{end}}
		</div>

		{{if $canEditDesc}}
		<div class="tw-hidden" id="company-desc-edit-panel">
			<textarea id="company-desc-textarea" rows="4" class="tw-w-full" maxlength="2048" data-original="{{.Repository.Description}}">{{.Repository.Description}}</textarea>
			<div class="flex-text-block tw-mt-1">
				<button type="button" class="ui primary tiny button" id="company-desc-save">{{ctx.Locale.Tr "save"}}</button>
				<button type="button" class="ui basic tiny button" id="company-desc-cancel">{{ctx.Locale.Tr "cancel"}}</button>
			</div>
		</div>
		<script nonce="{{ctx.CspScriptNonce}}">
		(function () {
			var editBtn = document.getElementById('company-desc-edit-btn');
			var view = document.getElementById('company-desc-view');
			var panel = document.getElementById('company-desc-edit-panel');
			var textarea = document.getElementById('company-desc-textarea');
			var saveBtn = document.getElementById('company-desc-save');
			var cancelBtn = document.getElementById('company-desc-cancel');

			function openEdit() {
				view.classList.add('tw-hidden');
				editBtn.classList.add('tw-hidden');
				panel.classList.remove('tw-hidden');
				textarea.focus();
			}
			function closeEdit() {
				panel.classList.add('tw-hidden');
				view.classList.remove('tw-hidden');
				editBtn.classList.remove('tw-hidden');
			}

			editBtn.addEventListener('click', openEdit);
			cancelBtn.addEventListener('click', function () {
				textarea.value = textarea.dataset.original;
				closeEdit();
			});
			saveBtn.addEventListener('click', function () {
				saveBtn.disabled = true;
				fetch('{{AppSubUrl}}/company/repo-description/{{.Repository.OwnerName}}/{{.Repository.Name}}', {
					method: 'POST',
					headers: {'Content-Type': 'application/json'},
					body: JSON.stringify({description: textarea.value}),
				}).then(function (resp) {
					if (!resp.ok) throw new Error(String(resp.status));
					window.location.reload();
				}).catch(function () {
					saveBtn.disabled = false;
					window.alert({{ctx.Locale.Tr "error.occurred"}});
				});
			});
		})();
		</script>
		{{end}}

		{{if .Repository.Website}}
			<a class="flex-text-block" href="{{.Repository.Website}}">
				{{svg "octicon-link" 16 "tw-text-text"}} <span class="tw-text-primary">{{.Repository.Website}}</span>
			</a>
		{{end}}

		<div id="repo-topics" class="flex-text-block tw-flex-wrap tw-gap-1 tw-my-1 tw-text-text">
			{{/* !!!! it SHOULD and MUST match the code in repo-home.ts */}}
			{{range .Topics}}<a class="repo-topic ui large label gt-ellipsis" title={{.Name}} href="{{AppSubUrl}}/explore/repos?q={{.Name}}&topic=1">{{.Name}}</a>{{end}}
		</div>

		{{if .ReadmeExist}}
			<a class="flex-text-block muted" href="{{.RepoLink}}/src/{{.RefTypeNameSubURL}}/{{PathEscapeSegments .FileTreePath}}">
				{{svg "octicon-book"}} {{ctx.Locale.Tr "readme"}}
			</a>
		{{end}}

		{{range $licenseGroup := .LicenseGroups}}
			{{$licenseDisplayName := StringUtils.Join $licenseGroup.LicenseNames ", "}}
			<a class="flex-text-block muted" title="{{$licenseDisplayName}}" href="{{$.RepoLink}}/src/{{$.Repository.DefaultBranch}}/{{PathEscapeSegments $licenseGroup.LicensePath}}">
				{{svg "octicon-law"}} {{$licenseDisplayName}}
			</a>
		{{end}}

		{{if .CitiationExist}}
			{{template "repo/cite/cite_modal" .}}
			<a class="flex-text-block muted" id="cite-repo-button">
				{{svg "octicon-cross-reference"}} {{ctx.Locale.Tr "repo.cite_this_repo"}}
			</a>
		{{end}}
		<div class="flex-text-block muted" {{if not (eq .Repository.Size 0)}}data-tooltip-content="{{.Repository.SizeDetailsString}}"{{end}}>
			{{$fileSizeFormatted := FormatByteSize .Repository.Size}}{{/* the formatted string is always "{val} {unit}" */}}
			{{$fileSizeFields := StringUtils.Split $fileSizeFormatted " "}}
			{{svg "octicon-database"}} <b>{{ctx.Locale.PrettyNumber (index $fileSizeFields 0)}}</b> {{index $fileSizeFields 1}}
		</div>
	</div>
</div>
{{end}}

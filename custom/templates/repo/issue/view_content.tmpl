<div class="issue-content{{if .IsDeployRequest}} company-deploy-review-page{{end}}">
	{{$createdStr:= DateUtils.TimeSince .Issue.CreatedUnix}}
	<div class="issue-content-left">
		<div class="comment-list">
			<div id="{{.Issue.HashTag}}" class="timeline-item comment issue-content-comment">
				{{/* A Deploy Request is opened by the central repository's owner
				     on the department's behalf (company/deploy.go); the person who
				     asked is who the page names. */}}
				{{if $.DeployRequester}}
				<a class="timeline-avatar" href="{{$.DeployRequester.HomeLink}}">
					{{ctx.AvatarUtils.Avatar $.DeployRequester 40}}
				</a>
				{{else if .Issue.OriginalAuthor}}
				<span class="timeline-avatar">
					{{ctx.AvatarUtils.Avatar nil 40}}
				</span>
				{{else}}
				<a class="timeline-avatar" {{if gt .Issue.Poster.ID 0}}href="{{.Issue.Poster.HomeLink}}"{{end}}>
					{{ctx.AvatarUtils.Avatar .Issue.Poster 40}}
				</a>
				{{end}}
				<div class="content comment-container">
					<div class="comment-header avatar-content-left-arrow" role="heading" aria-level="3">
						<div class="comment-header-left">
							{{if $.DeployRequester}}
								<a class="inline-timeline-avatar" href="{{$.DeployRequester.HomeLink}}">
									{{ctx.AvatarUtils.Avatar $.DeployRequester 24}}
								</a>
								<span class="tw-text-text-light muted-links">
									{{template "shared/user/authorlink" $.DeployRequester}}
									{{ctx.Locale.Tr "repo.issues.commented_at" .Issue.HashTag $createdStr}}
								</span>
							{{else if .Issue.OriginalAuthor}}
								<span class="tw-text-text tw-font-semibold">
									{{svg (MigrationIcon .Repository.GetOriginalURLHostname)}}
									{{.Issue.OriginalAuthor}}
								</span>
								<span class="tw-text-text-light muted-links">
									{{ctx.Locale.Tr "repo.issues.commented_at" .Issue.HashTag $createdStr}}
								</span>
								<span class="text migrate">
									{{if .Repository.OriginalURL}} ({{ctx.Locale.Tr "repo.migrated_from" .Repository.OriginalURL .Repository.GetOriginalURLHostname}}){{end}}
								</span>
							{{else}}
								<a class="inline-timeline-avatar" href="{{.Issue.Poster.HomeLink}}">
									{{ctx.AvatarUtils.Avatar .Issue.Poster 24}}
								</a>
								<span class="tw-text-text-light muted-links">
									{{template "shared/user/authorlink" .Issue.Poster}}
									{{ctx.Locale.Tr "repo.issues.commented_at" .Issue.HashTag $createdStr}}
								</span>
							{{end}}
						</div>
						<div class="comment-header-right">
							{{if not $.IsDeployRequest}}{{template "repo/issue/view_content/show_role" dict "ShowRole" .Issue.ShowRole "IgnorePoster" true}}{{end}}
							{{if not $.Repository.IsArchived}}
								{{template "repo/issue/view_content/add_reaction" dict "ActionURL" (printf "%s/issues/%d/reactions" $.RepoLink .Issue.Index)}}
							{{end}}
							{{template "repo/issue/view_content/context_menu" dict "item" .Issue "delete" false "issue" true "diff" false "IsCommentPoster" $.IsIssuePoster}}
						</div>
					</div>
					<div class="ui attached segment comment-body" role="article">
						<div class="render-content markup" {{if or $.Permission.IsAdmin $.HasIssuesOrPullsWritePermission $.IsIssuePoster}}data-can-edit="true"{{end}}>
							{{if $.IsDeployRequest}}
								{{if $.DeployRequestMessage}}<p class="tw-whitespace-pre-wrap">{{$.DeployRequestMessage}}</p>{{else}}<span class="no-content">{{ctx.Locale.Tr "repo.issues.no_content"}}</span>{{end}}
							{{else if .Issue.RenderedContent}}
								{{.Issue.RenderedContent}}
							{{else}}
								<span class="no-content">{{ctx.Locale.Tr "repo.issues.no_content"}}</span>
							{{end}}
						</div>
						<div id="{{.Issue.HashTag}}-raw" class="raw-content tw-hidden">{{.Issue.Content}}</div>
						<div class="edit-content-zone tw-hidden" data-update-url="{{$.RepoLink}}/issues/{{.Issue.Index}}/content" data-content-version="{{.Issue.ContentVersion}}" data-context="{{.RepoLink}}" data-attachment-url="{{$.RepoLink}}/issues/{{.Issue.Index}}/attachments" data-view-attachment-url="{{$.RepoLink}}/issues/{{.Issue.Index}}/view-attachments"></div>
						{{if .Issue.Attachments}}
							{{template "repo/issue/view_content/attachments" dict "Attachments" .Issue.Attachments "RenderedContent" .Issue.RenderedContent}}
						{{end}}
					</div>
					{{$reactions := .Issue.Reactions.GroupByType}}
					{{if $reactions}}
						{{template "repo/issue/view_content/reactions" dict "ActionURL" (printf "%s/issues/%d/reactions" $.RepoLink .Issue.Index) "Reactions" $reactions}}
					{{end}}
				</div>
			</div>

			{{template "repo/issue/view_content/comments" .}}
			<div class="timeline-item tw-hidden" id="timeline-comments-end"></div>

			{{/* Above "Approve deploy", because it is what somebody does before
			     deciding, not after. Deploy Request PRs on the central deploy
			     repository only — company/pull_ai_review.go's
			     SetDeployRequestPageData decides which of these two (if either)
			     is set. Its own form, never inside another one: HTML forms
			     cannot nest, and the comment form's fetch-action JS used to
			     swallow this button's submit. */}}
			{{if or .ShowDeployAIReview .ShowDeployAIReviewSetup}}
				<div class="timeline-item comment company-deploy-aireview">
					<div class="timeline-avatar">{{svg "octicon-sparkle-fill" 40}}</div>
					<div class="content">
						<div class="ui segment avatar-content-left-arrow tw-flex tw-items-center tw-justify-between tw-flex-wrap tw-gap-2">
							{{/* A review takes tens of seconds; while one runs this says so and
							     keeps count, and the page reloads when its comments land
							     (company/ai_review_progress.go). */}}
							{{$review := .DeployAIReviewStatus}}
							{{$pending := .DeployAIReviewPending}}
							{{if and $pending (not (and $review (eq $review.Phase "running")))}}
							{{/* The AI auto-deploy is deciding this request: the review waits for it.
							     Forcing it stops the auto-deploy first (company/pull_ai_review.go). */}}
							<div class="flex-text-block tw-flex-1">
								<span class="text-grey">{{svg "octicon-clock" 16}}</span>
								<div>
									<strong class="tw-text-14">{{ctx.Locale.Tr "company.pulls.ai_review_pending"}}</strong>
									<div class="text-grey tw-text-12">
										{{if eq $pending.Phase "waiting"}}{{ctx.Locale.Tr "company.pulls.ai_review_pending_countdown" (HTMLFormat `<span class="company-auto-approve-seconds">%d</span>` $pending.SecondsLeft)}}{{else}}{{ctx.Locale.Tr "company.pulls.ai_review_pending_reviewing"}}{{end}}
									</div>
								</div>
							</div>
							<form method="post" action="{{.DeployAIReviewURL}}" data-company-confirm="{{ctx.Locale.Tr "company.pulls.ai_review_force_confirm"}}">
								<input type="hidden" name="force" value="true">
								<button type="submit" class="ui basic button">{{svg "octicon-zap" 14 "tw-mr-1"}}{{ctx.Locale.Tr "company.pulls.ai_review_force"}}</button>
							</form>
							{{else if and $review (eq $review.Phase "running")}}
							<div class="flex-text-block tw-flex-1" data-global-init="initCompanyAIReviewProgress" data-status-url="{{.DeployAIReviewURL}}" data-started-at="{{$review.StartedAt}}"
							     data-i18n-part="{{ctx.Locale.Tr "company.pulls.ai_review_part" "%s" "%s"}}">
								<span class="text-primary">{{svg "octicon-sync" 16 "rotate-clockwise"}}</span>
								<div>
									<strong class="tw-text-14">{{ctx.Locale.Tr "company.pulls.ai_review_running"}}</strong>
									<div class="text-grey tw-text-12">
										{{ctx.Locale.Tr "company.pulls.ai_review_elapsed" (HTMLFormat `<span class="company-aireview-elapsed">%d</span>` 0)}}
										· {{if $review.By}}{{ctx.Locale.Tr "company.pulls.ai_review_by" $review.By}}{{else}}{{ctx.Locale.Tr "company.pulls.ai_review_auto"}}{{end}}
										<span class="company-aireview-parts">{{if gt $review.Total 1}}· {{ctx.Locale.Tr "company.pulls.ai_review_part" $review.Done $review.Total}}{{end}}</span>
									</div>
								</div>
							</div>
							{{else}}
							<span class="text-grey tw-text-13">
								{{ctx.Locale.Tr "company.pulls.ai_review_hint"}}
								{{if and $review (eq $review.Phase "failed")}}<br><span class="text-red">{{ctx.Locale.Tr "company.pulls.ai_review_failed" $review.Failed}}</span>{{end}}
							</span>
							{{end}}
							{{if or $pending (and $review (eq $review.Phase "running"))}}
							{{else if .ShowDeployAIReview}}
								<form method="post" action="{{.DeployAIReviewURL}}">
									<button type="submit" class="ui basic button">{{ctx.Locale.Tr "company.pulls.ai_review"}}</button>
								</form>
							{{else}}
								{{/* Same PR, but the viewing admin hasn't got their own AI key
								     registered yet — say so instead of just not showing
								     anything with no explanation. */}}
								<a href="{{.DeployAIReviewSetupURL}}" class="ui basic button">{{ctx.Locale.Tr "company.pulls.ai_review_setup"}}</a>
							{{end}}
						</div>
					</div>
				</div>
			{{end}}

			{{if and .Issue.IsPull (not $.Repository.IsArchived)}}
				{{template "repo/issue/view_content/pull_merge_box".}}
			{{end}}

			{{/* The other half of the decision. "Approve deploy" is the merge
			     box above; turning the request down is this, and it goes
			     through the same endpoint as the department's own cancel so
			     the comment, the status and the dashboard agree whichever
			     screen it was pressed on (company/deployrequests.go). See
			     docs/company/central-repo-ui.md. */}}
			{{if and .IsDeployRequest (not .Issue.IsClosed)}}
				{{/* Same shape as the merge box above it — avatar in the gutter,
				     arrowed segment in the content column — so the two decisions
				     read as a pair rather than one of them falling out of the
				     timeline. */}}
				<div class="timeline-item comment company-deploy-cancel">
					<div class="timeline-avatar">{{svg "octicon-x-circle" 40}}</div>
					<div class="content">
						<div class="ui segment avatar-content-left-arrow">
							<h4 class="tw-mt-0 tw-mb-1">{{ctx.Locale.Tr "company.review.cancel_header"}}</h4>
							<p class="text-grey tw-text-13">{{ctx.Locale.Tr "company.review.cancel_explain"}}</p>
							{{/* ignore-dirty: the reason is submitted, not abandoned, so
							     the browser's "leave without saving?" prompt is asking
							     about something that is being saved. */}}
							<form method="post" action="{{.DeployCancelURL}}" class="ui form ignore-dirty">
								{{.CsrfTokenHtml}}
								<div class="field">
									<textarea name="reason" rows="2" required
										placeholder="{{ctx.Locale.Tr "company.deploy_requests.cancel_reason_placeholder"}}"></textarea>
								</div>
								<button type="submit" class="ui red button">{{ctx.Locale.Tr "company.deploy_requests.cancel_confirm"}}</button>
							</form>
						</div>
					</div>
				</div>
			{{end}}

			{{if .IsSigned}}
				{{/* On a Deploy Request there is nothing to put in this timeline
				     item — the comment box is gone — and rendering it anyway left
				     the avatar hanging on its own at the foot of the page, an icon
				     attached to nothing. */}}
				{{if and (not $.IsDeployRequest) (or .IsRepoAdmin .HasIssuesOrPullsWritePermission (not .Issue.IsLocked)) (not .Repository.IsArchived)}}
				<div class="timeline-item comment form">
					<a class="timeline-avatar" href="{{.SignedUser.HomeLink}}">
						{{ctx.AvatarUtils.Avatar .SignedUser 40}}
					</a>
					<div class="content">
						{{/* A Deploy Request is decided with "Approve deploy" or
						     "Cancel request", both above; the read-only assistant on
						     the right answers what a reviewer wants to ask. A Markdown
						     comment box is git vocabulary for somebody who has never
						     opened a pull request, and nothing on this page needs it.
						     See docs/company/central-repo-ui.md. */}}
						{{if not $.IsDeployRequest}}
						<div class="ui segment avatar-content-left-arrow">
							<form class="ui form form-fetch-action" id="comment-form" action="{{$.RepoLink}}/issues/{{.Issue.Index}}/comments" method="post">
								{{template "repo/issue/comment_tab" .}}
								<div class="field footer">
									<div class="flex-text-block tw-justify-end">
										{{/* Closing a Deploy Request is "Cancel request" above, which
										     takes a reason and records the cancellation; reopening one
										     would leave a request the department's record calls
										     cancelled. Neither belongs on the comment box. */}}
										{{if and (not $.IsDeployRequest) (or .HasIssuesOrPullsWritePermission .IsIssuePoster) (not .DisableStatusChange)}}
											{{$btnIconColor := ""}}{{$btnIcon := ""}}{{$btnTextNoComment := ""}}{{$btnTextWithComment := ""}}{{$btnValue := ""}}
											{{if .Issue.IsClosed}}
												{{$btnValue = "reopen"}}
												{{$btnIconColor = "tw-text-green"}}
												{{$btnIcon = Iif .Issue.IsPull "octicon-git-pull-request" "octicon-issue-reopened"}}
												{{$btnTextNoComment = ctx.Locale.Tr (Iif .Issue.IsPull "repo.pulls.reopen" "repo.issues.reopen_issue")}}
												{{$btnTextWithComment = ctx.Locale.Tr "repo.issues.reopen_comment_issue"}}{{/* general: Reopen with Comment */}}
											{{else}}
												{{$btnValue = "close"}}
												{{$btnIconColor = "tw-text-red"}}
												{{$btnIcon = Iif .Issue.IsPull "octicon-git-pull-request-closed" "octicon-issue-closed"}}
												{{$btnTextNoComment = ctx.Locale.Tr (Iif .Issue.IsPull "repo.pulls.close" "repo.issues.close")}}
												{{$btnTextWithComment = ctx.Locale.Tr "repo.issues.close_comment_issue"}}{{/* general: Close with Comment */}}
											{{end}}
											<button id="status-button" class="ui button" data-status="{{$btnTextNoComment}}" data-status-and-comment="{{$btnTextWithComment}}" name="status" value="{{$btnValue}}">
												<span class="status-button-icon {{$btnIconColor}}">{{svg $btnIcon}}</span>
												<span class="status-button-text">{{$btnTextNoComment}}</span>
											</button>
										{{end}}
										<button id="comment-button" class="ui primary button">
											{{ctx.Locale.Tr "repo.issues.create_comment"}}
										</button>
									</div>
								</div>
							</form>
						</div>
						{{end}}
					</div>
				</div>
				{{else if .Repository.IsArchived}}
					<div class="ui warning message tw-text-center">
						{{if .Issue.IsPull}}
							{{ctx.Locale.Tr "repo.archive.pull.nocomment"}}
						{{else}}
							{{ctx.Locale.Tr "repo.archive.issue.nocomment"}}
						{{end}}
					</div>
				{{end}}
			{{else}} {{/* not .IsSigned */}}
				{{if .Repository.IsArchived}}
					<div class="ui warning message tw-text-center">
						{{if .Issue.IsPull}}
							{{ctx.Locale.Tr "repo.archive.pull.nocomment"}}
						{{else}}
							{{ctx.Locale.Tr "repo.archive.issue.nocomment"}}
						{{end}}
					</div>
				{{else}}
					<div class="ui warning message">
						{{ctx.Locale.Tr "repo.issues.sign_in_require_desc" .SignInLink}}
					</div>
				{{end}}
			{{end}}{{/* end if: .IsSigned */}}
		</div>
	</div>

	{{/* A Deploy Request is approved by someone who is not a developer:
	     the native sidebar's reviewers/milestone/assignees/due date are
	     noise to them, and what they need — the request, its permissions,
	     its packages, a way to ask — is in the company one. See
	     company/deploy_review.go. */}}
	{{if .IsDeployRequest}}
		{{template "company/deploy_review_sidebar" .}}
	{{else if .Issue.IsPull}}
		{{/* Any other pull request on this instance is read by the same
		     people: labels are the one thing on Gitea's sidebar they use. */}}
		<div class="issue-content-right ui segment" data-global-init="initRepoIssueSidebar">
			{{template "repo/issue/sidebar/label_list" $.IssuePageMetaData}}
			{{template "repo/issue/sidebar/reference_link" $}}
		</div>
	{{else}}
		{{template "repo/issue/view_content/sidebar" .}}
	{{end}}
</div>

<template id="issue-comment-editor-template">
	<form class="ui form comment">
		<div class="field">
			{{template "shared/combomarkdowneditor" (dict
				"CustomInit" true
				"MarkdownEditorContext" (ctx.MiscUtils.MarkdownEditorComment $.Repository)
				"TextareaName" "content"
				"DropzoneParentContainer" ".ui.form"
			)}}
		</div>

		{{if .IsAttachmentEnabled}}
			<div class="field">
				{{template "repo/upload" .}}
			</div>
		{{end}}

		<div class="field">
			<div class="flex-text-block tw-justify-end">
				<button type="button" class="ui cancel button">{{ctx.Locale.Tr "repo.issues.cancel"}}</button>
				<button type="submit" class="ui primary button">{{ctx.Locale.Tr "repo.issues.save"}}</button>
			</div>
		</div>
	</form>
</template>

{{template "repo/issue/view_content/reference_issue_dialog" .}}
{{template "shared/user/block_user_dialog" .}}

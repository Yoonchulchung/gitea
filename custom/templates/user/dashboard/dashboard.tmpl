{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard feeds">
	{{template "user/dashboard/navbar" .}}
	<div class="ui container flex-container">
		<div class="flex-container-main">
			{{template "base/alert" .}}
			{{template "user/heatmap" .}}
			{{if .Page.Paginator.TotalPages}}
				{{template "user/dashboard/feeds" .}}
			{{else}}
				{{template "user/dashboard/guide" .}}
			{{end}}
		</div>
		{{/* Both blocks share one sidebar column. .flex-container-sidebar is
		     `width: 35%`, so leaving it on each of them made them two columns
		     side by side and the page three columns wide — the wrapper carries
		     it now and repolist's own copy is widened to fill (see
		     custom/header.tmpl).

		     A repository is not an app: most never become one, and the ones
		     that do say nothing in that list about whether they are up. "Is our
		     thing running?" is the question people here ask most, and until now
		     it took opening repositories one at a time to answer. See
		     company/dashboard_apps.go. */}}
		<div class="flex-container-sidebar company-dashboard-sidebar">
			{{template "user/dashboard/repolist" .}}
			{{template "company/dashboard_apps" .}}
		</div>
	</div>
</div>
{{template "base/footer" .}}

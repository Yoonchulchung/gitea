<!--
	Gitea's own extension point (templates/custom/header.tmpl is empty by
	default, included from templates/base/head.tmpl) — not a core file
	override, so nothing to diff against upstream here.

	Hides the repo-list filter tabs (All/Sources/Forks/Mirrors/Collaborative,
	web_src/js/components/DashboardRepoList.vue) for non-admins via CSS
	rather than editing the Vue component: no frontend rebuild needed for
	this or future tweaks, and "All" is already the functional default
	(reposFilter defaults to 'all' with no query param) — this just removes
	the ability to switch away from it. See docs/company/repo-ui.md.
-->
{{if not .IsAdmin}}
<style>
.repos-filter { display: none !important; }
/* .repos-filter used to supply the gap below the search box; restore it
   now that the tab bar itself is hidden. padding, not margin — .repos-search
   is a Fomantic "attached" segment flush against the repo list segment
   below it, and a margin would crack that seam open rather than just add
   breathing room. Scoped under #dashboard-repo-list (the Vue mount point,
   templates/user/dashboard/repolist.tmpl) for specificity, not just
   !important: DashboardRepoList.vue's own scoped style ships
   `.repos-search[data-v-xxx]{padding-bottom:0!important}`, which already
   beats a plain `.repos-search{...!important}` on specificity (class+attr
   > class) regardless of cascade order — only an ID-anchored selector
   reliably outranks it. */
#dashboard-repo-list .repos-search { padding-bottom: 1em !important; }
/* archived/private filter dropdown next to the search box — hiding it leaves
   the input as half of a "joined action input", which Fomantic draws with no
   right edge at all: the trailing button is supposed to supply that corner
   and that border.

   Both halves have to be undone. `border-right-color: transparent` is the
   rule people find first, but a second rule sets `border-right: none`, so
   restoring only the colour leaves a border of zero width and the box still
   reads as cut off on the right. */
.repos-search .ui.dropdown.icon.button { display: none !important; }
.repos-search .ui.action.input > input {
	border-top-right-radius: .28571429rem !important;
	border-bottom-right-radius: .28571429rem !important;
	border-right: 1px solid var(--color-input-border) !important;
}
/* Focus keeps Fomantic's own accent rather than reverting to the grey above. */
.repos-search .ui.action.input > input:focus {
	border-right-color: var(--color-primary) !important;
}
/* advanced repo-create fields (custom/templates/repo/create.tmpl) — kept in
   the DOM (repo-new.ts does non-null querySelector lookups on them), only
   hidden visually. See docs/company/repo-ui.md. */
.company-hide-nonadmin { display: none !important; }
</style>
{{end}}
<style>
/* Deploy Request status badge — custom/templates/repo/view_content.tmpl,
   web_src/js/features/company-deploy-status.ts. Shown for everyone, not
   just non-admins, so this block is unconditional (no admin-only guard). */
/* Squared off rather than a capsule. 1rem on a badge this wide rounds the
   ends into a lozenge, which reads as decoration; the same 4px the panels,
   buttons and inputs around it use reads as a label attached to the thing it
   describes. Same radius on .company-app-state below, for the same reason. */
.company-deploy-status-badge {
	display: inline-flex;
	align-items: center;
	padding: .2rem .6rem;
	border-radius: 4px;
	font-size: .8rem;
	font-weight: 600;
	white-space: nowrap;
}
.company-deploy-status-badge.pending { background: var(--color-warning-bg); color: var(--color-warning-text); }
.company-deploy-status-badge.approved { background: var(--color-success-bg); color: var(--color-success-text); }
/* only "rejected" ever gets a data-tooltip-content (the rejection reason,
   set by company-deploy-status.ts) — cursor:help hints there's more to see */
.company-deploy-status-badge.rejected { background: var(--color-error-bg); color: var(--color-error-text); cursor: help; }
.company-deploy-status-badge.cancelled { background: var(--color-secondary); color: var(--color-text); }
.company-deploy-status-badge.deploying { background: var(--color-warning-bg); color: var(--color-warning-text); }
.company-deploy-status-badge.deployed { background: var(--color-success-bg); color: var(--color-success-text); }
/* same treatment as .rejected: a failed deploy also has a reason worth hovering for */
.company-deploy-status-badge.deploy_failed { background: var(--color-error-bg); color: var(--color-error-text); cursor: help; }
</style>

<style>
/* Deployed-app platform — the repo sidebar panel, the department app screen
   and the admin dashboards. See docs/company/app-platform.md. */
.company-app-state {
	display: inline-flex;
	align-items: center;
	padding: .15rem .5rem;
	border-radius: 4px;
	font-size: .82rem;
	font-weight: 600;
	white-space: nowrap;
	background: var(--color-secondary);
	color: var(--color-text);
}
.company-app-state.running { background: var(--color-success-bg); color: var(--color-success-text); }
.company-app-state.failed,
.company-app-state.suspended { background: var(--color-error-bg); color: var(--color-error-text); }
.company-app-state.queued,
.company-app-state.building,
.company-app-state.activating { background: var(--color-warning-bg); color: var(--color-warning-text); }

/* The panel stays quiet when nothing is wrong. When something is, the status
   badge and the coloured cause box already say so — a third marker on the
   same block was noise rather than emphasis. */
.company-app-cause {
	background: var(--color-error-bg);
	color: var(--color-error-text);
	border-radius: 4px;
	padding: 8px 10px;
	font-size: .9rem;
	/* A failure message is not under this panel's control — a package name or
	   a pip error can be arbitrarily long and has no spaces to wrap at. Left
	   alone it widens the sidebar column and pushes the page apart. */
	min-width: 0;
	max-height: 14em;
	overflow-y: auto;
	overflow-wrap: anywhere;
}
/* Each line of a multi-line cause is its own element. `white-space: pre-wrap`
   was doing this instead, which also preserved the template's own indentation
   and turned it into visible blank space. */
.company-app-cause-line + .company-app-cause-line { margin-top: 2px; }
/* The detail sits one step under the summary above it, not two: it is the
   half that says what to do. */
.company-app-cause-line { font-size: .86rem; }
/* The environment editor. Semantic UI's table gives a cell its content's
   width, so an input sized by its default `size` attribute left a wide empty
   gutter beside every field — the name and value columns share the row and
   the only narrow column is the one holding a checkbox. */
.company-env-table { table-layout: fixed; }
.company-env-table th,
.company-env-table td { padding: 6px 8px; }
.company-env-table .company-env-select { width: 2.5rem; text-align: center; }
.company-env-table input[type="text"],
.company-env-table input[type="password"] { width: 100%; }
/* A stored name cannot be edited — only added or deleted — so it is shown as
   a fact rather than as a field inviting a change that would not be saved. */
/* The time each line arrived. Dimmed and fixed-width so the eye runs down the
   messages and reaches for the times only when connecting one to a deploy. */
/* The dashboard's deployed-app panel. Sits under the repository list in the
   same sidebar column, so it takes that column's width and its own spacing
   rather than the list's. */
/* One sidebar column holding both blocks. The wrapper is the 35% column;
   repolist ships .flex-container-sidebar on its own root, which would
   otherwise make it 35% *of* the column. */
.company-dashboard-sidebar > #dashboard-repo-list { width: 100%; }
.company-dashboard-apps { margin-top: 1em; }
.company-dashboard-deploys { margin-bottom: 1em; }
.company-dashboard-deploy {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
}
.company-dashboard-deploy-main { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.company-dashboard-deploy-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.company-dashboard-apps-head {
	display: flex;
	align-items: center;
	justify-content: space-between;
	background: var(--color-box-header);
}
.company-dashboard-app {
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 8px 12px !important;
}
/* The name takes the slack so the state pill stays hard right, where the eye
   can run down a column of them. */
.company-dashboard-app-name {
	flex: 1;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	font-size: .9em;
}
/* Inline sparkline: one polyline per list row, no chart library. Stroked
   rather than filled so a flat line still reads as a line. */
.company-sparkline {
	width: 72px;
	height: 20px;
	vertical-align: middle;
}
.company-sparkline polyline {
	fill: none;
	stroke: var(--color-primary);
	stroke-width: 1.5;
	vector-effect: non-scaling-stroke;
}
/* The row for a deploy that has not finished. Tinted rather than badged alone:
   it is the only row whose outcome is still unknown, and someone scanning the
   table should not have to read the status column to notice it. */
/* The preflight report. Status first and fixed-width so the eye runs down the
   column and stops at the one line that is not "확인됨". */
.company-preflight-list { margin-top: 8px; }
.company-preflight-row {
	display: grid;
	grid-template-columns: 5.5rem minmax(6rem, 10rem) 1fr;
	gap: 8px;
	padding: 6px 0;
	border-top: 1px solid var(--color-secondary);
	font-size: .82rem;
	align-items: baseline;
}
.company-preflight-detail { white-space: pre-wrap; overflow-wrap: anywhere; }
.company-preflight-ok { color: var(--color-success-text); }
.company-preflight-warn { color: var(--color-warning-text); }
.company-preflight-error { color: var(--color-error-text); }
.company-startup-output { margin: 8px 0 0; padding: 8px 10px; max-height: 240px; overflow: auto; font-size: 12px; white-space: pre-wrap; overflow-wrap: anywhere; background: var(--color-box-body); border: 1px solid var(--color-secondary); border-radius: 4px; }
.company-attempt-live > td { background: var(--color-warning-bg); }
.company-log-body { display: block; white-space: pre; min-width: 0; }
.company-log-time {
	color: var(--color-text-light-3);
	user-select: none;
}
.company-env-table input[readonly] {
	background: var(--color-secondary-bg);
	color: var(--color-text-light-2);
}
/* Same reason, for the panel as a whole: a flex item defaults to min-width
   auto, which refuses to shrink below its content. */
.company-app-panel { min-width: 0; }
.company-app-panel > * { min-width: 0; }
.company-perm-value,
.company-perm-reason { overflow-wrap: anywhere; }
/* Sized against the sidebar's own text rather than shrunk to fit: this panel
   is read by the people the platform is for, and .82rem next to a 16px
   heading reads as a footnote about their app rather than as its status. */
.company-perm-row { display: flex; flex-wrap: wrap; gap: 4px 8px; font-size: .95rem; align-items: baseline; }
.company-perm-label { min-width: 6em; color: var(--color-text-light-2); }
.company-perm-value { font-weight: 600; }
.company-perm-row.denied .company-perm-value { color: var(--color-error-text); }
.company-perm-row.pending .company-perm-value { color: var(--color-warning-text); }
/* The reason stays a step down from the value it explains, but only one:
   it is the line that saves a support request, so it has to be readable. */
.company-perm-reason { flex-basis: 100%; color: var(--color-text-light-2); font-size: .86rem; font-weight: 400; line-height: 1.45; }

.company-kpis { display: flex; flex-wrap: wrap; gap: 10px; }
/* The deploys page stacks three answers to three different questions — can
   the platform build at all, how is the fleet, what needs acting on — and
   Fomantic's "attached" strips the margin off the first, so they butt into
   one grey mass with nothing telling the eye where one ends. Spaced only
   where they sit bare like that: the same KPI row inside a segment on the
   other admin pages already has the segment's own padding, and adding to it
   would double up. */
.admin-setting-content > .ui.attached.message { margin-bottom: 16px; }
.admin-setting-content > .company-kpis { margin: 16px 0; }
.company-kpi {
	flex: 1 1 120px;
	border: 1px solid var(--color-secondary);
	border-radius: 6px;
	padding: 10px 12px;
	display: flex;
	flex-direction: column;
	gap: 2px;
}
.company-kpi b { font-size: 1.5rem; line-height: 1.1; }
/* A limit card is a form: the pencil turns the number after the slash into
   a field on the same line, with a tick and a cross beside it
   (web_src/js/features/company-app-charts.ts). */
.company-kpi-edit { margin: 0; }
.company-kpi-edit b { white-space: nowrap; } /* the field and its tick and cross stay on the figure's line */
.company-kpi-limit-actions { display: inline-flex; align-items: center; }
.company-kpi-pencil, .company-kpi-ok, .company-kpi-cancel {
	border: 0;
	background: none;
	padding: 0 0 0 4px;
	color: var(--color-text-light-2);
	cursor: pointer;
	vertical-align: middle;
	opacity: .6;
}
.company-kpi-pencil:hover, .company-kpi-cancel:hover { opacity: 1; color: var(--color-primary); }
.company-kpi-ok { color: var(--color-green); opacity: 1; }
.company-kpi-limit-input {
	width: 4em;
	font: inherit;
	color: var(--color-text);
	text-align: right;
	border: 0;
	border-bottom: 1px solid var(--color-primary);
	background: transparent;
	padding: 0 2px;
	-moz-appearance: textfield;
}
.company-kpi-limit-input::-webkit-outer-spin-button, .company-kpi-limit-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.company-kpi-limit-input:focus { outline: none; }
.company-kpi b small { font-size: .8rem; font-weight: 400; color: var(--color-text-light-2); }
.company-kpi span { font-size: .75rem; color: var(--color-text-light-2); }
/* A titled card: what it is on top, the figure, then what the figure is
   made of. The title is the one line read first, so it is the dark one. */
.company-kpi-title { font-size: 1.05rem; font-weight: 600; color: var(--color-text); margin: 0; line-height: 1.2; }
/* The app list (custom/templates/company/admin_deploys.tmpl). */
.company-fleet-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin: 16px 0 8px; }
.company-fleet-tabs { display: flex; gap: 4px; flex-wrap: wrap; }
.company-fleet-tab { padding: 6px 12px; border-radius: 6px; color: var(--color-text-light); font-size: .9rem; }
.company-fleet-tab b { font-weight: 600; margin-left: 2px; }
.company-fleet-tab.active { background: var(--color-active); color: var(--color-text); font-weight: 600; }
.company-fleet-controls { display: flex; gap: 12px; align-items: center; }
.company-fleet-select { margin-left: 6px; padding: 4px 8px; border: 1px solid var(--color-secondary); border-radius: 6px; background: var(--color-input-background); color: var(--color-text); }
.company-fleet { border: 1px solid var(--color-secondary); border-radius: 6px; overflow: hidden; }
.company-fleet-table.ui.table { margin: 0 !important; }
.company-fleet-table th { font-size: .8rem; color: var(--color-text-light-2); font-weight: 500; }
.company-fleet-check { width: 32px; }
.company-fleet-name { font-weight: 600; }
.company-fleet-sub { font-size: .78rem; color: var(--color-text-light-2); margin-top: 2px; }
.company-fleet-sub.odd { color: var(--color-warning-text); }
.company-fleet-pill { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 999px; font-size: .8rem; background: var(--color-active); }
.company-fleet-pill.running { background: var(--color-success-bg); }
.company-fleet-pill.failed, .company-fleet-pill.suspended { background: var(--color-error-bg); }
.company-fleet-pill.undeployed { border: 1px dashed var(--color-secondary-dark-2, var(--color-secondary)); background: transparent; color: var(--color-text-light-2); }
.company-fleet-mem { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
.company-fleet-bar { display: inline-block; width: 64px; height: 6px; border-radius: 3px; background: var(--color-secondary); overflow: hidden; }
.company-fleet-bar-fill { display: block; height: 100%; background: var(--color-success-text); }
.company-fleet-bar-fill.hot { background: var(--color-error-text); }
.company-fleet-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 14px; border-top: 1px solid var(--color-secondary); flex-wrap: wrap; }
.company-fleet-pager { display: flex; align-items: center; gap: 8px; }
.company-kpis-titled .company-kpi { gap: 4px; }
.company-kpis-titled .company-kpi b { margin-top: 2px; }
.company-kpi.bad b { color: var(--color-error-text); }

/* A bar rather than a number alone: "412 MB of 512 MB" needs arithmetic to
   read as "nearly full", and the people this page is for should not have to
   do it. */
.company-app-data-bar { height: 6px; border-radius: 3px; background: var(--color-secondary); overflow: hidden; }
.company-app-data-bar-fill { height: 100%; background: var(--color-primary); }
.company-app-data-bar-fill.is-warning { background: var(--color-warning-border); }
.company-app-data-bar-fill.is-full { background: var(--color-error-text); }
.company-data-warn { color: var(--color-warning-text); }
.company-data-full { color: var(--color-error-text); }
.company-network-blocked td { background: var(--color-error-bg); }

.company-charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }
.company-chart h5 { margin: 0 0 6px; font-size: .82rem; color: var(--color-text-light-2); }
/* The chart needs a height that does not come from the chart.
   `maintainAspectRatio: false` makes the canvas fill its parent, so a parent
   sized by its content is a feedback loop: the canvas grows, the box grows to
   fit it, chart.js resizes to the taller box, and the graph creeps down the
   page forever. Fixing the box breaks the cycle. */
.company-chart-canvas { position: relative; height: 200px; }
.company-chart-canvas > canvas { position: absolute; inset: 0; }
/* Wide content scrolls inside its own box rather than pushing the page. */
.company-log {
	max-height: 60vh;
	overflow: auto;
	margin: 0;
	font-size: 12px;
	/* Opens at its end without a script: a column-reverse flex box starts
	   scrolled to the bottom, where the newest line is, instead of painting
	   at the top and being scrolled down afterwards. Its one child keeps the
	   lines in order. */
	display: flex;
	flex-direction: column-reverse;
	line-height: 1.45;
	white-space: pre-wrap;
	word-break: break-all;
}
</style>

<style>
/* Permission request block on the Deploy Request form. */
/* Was a warning-coloured card, which earned its colour while it sat inline in
   one long form and had to be noticed. It is a whole column now, and a
   column-sized block of yellow reads as an alarm about the form rather than a
   heading over it — the column's own border does the separating
   (.company-deploy-col in company/deploy.tmpl). */
.company-perm-request { margin-bottom: 12px; }
.company-perm-request-item { display: flex; gap: 8px; align-items: flex-start; padding: 4px 0; }
</style>

<style>
/* The AI chat panel, shared by the workspace editor
   (custom/templates/company/workspace.tmpl) and the deploy request
   sidebar (custom/templates/company/deploy_review_sidebar.tmpl) —
   web_src/js/features/company-ai-chat.ts drives both. */
.company-ai-chat-header {
	display: flex;
	align-items: center;
	padding: .7rem 1rem;
	border-bottom: 1px solid var(--color-secondary);
	font-weight: 600;
	font-size: .95rem;
	flex-shrink: 0;
	color: var(--color-text-light-1);
	letter-spacing: .02em;
}
.company-ai-chat-messages {
	flex: 1;
	min-height: 0;
	overflow-y: auto;
	overscroll-behavior: contain;
	padding: .9rem .75rem;
	display: flex;
	flex-direction: column;
	gap: .7rem;
}
/* Empty-state hint shown once, before the first message — points at the
   input bar rather than leaving a blank panel with no explanation. */
.company-ai-chat-empty {
	margin: auto 0;
	text-align: center;
	color: var(--color-text-light-2);
	font-size: .92rem;
	padding: 1.5rem 1rem;
}
.company-ai-chat-empty a {
	display: block;
	margin-top: .4rem;
}
.company-ai-chat-message {
	font-size: .98rem;
	line-height: 1.6;
	white-space: pre-wrap;
	word-break: break-word;
	max-width: 100%;
	/* The list is a flex column that scrolls. A rendered reply carries
	   Gitea's .markup, whose overflow:hidden lets a flex item shrink below
	   its content — once the list was taller than the panel, replies were
	   squeezed to a few pixels and cut. Nothing here may shrink. */
	flex-shrink: 0;
}
.company-ai-chat-message-user {
	align-self: flex-end;
	max-width: 85%;
	background: var(--color-primary);
	color: var(--color-primary-contrast, #fff);
	padding: .55rem .9rem;
	border-radius: 14px 14px 3px 14px;
}
.company-ai-chat-message-assistant {
	align-self: stretch;
}
/* A rendered reply: Markdown's own spacing, sized for a narrow panel. */
.company-ai-chat-message.rendered { white-space: normal; }
.company-ai-chat-message.rendered :is(h1, h2, h3, h4) { font-size: 1em; margin: .8em 0 .3em; }
.company-ai-chat-message.rendered :is(ul, ol) { padding-left: 1.3em; margin: .3em 0; }
.company-ai-chat-message.rendered p { margin: .4em 0; }
.company-ai-chat-message.rendered hr { margin: .6em 0; }
.company-ai-chat-message.rendered pre { font-size: .85em; }
.company-ai-chat-message-status {
	align-self: flex-start;
	font-size: .85rem;
	color: var(--color-text-light-1);
	background: var(--color-active);
	border-radius: 999px;
	padding: .3rem .8rem;
}
.company-ai-chat-message-error {
	align-self: stretch;
	background: var(--color-error-bg);
	color: var(--color-error-text);
	border: 1px solid color-mix(in srgb, var(--color-error-text) 35%, transparent);
	border-radius: 10px;
	padding: .55rem .75rem;
	font-size: .82rem;
}
.company-ai-chat-inputbar {
	padding: .65rem .75rem .8rem;
	border-top: 1px solid var(--color-secondary);
	flex-shrink: 0;
}
.company-ai-chat-queue {
	font-size: .8rem;
	color: var(--color-text-light-2);
	padding-bottom: .4rem;
}
/* Stacked (textarea on top, its own toolbar row below) rather than a
   single row with the send button beside the text — a single row either
   has to keep the button vertically anchored (awkward once the textarea
   grows past one line) or drags it down the right edge as the box grows.
   Stacking keeps the button's row pinned to the bottom of the whole
   control regardless of how many lines the message grows to. */
.company-ai-chat-inputwrap {
	display: flex;
	flex-direction: column;
	border: 1px solid var(--color-secondary);
	border-radius: 18px;
	background: var(--color-input-background);
	padding: .7rem .6rem .55rem .9rem;
	transition: border-color .15s ease, box-shadow .15s ease;
}
.company-ai-chat-inputwrap:focus-within {
	border-color: var(--color-primary);
	box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 15%, transparent);
}
.company-ai-chat-input {
	resize: none;
	min-height: 1.6rem;
	max-height: 220px;
	border: none;
	background: none;
	padding: 0 0 .5rem;
	font-size: .95rem;
	line-height: 1.45;
	color: var(--color-text);
}
.company-ai-chat-input:focus {
	outline: none;
}
.company-ai-chat-input::placeholder {
	color: var(--color-text-light-3, var(--color-text-light-2));
}
